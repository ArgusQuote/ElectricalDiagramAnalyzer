          }
          
          /* Kill gutters that create visible side margins */
          body[data-argus-wide="1"] .anvil-content,
          body[data-argus-wide="1"] .anvil-container,
          body[data-argus-wide="1"] .container,
          body[data-argus-wide="1"] .container-fluid {
