  def _tag_status_rows(self):
    """
    Add a real CSS class to the <tr> that contains our status marker label,
    so our CSS rule `tr.status-row td:not(:first-child)` actually applies.
    """
    try:
      dg = getattr(self, "data_grid_2", None)
