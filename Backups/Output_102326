  def _schedule_panel_preview_load(
    self,
    preview_host,
    designation,
    panel_source,
    display_designation,
  ):
    """
    Priority-load the currently viewed panel image.

    This request happens immediately regardless of where the
    background prefetch queue currently is.

    Example:
      background = Panel 3
      user clicks Panel 8
      Panel 8 starts immediately
      Panel 3 keeps running
    """

    def _image_ready(
      media
    ):
      self._clear_component(
        preview_host
      )

      if media is None:
        msg = Label(
          text="Preview unavailable",
          align="center",
          foreground="theme:White",
        )

        msg.height = 420

        preview_host.add_component(
          msg
        )

        # Even if this particular image failed,
        # background prefetch should still continue.
        self._start_panel_prefetching()

        return

      img = Image(
        source=media,
        width="100%",
        height=420,
        display_mode="shrink_to_fit",
      )

      preview_link = Link()

      preview_link.width = "100%"
      preview_link.underline = False

      preview_link.tag = {
        "source": panel_source or "",
        "name": designation,
        "lookup_name": designation,
        "display_name": display_designation,
        "job_id": (
          self.result.get(
            "job_id"
          )
          or ""
        ),
      }

      preview_link.set_event_handler(
        "click",
        self._preview_click,
      )

      preview_link.add_component(
        img
      )

      preview_host.add_component(
        preview_link
      )

      hint = Label(
        text="Click image to enlarge",
        align="center",
        foreground="theme:White",
      )

      hint.spacing_above = "small"
      hint.spacing_below = "none"

      preview_host.add_component(
        hint
      )

      # Once the visible image is underway/completed,
      # make sure background prefetch continues.
      self._start_panel_prefetching()

    def _load():
      self._fetch_panel_preview_media_async(
        designation,
        _image_ready,
      )

    try:
      js.window.setTimeout(
        _load,
        50,
      )

    except Exception:
      _load()
    
