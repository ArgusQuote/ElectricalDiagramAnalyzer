        trim_style = "SURFACE"
        enclosure = "NEMA1"
      else:
        trim_style = "FLUSH"
        enclosure = "NEMA1"

      updated_defaults = {
        "bussing_material": material,
        "material": material,
        "rating_type": rating_type,
        "panel_rating_type": rating_type,
        "default_trim_style": trim_style,
        "trim_style": trim_style,
        "enclosure": enclosure,
        "breaker_type": breaker_type,
        "branch_breaker_type": breaker_type,
        "breaker_mounting": breaker_type,
      }

    except Exception as e:
      alert(f"Could not submit defaults:\n\n{e}")
      return

    try:
      job_id = str((self.result or {}).get("job_id") or "").strip()
      if not job_id:
        alert("Missing job id. Cannot rerun rules.")
        return

      Notification("Updating BOM defaults...", timeout=1.5).show()

      if bool(getattr(self, "_admin_view", False)):
        target_email = self._admin_asset_owner_email()

        if not target_email:
          alert("Missing admin target email. Cannot rerun rules for this job.")
          return

        resp = (
          anvil.server.call(
            "rerun_rules_with_global_defaults", job_id, updated_defaults, target_email
          )
          or {}
        )

      else:
        resp = (
          anvil.server.call(
            "rerun_rules_with_global_defaults", job_id, updated_defaults
          )
          or {}
        )

      if not resp.get("ok"):
        err = resp.get("error") or "Unknown rules rerun error."
        tb = resp.get("traceback") or ""

        alert(
          f"Could not update BOM:\n\n{err}" + (f"\n\nTraceback:\n{tb}" if tb else "")
        )
        return

      updated_result = resp.get("result") or {}
      if not updated_result:
        alert("Rules rerun completed, but no updated result was returned.")
        return

      self._refresh_after_panel_edit(updated_result)

      Notification("BOM updated", timeout=2).show()

    except Exception as e:
      alert(
        "Could not update BOM:\n\n"
        f"{type(e).__name__}: {e}\n\n"
        "This means the server function threw before returning a normal response."
      )

  # ---- panel edits -----
  def _panel_edit_ctx(
    self,
    designation=None,
  ):
    ctx = getattr(
      self,
      "_panel_edit_context",
      None,
    )

    if not isinstance(
      ctx,
      dict,
    ):
      return None

    if designation is None:
      return ctx

    target = designation

    if isinstance(
      designation,
      dict,
    ):
      target = (
        designation.get("name")
        or designation.get("lookup_name")
        or designation.get("display_name")
        or ""
      )

    return (
      ctx
      if self._norm(
        ctx.get(
          "designation"
        )
      )
      == self._norm(
        target
      )
      else None
    )


  def _panel_component_for_review(
    self,
    designation,
  ):
    ctx = self._panel_edit_ctx(
      designation
    )

    if (
      ctx
      and isinstance(
        ctx.get("working"),
        dict,
      )
    ):
      return ctx["working"]

    return self._get_component_for_panel(
      designation
    )


  def _normalize_edit_breaker_circuits(
    self,
    comp,
  ):
    """
    Give every editable breaker an explicit side and
    circuitNumber on the temporary edit copy.

    Existing circuitNumber values win.

    Older jobs can fall back to rowIndex / visual order.
    """
    if not isinstance(
      comp,
      dict,
    ):
      return

    attrs = comp.setdefault(
      "attrs",
      {},
    )

    breakers = (
      attrs.get(
        "detected_breakers"
      )
      or []
    )

    if not isinstance(
      breakers,
      list,
    ):
      breakers = []

      attrs[
        "detected_breakers"
        ] = breakers

    by_side = {
      "left": [],
      "right": [],
    }

    for idx, breaker in enumerate(
      breakers
    ):
      if not isinstance(
        breaker,
        dict,
      ):
        continue

      circuit = self._safe_int(
        breaker.get(
          "circuitNumber"
        )
        or breaker.get(
          "circuit_number"
        )
        or breaker.get(
          "circuit"
        )
        or breaker.get(
          "ckt"
        )
      )

      side = str(
        breaker.get("side")
        or ""
      ).strip().lower()

      # If circuit exists but side does not,
      # odd = left / even = right.
      if (
        side not in (
          "left",
          "right",
        )
        and circuit
      ):
        side = (
          "left"
          if circuit % 2
          else "right"
        )

      if side not in (
        "left",
        "right",
      ):
        continue

      breaker["side"] = side

      by_side[
        side
      ].append(
        (
          idx,
          breaker,
          circuit,
        )
      )

    for (
      side,
      entries,
    ) in by_side.items():

      first = (
        1
        if side == "left"
        else 2
      )

      def _sort_key(
        item
      ):
        idx, breaker, circuit = item

        row_index = self._safe_int(
          breaker.get(
            "rowIndex"
          )
        )

        try:
          ratio = float(
            breaker.get(
              "yCenterRatio"
            )
          )

        except Exception:
          ratio = 999999

        return (
          row_index is None,
          (
            row_index
            if row_index is not None
            else ratio
          ),
          idx,
        )

      entries.sort(
        key=_sort_key
      )

      used = set()

      for (
        visual_index,
        (
          _idx,
          breaker,
          circuit,
        ),
      ) in enumerate(
        entries
      ):

        valid = (
          circuit is not None
          and circuit >= first
          and (
            circuit
            - first
          ) % 2 == 0
        )

        if valid:
          assigned = circuit

        else:
          row_index = (
            self._safe_int(
              breaker.get(
                "rowIndex"
              )
            )
          )

          assigned = (
            first
            + 2
            * (
              row_index
              if (
                row_index is not None
                and row_index >= 0
              )
              else visual_index
            )
          )

        while assigned in used:
          assigned += 2

        used.add(
          assigned
        )

        breaker[
          "circuitNumber"
        ] = assigned

        breaker[
          "circuit_number"
        ] = assigned

        breaker[
          "rowIndex"
        ] = (
          assigned
          - first
        ) // 2


  def _start_inline_panel_edit(
    self,
    designation,
    review_host,
  ):
    """
    Start a local working-copy edit session for one panel.

    Edit mode now opens in a full-viewport overlay so the
    normal Argus page stays underneath and cannot be scrolled
    or clicked while editing.
    """
    if (
      self._panel_edit_ctx()
      is not None
    ):
      return

    comp = (
      self._get_component_for_panel(
        designation
      )
    )

    if not isinstance(
      comp,
      dict,
    ):
      alert(
        f"Could not find panel data "
        f"for {designation}."
      )

      return

    # --------------------------------------------------
    # True deep copies.
    #
    # The working copy is completely local until the user
    # presses Confirm Changes.
    # --------------------------------------------------

    original = json.loads(
      json.dumps(
        comp
      )
    )

    working = json.loads(
      json.dumps(
        comp
      )
    )

    self._normalize_edit_breaker_circuits(
      original
    )

    self._normalize_edit_breaker_circuits(
      working
    )

    original_name = str(
      comp.get("name")
      or designation
      or ""
    ).strip()

    source = self._norm_path(
      comp.get("source")
      or comp.get("overlay_source")
      or comp.get("preview_source")
      or ""
    )

    # --------------------------------------------------
    # Full-screen edit overlay.
    #
    # The shell covers the browser viewport.
    # The actual editor remains its normal width and is
    # centered inside that shell.
    # --------------------------------------------------

    overlay_shell = LinearPanel()

    overlay_shell.width = "100%"
    overlay_shell.spacing = "none"
    overlay_shell.padding = "0"
    overlay_shell.background = "transparent"

    overlay_host = LinearPanel()

    overlay_host.width = "100%"
    overlay_host.spacing = "none"
    overlay_host.padding = "0"
    overlay_host.background = "transparent"

    overlay_shell.add_component(
      overlay_host
    )

    # Add the overlay to the form.
    # _lock_inline_panel_edit() makes it fixed to the viewport.
    try:
      self.add_component(
        overlay_shell
      )

    except Exception:
      fallback_parent = (
        getattr(
          self,
          "content_panel",
          None,
        )
        or self._get_cards_host()
      )

      fallback_parent.add_component(
        overlay_shell
      )

    self._panel_edit_context = {
      "designation": designation,
      "original": original,
      "working": working,
      "original_name": original_name,
      "source": source,

      # Normal card stays intact underneath.
      "base_review_host": review_host,

      # Edit mode renders only inside this overlay.
      "review_host": overlay_host,
      "review_block": None,

      "overlay_shell": overlay_shell,
      "overlay_host": overlay_host,
      "overlay_wheel_handler": None,

      "dirty": False,
      "submitting": False,
    }

    self._render_panel_review_host(
      overlay_host,
      designation,
    )

  def _lock_inline_panel_edit(
    self,
    review_block,
  ):
    """
    Turn the inline edit UI into a full-screen modal-style workspace.

    The overlay covers the entire browser viewport.
    The centered review block is the only scrollable editing area.

    Wheel events anywhere on the dark overlay are routed into the
    review scroller, so the Anvil page underneath cannot move.
    """
    ctx = self._panel_edit_ctx()

    if not ctx:
      return

    ctx[
      "review_block"
    ] = review_block

    def _apply():
      try:
        overlay_shell = (
          ctx.get(
            "overlay_shell"
          )
        )

        overlay = (
          js.get_dom_node(
            overlay_shell
          )
          if overlay_shell is not None
          else None
        )

        review = (
          js.get_dom_node(
            review_block
          )
        )

        if (
          not overlay
          or not review
        ):
          return

        # --------------------------------------------------
        # FULL-VIEWPORT BACKDROP
        #
        # Keep this below normal Anvil alert/modal z-index so
        # breaker edit and delete-confirm popups still appear
        # above this workspace.
        # --------------------------------------------------

        overlay.style.setProperty(
          "position",
          "fixed",
          "important",
        )

        overlay.style.setProperty(
          "top",
          "0",
          "important",
        )

        overlay.style.setProperty(
          "right",
          "0",
          "important",
        )

        overlay.style.setProperty(
          "bottom",
          "0",
          "important",
        )

        overlay.style.setProperty(
          "left",
          "0",
          "important",
        )

        overlay.style.setProperty(
          "width",
          "100vw",
          "important",
        )

        overlay.style.setProperty(
          "height",
          "100vh",
          "important",
        )

        overlay.style.setProperty(
          "max-width",
          "none",
          "important",
        )

        overlay.style.setProperty(
          "margin",
          "0",
          "important",
        )

        overlay.style.setProperty(
          "padding",
          "0",
          "important",
        )

        overlay.style.setProperty(
          "background",
          "rgba(7, 10, 12, 0.88)",
          "important",
        )

        overlay.style.setProperty(
          "z-index",
          "1030",
          "important",
        )

        overlay.style.setProperty(
          "overflow",
          "hidden",
          "important",
        )

        overlay.style.setProperty(
          "pointer-events",
          "auto",
          "important",
        )

        overlay.style.setProperty(
          "overscroll-behavior",
          "none",
          "important",
        )

        overlay.style.setProperty(
          "touch-action",
          "none",
          "important",
        )

        # --------------------------------------------------
        # CENTERED EDITOR
        # --------------------------------------------------

        review.style.setProperty(
          "position",
          "fixed",
          "important",
        )

        review.style.setProperty(
          "top",
          "20px",
          "important",
        )

        review.style.setProperty(
          "left",
          "50%",
          "important",
        )

        review.style.setProperty(
          "transform",
          "translateX(-50%)",
          "important",
        )

        review.style.setProperty(
          "width",
          "calc(100vw - 48px)",
          "important",
        )

        review.style.setProperty(
          "max-width",
          "1500px",
          "important",
        )

        review.style.setProperty(
          "height",
          "calc(100vh - 40px)",
          "important",
        )

        review.style.setProperty(
          "max-height",
          "calc(100vh - 40px)",
          "important",
        )

        review.style.setProperty(
          "box-sizing",
          "border-box",
          "important",
        )

        review.style.setProperty(
          "overflow-y",
          "auto",
          "important",
        )

        review.style.setProperty(
          "overflow-x",
          "hidden",
          "important",
        )

        review.style.setProperty(
          "overscroll-behavior",
          "contain",
          "important",
        )

        review.style.setProperty(
          "touch-action",
          "pan-y",
          "important",
        )

        review.style.setProperty(
          "border-radius",
          "10px",
          "important",
        )

        review.style.setProperty(
          "box-shadow",
          (
            "0 0 0 2px #4AA8E8, "
            "0 18px 60px rgba(0,0,0,.55)"
          ),
          "important",
        )

        review.style.setProperty(
          "z-index",
          "1031",
          "important",
        )

        review.style.setProperty(
          "pointer-events",
          "auto",
          "important",
        )

        # --------------------------------------------------
        # Secondary browser scroll lock.
        # --------------------------------------------------

        html = (
          js.document.documentElement
        )

        body = (
          js.document.body
        )

        if html:
          html.style.setProperty(
            "overflow",
            "hidden",
            "important",
          )

          html.style.setProperty(
            "overscroll-behavior",
            "none",
            "important",
          )

        if body:
          body.style.setProperty(
            "overflow",
            "hidden",
            "important",
          )

          body.style.setProperty(
            "overscroll-behavior",
            "none",
            "important",
          )

        # --------------------------------------------------
        # ROUTE ALL OVERLAY WHEEL INPUT INTO THE EDITOR.
        #
        # Mouse over editor:
        #   editor scrolls
        #
        # Mouse over dark area beside editor:
        #   editor still scrolls
        #
        # Underlying Argus page:
        #   receives nothing
        # --------------------------------------------------

        if (
          ctx.get(
            "overlay_wheel_handler"
          )
          is None
        ):

          def _route_wheel(
            event
          ):
            try:
              current_block = (
                ctx.get(
                  "review_block"
                )
              )

              current_review = (
                js.get_dom_node(
                  current_block
                )
                if current_block is not None
                else None
              )

              if current_review:
                delta_y = float(
                  getattr(
                    event,
                    "deltaY",
                    0,
                  )
                  or 0
                )

                current_review.scrollTop = (
                  float(
                    current_review.scrollTop
                    or 0
                  )
                  + delta_y
                )

              event.preventDefault()
              event.stopPropagation()

            except Exception:
              try:
                event.preventDefault()

              except Exception:
                pass

          ctx[
            "overlay_wheel_handler"
          ] = _route_wheel

          overlay.addEventListener(
            "wheel",
            _route_wheel,
            False,
          )

      except Exception:
        pass

    # DOM may not be mounted on the exact first frame.
    try:
      js.window.setTimeout(
        _apply,
        0,
      )

      js.window.setTimeout(
        _apply,
        50,
      )

      js.window.setTimeout(
        _apply,
        150,
      )

    except Exception:
      _apply()

  def _unlock_inline_panel_edit(
    self,
  ):
    """
    Remove the full-screen editing overlay and restore the normal page.
    """
    ctx = self._panel_edit_ctx()

    if not ctx:
      return

    overlay_shell = (
      ctx.get(
        "overlay_shell"
      )
    )

    overlay = None

    try:
      if overlay_shell is not None:
        overlay = js.get_dom_node(
          overlay_shell
        )

    except Exception:
      overlay = None

    # --------------------------------------------------
    # Remove wheel routing before removing the overlay.
    # --------------------------------------------------

    try:
      handler = (
        ctx.get(
          "overlay_wheel_handler"
        )
      )

      if (
        overlay
        and handler is not None
      ):
        overlay.removeEventListener(
          "wheel",
          handler,
        )

    except Exception:
      pass

    # --------------------------------------------------
    # Restore normal document scrolling.
    # --------------------------------------------------

    try:
      html = (
        js.document.documentElement
      )

      if html:
        html.style.removeProperty(
          "overflow"
        )

        html.style.removeProperty(
          "overscroll-behavior"
        )

    except Exception:
      pass

    try:
      body = (
        js.document.body
      )

      if body:
        body.style.removeProperty(
          "overflow"
        )

        body.style.removeProperty(
          "overscroll-behavior"
        )

    except Exception:
      pass

    # --------------------------------------------------
    # Remove the full-screen overlay.
    # --------------------------------------------------

    try:
      if overlay_shell is not None:
        overlay_shell.remove_from_parent()

    except Exception:
      try:
        if overlay:
          overlay.remove()

      except Exception:
        pass

    ctx[
      "overlay_shell"
    ] = None

    ctx[
      "overlay_host"
    ] = None

    ctx[
      "overlay_wheel_handler"
    ] = None

    ctx[
      "review_block"
    ] = None

  def _discard_inline_panel_edit(
    self,
    designation,
  ):
    """
    Throw away the temporary working copy and close the edit overlay.

    The normal panel review underneath was never replaced, so no
    underlying card rebuild is needed.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if not ctx:
      return

    self._unlock_inline_panel_edit()

    self._panel_edit_context = None

  def _edit_breaker_at_circuit(
    self,
    designation,
    circuit_number,
    original=False,
  ):
    """
    Return:
      (list_index, breaker_dict)

    for the exact circuit number.

    Every circuit is independent during editing.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if not ctx:
      return (
        None,
        None,
      )

    comp = (
      ctx["original"]
      if original
      else ctx["working"]
    )

    breakers = (
      (
        comp.get("attrs")
        or {}
      ).get(
        "detected_breakers"
      )
      or []
    )

    if not isinstance(
      breakers,
      list,
    ):
      return (
        None,
        None,
      )

    target = self._safe_int(
      circuit_number
    )

    for (
      idx,
      breaker,
    ) in enumerate(
      breakers
    ):
      if not isinstance(
        breaker,
        dict,
      ):
        continue

      circuit = self._safe_int(
        breaker.get(
          "circuitNumber"
        )
        or breaker.get(
          "circuit_number"
        )
        or breaker.get(
          "circuit"
        )
        or breaker.get(
          "ckt"
        )
      )

      if circuit == target:
        return (
          idx,
          breaker,
        )

    return (
      None,
      None,
    )


  def _edit_breaker_text(
    self,
    breaker,
  ):
    """
    Human-readable breaker label for the inline editor.
    """
    if not isinstance(
      breaker,
      dict,
    ):
      return "-"

    poles = self._safe_int(
      breaker.get(
        "poles"
      )
    )

    amps = self._safe_int(
      breaker.get(
        "amperage"
      )
    )

    if (
      poles is None
      or amps is None
    ):
      return "-"

    special = str(
      breaker.get(
        "specialFeatures"
      )
      or breaker.get(
        "special_features"
      )
      or ""
    ).strip().upper()

    text = (
      f"{poles}P "
      f"{amps}A"
    )

    if special:
      text += (
        f" {special}"
      )

    return text


  def _clear_edit_issue_for_circuit(
    self,
    designation,
    circuit_number,
  ):
    """
    Once the user explicitly edits a circuit,
    remove any OCR-position warning for that circuit.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if not ctx:
      return

    attrs = (
      ctx["working"].get(
        "attrs"
      )
      or {}
    )

    issues = (
      attrs.get(
        "breaker_position_issues"
      )
      or []
    )

    if not isinstance(
      issues,
      list,
    ):
      return

    target = self._safe_int(
      circuit_number
    )

    attrs[
      "breaker_position_issues"
    ] = [
      issue
      for issue in issues
      if (
        not isinstance(
          issue,
          dict,
        )
        or self._safe_int(
          issue.get(
            "circuitNumber"
          )
          or issue.get(
            "circuit_number"
          )
        )
        != target
      )
    ]


  def _open_inline_breaker_editor(
    self,
    designation,
    circuit_number,
    on_changed,
  ):
    """
    Add or edit one specific circuit slot.

    Existing breaker positional metadata is preserved because
    we update the existing breaker dictionary in-place.

    Empty slots receive a new breaker record using only the
    circuit identity required for reliable placement.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if not ctx:
      return

    (
      idx,
      current,
    ) = (
      self._edit_breaker_at_circuit(
        designation,
        circuit_number,
      )
    )

    (
      _orig_idx,
      original,
    ) = (
      self._edit_breaker_at_circuit(
        designation,
        circuit_number,
        original=True,
      )
    )

    body = ColumnPanel(
      spacing="medium"
    )

    body.width = "100%"

    original_lab = Label(
      text=(
        f"Original: "
        f"{self._edit_breaker_text(original)}"
      ),
      bold=True,
    )

    body.add_component(
      original_lab
    )

    current_text = (
      self._edit_breaker_text(
        current
      )
    )

    original_text = (
      self._edit_breaker_text(
        original
      )
    )

    if current_text != original_text:
      current_lab = Label(
        text=(
          f"Current edit: "
          f"{current_text}"
        ),
        foreground="theme:Secondary 500",
      )

      body.add_component(
        current_lab
      )

    # --------------------------------------------------
    # Breaker controls
    #
    # Display order:
    #   Poles | Amps | Option
    #
    # Matches the Breaker Summary.
    # --------------------------------------------------

    dd_poles = DropDown(
      items=[
        ("1P", 1),
        ("2P", 2),
        ("3P", 3),
      ]
    )

    self._dropdown_set_if_valid(
      dd_poles,
      (
        self._safe_int(
          (current or {}).get(
            "poles"
          )
        )
        or 1
      ),
    )

    dd_amps = DropDown(
      items=self._breaker_amp_items()
    )

    self._dropdown_set_if_valid(
      dd_amps,
      (
        self._safe_int(
          (current or {}).get(
            "amperage"
          )
        )
        or 20
      ),
    )

    dd_option = DropDown(
      items=self._breaker_option_items()
    )

    self._dropdown_set_if_valid(
      dd_option,
      str(
        (current or {}).get(
          "specialFeatures"
        )
        or ""
      ).strip().upper(),
    )

    grid = GridPanel()

    grid.width = "100%"

    grid.add_component(
      self._make_labeled_control(
        "Poles",
        dd_poles,
      ),
      row="A",
      col_xs=0,
      width_xs=4,
    )

    grid.add_component(
      self._make_labeled_control(
        "Amps",
        dd_amps,
      ),
      row="A",
      col_xs=4,
      width_xs=4,
    )

    grid.add_component(
      self._make_labeled_control(
        "Option",
        dd_option,
      ),
      row="A",
      col_xs=8,
      width_xs=4,
    )

    body.add_component(
      grid
    )

    submitted = alert(
      content=body,
      title=(
        f"{'Edit' if current else 'Add'} "
        f"Breaker - Circuit "
        f"{circuit_number}"
      ),
      dismissible=True,
      buttons=[
        (
          "Cancel",
          False,
        ),
        (
          (
            "Apply"
            if current
            else "Add"
          ),
          True,
        ),
      ],
    )

    if not submitted:
      return

    poles = self._safe_int(
      dd_poles.selected_value
    )

    amps = self._safe_int(
      dd_amps.selected_value
    )

    special = str(
      dd_option.selected_value
      or ""
    ).strip().upper()

    if (
      amps is None
      or poles not in (
        1,
        2,
        3,
      )
    ):
      alert(
        "Select a valid breaker "
        "amperage and pole count."
      )

      return

    attrs = (
      ctx["working"].setdefault(
        "attrs",
        {},
      )
    )

    breakers = (
      attrs.setdefault(
        "detected_breakers",
        [],
      )
    )

    circuit_number = int(
      circuit_number
    )

    side = (
      "left"
      if circuit_number % 2
      else "right"
    )

    first = (
      1
      if side == "left"
      else 2
    )

    # --------------------------------------------------
    # Empty circuit:
    # create a new independent breaker record.
    # --------------------------------------------------

    if current is None:
      current = {}

      breakers.append(
        current
      )

    # --------------------------------------------------
    # Existing circuit:
    # only overwrite electrical values and explicit
    # circuit placement. Existing geometry remains intact.
    # --------------------------------------------------

    current.update(
      {
        "side": side,
        "circuitNumber": (
          circuit_number
        ),
        "circuit_number": (
          circuit_number
        ),
        "rowIndex": (
          (
            circuit_number
            - first
          )
          // 2
        ),
        "amperage": amps,
        "poles": poles,
        "count": 1,
        "specialFeatures": special,
        "userEdited": True,
      }
    )

    current.pop(
      "circuitPositionIssue",
      None,
    )

    self._clear_edit_issue_for_circuit(
      designation,
      circuit_number,
    )

    ctx["dirty"] = True

    on_changed()

  def _delete_inline_breaker(
    self,
    designation,
    circuit_number,
    on_changed,
  ):
    """
    Delete one breaker from one exact circuit after confirmation.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if not ctx:
      return

    (
      idx,
      breaker,
    ) = (
      self._edit_breaker_at_circuit(
        designation,
        circuit_number,
      )
    )

    if (
      idx is None
      or breaker is None
    ):
      return

    confirmed = alert(
      content=Label(
        text=(
          f"Delete "
          f"{self._edit_breaker_text(breaker)} "
          f"from circuit "
          f"{circuit_number}?"
        ),
        align="center",
      ),
      title="Confirm Delete",
      dismissible=True,
      buttons=[
        (
          "Keep",
          False,
        ),
        (
          "Delete",
          True,
        ),
      ],
    )

    if not confirmed:
      return

    breakers = (
      (
        ctx["working"].get(
          "attrs"
        )
        or {}
      ).get(
        "detected_breakers"
      )
      or []
    )

    if (
      0 <= idx
      < len(breakers)
    ):
      breakers.pop(
        idx
      )

    self._clear_edit_issue_for_circuit(
      designation,
      circuit_number,
    )

    ctx["dirty"] = True

    on_changed()


  def _open_inline_panel_value_editor(
    self,
    designation,
    field_key,
    on_changed,
  ):
    """
    Edit one top-level panel value without leaving the review screen.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if not ctx:
      return

    working = (
      ctx["working"]
    )

    original = (
      ctx["original"]
    )

    wa = working.setdefault(
      "attrs",
      {},
    )

    oa = (
      original.get(
        "attrs"
      )
      or {}
    )

    labels = {
      "name": "Panel Name",
      "amperage": "Bus Amps",
      "voltage": "Volts",
      "mainBreakerAmperage": "Main Amps",
      "intRating": "Interrupting Rating",
      "spaces": "Spaces",
    }

    label_text = labels[
      field_key
    ]

    # --------------------------------------------------
    # Build correct control for this field.
    # --------------------------------------------------

    if field_key == "name":
      original_value = str(
        original.get(
          "display_name"
        )
        or original.get(
          "name"
        )
        or ""
      )

      current_value = str(
        working.get(
          "display_name"
        )
        or working.get(
          "name"
        )
        or ""
      )

      control = TextBox(
        text=current_value
      )

    elif field_key == "amperage":
      original_value = (
        self._safe_int(
          oa.get(
            "amperage"
          )
        )
      )

      current_value = (
        self._safe_int(
          wa.get(
            "amperage"
          )
        )
      )

      control = TextBox(
        text=(
          ""
          if current_value is None
          else str(
            current_value
          )
        )
      )

    elif (
      field_key
      == "mainBreakerAmperage"
    ):
      original_value = (
        self._safe_int(
          oa.get(
            "mainBreakerAmperage"
          )
        )
      )

      current_value = (
        self._safe_int(
          wa.get(
            "mainBreakerAmperage"
          )
        )
      )

      control = TextBox(
        text=(
          ""
          if current_value is None
          else str(
            current_value
          )
        )
      )

    elif field_key == "voltage":
      original_value = (
        self._safe_int(
          oa.get(
            "voltage"
          )
        )
      )

      current_value = (
        self._safe_int(
          wa.get(
            "voltage"
          )
        )
      )

      control = DropDown(
        items=(
          self._panel_voltage_items()
        )
      )

      self._dropdown_set_if_valid(
        control,
        current_value,
      )

    elif field_key == "intRating":
      original_value = (
        self._safe_int(
          oa.get(
            "intRating"
          )
        )
      )

      current_value = (
        self._safe_int(
          wa.get(
            "intRating"
          )
        )
      )

      control = DropDown(
        items=(
          self._panel_int_rating_items()
        )
      )

      self._dropdown_set_if_valid(
        control,
        current_value,
      )

    elif field_key == "spaces":
      original_value = (
        self._safe_int(
          oa.get(
            "spaces"
          )
        )
      )

      current_value = (
        self._safe_int(
          wa.get(
            "spaces"
          )
        )
      )

      control = DropDown(
        items=(
          self._panel_spaces_items()
        )
      )

      self._dropdown_set_if_valid(
        control,
        current_value,
      )

    else:
      return

    # --------------------------------------------------
    # Small focused edit popup.
    # --------------------------------------------------

    body = ColumnPanel(
      spacing="medium"
    )

    body.add_component(
      Label(
        text=(
          f"Original: "
          f"{'-' if original_value in (None, '', 'NONE') else original_value}"
        ),
        bold=True,
      )
    )

    body.add_component(
      self._make_labeled_control(
        f"New {label_text}",
        control,
      )
    )

    submitted = alert(
      content=body,
      title=(
        f"Edit "
        f"{label_text}"
      ),
      dismissible=True,
      buttons=[
        (
          "Cancel",
          False,
        ),
        (
          "Apply",
          True,
        ),
      ],
    )

    if not submitted:
      return

    try:
      # ------------------------------------------------
      # Panel name
      # ------------------------------------------------
      if field_key == "name":
        value = str(
          control.text
          or ""
        ).strip()

        if not value:
          raise ValueError(
            "Panel name is required."
          )

        internal_name = str(
          working.get(
            "name"
          )
          or ctx.get(
            "original_name"
          )
          or ""
        ).strip()

        if (
          self._norm(
            value
          )
          == self._norm(
            internal_name
          )
        ):
          working.pop(
            "display_name",
            None,
          )

          working.pop(
            "name_was_edited",
            None,
          )

        else:
          working[
            "display_name"
          ] = value

          working[
            "name_was_edited"
          ] = True

      # ------------------------------------------------
      # Bus amps
      # ------------------------------------------------
      elif field_key == "amperage":
        wa[
          "amperage"
        ] = (
          self._parse_amp_text(
            control.text,
            field_name="Bus amps",
            required=True,
            min_amp=100,
            max_amp=1200,
          )
        )

      # ------------------------------------------------
      # Main breaker amps
      # ------------------------------------------------
      elif (
        field_key
        == "mainBreakerAmperage"
      ):
        value = (
          self._parse_amp_text(
            control.text,
            field_name="Main amps",
            required=False,
            min_amp=100,
            max_amp=1200,
          )
        )

        wa[
          "mainBreakerAmperage"
        ] = (
          "NONE"
          if value is None
          else value
        )

      # ------------------------------------------------
      # Dropdown numeric fields
      # ------------------------------------------------
      elif field_key in (
        "voltage",
        "intRating",
      ):
        value = (
          self._safe_int(
            control.selected_value
          )
        )

        if value is None:
          raise ValueError(
            f"{label_text} is required."
          )

        wa[
          field_key
        ] = value

      # ------------------------------------------------
      # Spaces
      # ------------------------------------------------
      elif field_key == "spaces":
        value = (
          self._safe_int(
            control.selected_value
          )
        )

        if value is None:
          raise ValueError(
            "Spaces is required."
          )

        highest = 0

        for breaker in (
          wa.get(
            "detected_breakers"
          )
          or []
        ):
          if not isinstance(
            breaker,
            dict,
          ):
            continue

          highest = max(
            highest,
            (
              self._safe_int(
                breaker.get(
                  "circuitNumber"
                )
                or breaker.get(
                  "circuit_number"
                )
              )
              or 0
            ),
          )

        # Do not silently throw away breakers if spaces is reduced.
        if highest > value:
          raise ValueError(
            f"Circuit {highest} still contains "
            f"a breaker. Delete breakers above "
            f"circuit {value} before reducing spaces."
          )

        wa[
          "spaces"
        ] = value

    except Exception as e:
      alert(
        "Could not apply change:\n\n"
        f"{e}"
      )

      return

    ctx["dirty"] = True

    on_changed()


