  def _format_breaker_visual_label(self, breaker: dict) -> str:
    """
    Build the simple outside label shown beside the drawing.
    """
    amps = self._safe_int(breaker.get("amperage"))
    poles = self._safe_int(breaker.get("poles"))
  
    if amps is None or poles is None:
      return ""
  
    special = str(
      breaker.get("specialFeatures")
      or breaker.get("special_features")
      or ""
    ).strip().upper()
  
    text = f"{amps}A  {poles}P"
  
