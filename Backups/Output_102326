              "box-sizing",
              "border-box",
              "important",
            )

            outer_el.style.setProperty(
              "height",
              "160px",
              "important",
            )

            outer_el.style.setProperty(
              "min-height",
              "160px",
              "important",
            )

            outer_el.style.setProperty(
              "max-height",
              "160px",
              "important",
            )

            outer_el.style.setProperty(
              "overflow",
