  def _collect_raw_breaker_summary(self, designation: str) -> list[dict]:
    """
    Aggregate raw detected breakers for the clean transcription summary.
  
    Returns:
        [
            {"poles": 1, "amperage": 20, "count": 35},
            {"poles": 2, "amperage": 45, "count": 2},
            ...
        ]
    """
    grouped = {}
  
    for breaker in self._raw_breakers_for_panel(designation):
      amps = self._safe_int(breaker.get("amperage"))
      poles = self._safe_int(breaker.get("poles"))
      count = self._safe_int(breaker.get("count")) or 1
  
      if amps is None or poles is None:
        continue
  
      if poles not in (1, 2, 3):
        continue
  
      special = str(
        breaker.get("specialFeatures")
        or breaker.get("special_features")
        or ""
      ).strip().upper()
  
      key = (poles, amps, special)
  
      grouped[key] = grouped.get(key, 0) + count
  
    rows = []
  
    for (poles, amps, special), count in sorted(
      grouped.items(),
      key=lambda item: (
        item[0][0],
        item[0][1],
        item[0][2],
      ),
    ):
      rows.append(
        {
          "poles": poles,
          "amperage": amps,
          "count": count,
          "specialFeatures": special,
        }
      )
  
    return rows


