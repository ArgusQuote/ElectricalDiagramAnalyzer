  def _update_feedback_button(self):
    """
    Updates the standalone feedback button based on current feedback state.
    """
    btn = getattr(self, "feedback_btn", None)
    if btn is None:
      return

    if bool(getattr(self, "_feedback_submitted", False)):
      btn.text = "Feedback Recorded"
      btn.enabled = False
      btn.tooltip = "Feedback has already been recorded for this job."
    else:
      btn.text = "Give Feedback"
      btn.enabled = True
      btn.tooltip = "Submit quick accuracy feedback for this job."

  def _make_component_scrollable(self, comp, height_px=700):
    """
    Force internal scrolling on a component so the page itself does not grow too tall.
    """
    try:
      el = js.get_dom_node(comp)
      if not el:
        return

      el.style.setProperty("height", f"{height_px}px", "important")
      el.style.setProperty("max-height", f"{height_px}px", "important")
      el.style.setProperty("overflow-y", "auto", "important")
      el.style.setProperty("overflow-x", "hidden", "important")
      el.style.setProperty("padding-right", "4px", "important")
      el.style.setProperty("box-sizing", "border-box", "important")
    except Exception:
      pass

