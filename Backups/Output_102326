      self._apply_detection_zebra_tint(block, is_good=True, zebra_role=zebra_role)

      dg = self._make_single_panel_table(r)
      self._add_full_width(block, dg)

      try:
        js.window.setTimeout(lambda dg=dg: self._force_datagrid_table_full_width(dg), 0)
        js.window.setTimeout(
          lambda dg=dg: self._force_datagrid_table_full_width(dg), 100
        )
      except Exception:
        self._force_datagrid_table_full_width(dg)

      detection_suffix = self._panel_detection_suffix(r.get("name") or "")
      status_text = status if not note else f"{status} — {note}"
      lab = Label(
        text=f"   Status: {status_text}{detection_suffix}", bold=True, align="left"
      )
      lab.foreground = "theme:Background"
      lab.font_size = CARD_FONT_SIZE
      self._add_full_width(block, lab)

      self._add_full_width(host, block)

  def _force_host_full_width(self, host_component):
    """
    Force a specific Anvil component (like linear_panel_3) to span full width by
    overriding bootstrap column widths on ALL ancestors.
    """
    try:
      host = host_component
      if host is None:
        return
      try:
        host.width = "100%"
      except Exception:
        pass

      el = js.get_dom_node(host)
      if not el:
        return

      # Tag it for CSS targeting if needed
      try:
        el.setAttribute("data-argus-hostwide", "1")
      except Exception:
        pass

      hops = 0
      cur = el
      while cur is not None and hops < 80:
        try:
          s = cur.style
          s.setProperty("width", "100%", "important")
          s.setProperty("max-width", "none", "important")
          s.setProperty("margin-left", "0", "important")
          s.setProperty("margin-right", "0", "important")
          s.setProperty("padding-left", "0", "important")
          s.setProperty("padding-right", "0", "important")

          # If any ancestor is a bootstrap column, force it to full width
          cls = cur.className or ""
          if "col-" in cls:
            s.setProperty("flex", "0 0 100%", "important")
            s.setProperty("max-width", "100%", "important")
        except Exception:
          pass

        try:
          cur = cur.parentElement
        except Exception:
          cur = None
        hops += 1

      # Finally: force the host element itself to act like a block that can stretch
      try:
        el.style.setProperty("display", "block", "important")
        el.style.setProperty("flex", "1 1 auto", "important")
      except Exception:
        pass

    except Exception:
      pass

  def _admin_asset_owner_email(self):
    """
    Resolve the actual job owner for admin asset/image calls.

    Primary source:
      self._admin_target_email from accountmanagement/router.

    Fallback source:
      result["uploaded_by"], injected by get_job_result_for_admin_user().
    """
    result = getattr(self, "result", None) or {}

    candidates = [
      getattr(self, "_admin_target_email", ""),
      result.get("uploaded_by"),
      result.get("owner_email"),
      result.get("owner_id"),
    ]

    for v in candidates:
      email = str(v or "").strip().lower()
      if email:
        return email

    return ""

  def _job_server_call(self, fn_name, job_id, *args):
    """
    Calls job asset functions.

    Normal user mode:
      fn(job_id, *args)

    Admin view:
      fn(job_id, *args, actual_job_owner_email)
    """
    result = getattr(self, "result", None) or {}

    job_id = str(
      job_id or getattr(self, "_admin_job_id", "") or result.get("job_id") or ""
    ).strip()

    if bool(getattr(self, "_admin_view", False)):
      target_email = self._admin_asset_owner_email()

      if not target_email:
        raise Exception(
          "Admin image owner email is missing. "
          "Expected admin_target_email or result.uploaded_by."
        )

      return anvil.server.call(fn_name, job_id, *args, target_email)

    return anvil.server.call(fn_name, job_id, *args)

  def _job_server_call_silent(
    self,
    fn_name,
    job_id,
    *args
  ):
    """
    Same job-aware server call, but suppress the global Anvil
    loading spinner.
  
    Used for secondary/background assets like preview images.
    """
    with anvil.server.no_loading_indicator:
      return self._job_server_call(
        fn_name,
        job_id,
        *args
      )

  def _job_server_call_async(
    self,
    fn_name,
    job_id,
    *args
  ):
    """
    True non-blocking server call using Anvil Extras.

    Normal user:
      fn(job_id, *args)

    Admin:
      fn(job_id, *args, actual_job_owner_email)
    """
    result = (
      getattr(
        self,
        "result",
        None,
      )
      or {}
    )

    job_id = str(
      job_id
      or getattr(
        self,
        "_admin_job_id",
        "",
      )
      or result.get(
        "job_id"
      )
      or ""
    ).strip()

    if bool(
      getattr(
        self,
        "_admin_view",
        False,
      )
    ):
      target_email = (
        self._admin_asset_owner_email()
      )

      if not target_email:
        raise Exception(
          "Admin image owner email is missing."
        )

      return call_async(
        fn_name,
        job_id,
        *args,
        target_email,
      )

    return call_async(
      fn_name,
      job_id,
      *args,
    )
    
