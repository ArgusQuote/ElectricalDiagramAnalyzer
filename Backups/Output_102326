    review.spacing = "none"
    review.padding = "16px"
    review.background = "#191C1D"
    review.foreground = "theme:White"
    review.role = "outlined-card"

    if editing:
      ctx[
        "review_block"
      ] = review

      banner = Label(
        text=(
