      trim = "SURFACE"

    elif (
      enclosure_trim
      == "SURFACE_NEMA1"
    ):
      enclosure = "NEMA1"
      trim = "SURFACE"

    else:
      enclosure = "NEMA1"
      trim = "FLUSH"

    wa.update(
      {
        "material": material,
        "bussingMaterial": material,
        "bussing_material": material,

        "panelRatingType": rating,
        "ratingType": rating,
        "rating_type": rating,

        "enclosure": enclosure,

        "trimStyle": trim,
        "trim_style": trim,
      }
    )

    ctx["dirty"] = True

    on_changed()


  def _make_inline_breaker_side(
    self,
    designation,
    side,
    position_count,
    stage_height,
    row_height,
    on_changed,
  ):
    """
    Editable left/right circuit list.

    Each breaker row is one continuous visual cell.

    Edit/add/delete controls sit directly inside that same cell,
    so there are no separate button-colored rectangles.
    """
    TABLE_WIDTH = 230
    CKT_WIDTH = 42

    BREAKER_CELL_WIDTH = (
      TABLE_WIDTH
      - CKT_WIDTH
    )

    EDIT_WIDTH = 24
    DELETE_WIDTH = 24

    GROUP_HEADER_HEIGHT = 28
    COLUMN_HEADER_HEIGHT = 22

    first = (
      1
      if side == "left"
      else 2
    )

    panel = XYPanel()

    panel.width = TABLE_WIDTH
    panel.height = stage_height
    panel.background = "#252D33"

    title = Label(
      text=(
        "LEFT BREAKERS"
        if side == "left"
        else "RIGHT BREAKERS"
      ),
      align="center",
      bold=True,
      foreground="#FFFFFF",
      background="#3D4850",
    )

    title.font_size = 12

    panel.add_component(
      title,
      x=0,
      y=0,
      width=TABLE_WIDTH,
      height=GROUP_HEADER_HEIGHT,
    )

    ckt_header = Label(
      text="CKT",
      align="center",
      bold=True,
      foreground="#DCE4E8",
      background="#323C43",
    )

    ckt_header.font_size = 10

    breaker_header = Label(
      text="BREAKER",
      align="center",
      bold=True,
      foreground="#DCE4E8",
      background="#323C43",
    )

    breaker_header.font_size = 10

    panel.add_component(
      ckt_header,
      x=0,
      y=GROUP_HEADER_HEIGHT,
      width=CKT_WIDTH,
      height=COLUMN_HEADER_HEIGHT,
    )

    panel.add_component(
      breaker_header,
      x=CKT_WIDTH,
      y=GROUP_HEADER_HEIGHT,
      width=BREAKER_CELL_WIDTH,
      height=COLUMN_HEADER_HEIGHT,
    )

    ctx = self._panel_edit_ctx(
      designation
    )

    attrs = (
      ctx["working"].get(
        "attrs"
      )
      or {}
    )

    issue_circuits = set()

    for issue in (
      attrs.get(
        "breaker_position_issues"
      )
      or []
    ):
      if not isinstance(
        issue,
        dict,
      ):
        continue

      if (
        str(
          issue.get("side")
          or ""
        ).strip().lower()
        != side
      ):
        continue

      circuit = self._safe_int(
        issue.get(
          "circuitNumber"
        )
        or issue.get(
          "circuit_number"
        )
      )

      if circuit is not None:
        issue_circuits.add(
          circuit
        )

    body_y = (
      GROUP_HEADER_HEIGHT
      + COLUMN_HEADER_HEIGHT
    )

    for slot in range(
      position_count
    ):
      circuit = (
        first
        + slot * 2
      )

      (
        _idx,
        breaker,
      ) = (
        self._edit_breaker_at_circuit(
          designation,
          circuit,
        )
      )

      has_breaker = (
        breaker is not None
      )

      has_issue = (
        circuit
        in issue_circuits
      )

      circuit_background = (
        "#303A41"
        if slot % 2 == 0
        else "#37434A"
      )

      if has_issue:
        breaker_background = (
          "#8B2E2E"
        )

      elif has_breaker:
        breaker_background = (
          "#285775"
          if slot % 2 == 0
          else "#316681"
        )

      else:
        breaker_background = (
          "#252D33"
          if slot % 2 == 0
          else "#2C353B"
        )

      y = (
        body_y
        + slot * row_height
      )

      ckt = Label(
        text=str(
          circuit
        ),
        align="center",
        bold=True,
        foreground="#DCE4E8",
        background=circuit_background,
      )

      ckt.font_size = 10

      panel.add_component(
        ckt,
        x=0,
        y=y,
        width=CKT_WIDTH,
        height=row_height,
      )

      # ------------------------------------------------
      # One continuous breaker cell.
      # ------------------------------------------------

      breaker_cell = XYPanel()

      breaker_cell.width = (
        BREAKER_CELL_WIDTH
      )

      breaker_cell.height = (
        row_height
      )

      breaker_cell.background = (
        breaker_background
      )

      panel.add_component(
        breaker_cell,
        x=CKT_WIDTH,
        y=y,
        width=BREAKER_CELL_WIDTH,
        height=row_height,
      )

      if has_breaker:
        breaker_text_width = (
          BREAKER_CELL_WIDTH
          - EDIT_WIDTH
          - DELETE_WIDTH
        )

      else:
        breaker_text_width = (
          BREAKER_CELL_WIDTH
          - EDIT_WIDTH
        )

      breaker_link = Link(
        text=(
          self._edit_breaker_text(
            breaker
          )
        ),
        underline=False,
      )

      breaker_link.align = "center"
      breaker_link.bold = has_breaker

      breaker_link.foreground = (
        "#FFFFFF"
        if (
          has_breaker
          or has_issue
        )
        else "#9AA6AE"
      )

      breaker_link.background = (
        "transparent"
      )

      breaker_link.font_size = 11

      edit_link = Link(
        text=(
          "✎"
          if has_breaker
          else "+"
        ),
        underline=False,
      )

      edit_link.align = "center"
      edit_link.bold = True
      edit_link.foreground = "#4AA8E8"

      edit_link.background = (
        "transparent"
      )

      edit_link.font_size = 13

      def _edit(
        sender,
        circuit=circuit,
        **e
      ):
        self._open_inline_breaker_editor(
          designation,
          circuit,
          on_changed,
        )

      breaker_link.set_event_handler(
        "click",
        _edit,
      )

      edit_link.set_event_handler(
        "click",
        _edit,
      )

      breaker_cell.add_component(
        breaker_link,
        x=0,
        y=0,
        width=breaker_text_width,
        height=row_height,
      )

      breaker_cell.add_component(
        edit_link,
        x=breaker_text_width,
        y=0,
        width=EDIT_WIDTH,
        height=row_height,
      )

      if has_breaker:
        delete_link = Link(
          text="✕",
          underline=False,
        )

        delete_link.align = "center"
        delete_link.bold = True
        delete_link.foreground = "#FF8A80"

        delete_link.background = (
          "transparent"
        )

        delete_link.font_size = 12

        delete_link.tooltip = (
          f"Delete breaker from "
          f"circuit {circuit}"
        )

        def _delete(
          sender,
          circuit=circuit,
          **e
        ):
          self._delete_inline_breaker(
            designation,
            circuit,
            on_changed,
          )

        delete_link.set_event_handler(
          "click",
          _delete,
        )

        breaker_cell.add_component(
          delete_link,
          x=(
            breaker_text_width
            + EDIT_WIDTH
          ),
          y=0,
          width=DELETE_WIDTH,
          height=row_height,
        )

    return panel
    
  def _make_inline_breaker_visual_pane(
    self,
    designation,
    on_changed,
  ):
    """
    Drawing verification view used while editing.

    Every circuit position stays independently actionable.
    """
    attrs = (
      self._panel_raw_attrs(
        designation
      )
      or {}
    )

    spaces = (
      self._safe_int(
        attrs.get(
          "spaces"
        )
      )
      or 0
    )

    # --------------------------------------------------
    # If an old panel has a breaker outside the current
    # spaces value, still show enough circuits to edit it.
    # --------------------------------------------------

    highest = 0

    for breaker in (
      self._raw_breakers_for_panel(
        designation
      )
      or []
    ):
      if not isinstance(
        breaker,
        dict,
      ):
        continue

      highest = max(
        highest,
        (
          self._safe_int(
            breaker.get(
              "circuitNumber"
            )
            or breaker.get(
              "circuit_number"
            )
          )
          or 0
        ),
      )

    total_circuits = max(
      spaces,
      highest,
      2,
    )

    position_count = max(
      1,
      (
        total_circuits
        + 1
      )
      // 2,
    )

    SLOT_WIDTH = 230
    IMAGE_WIDTH = 650
    COLUMN_GAP = 18
    IMAGE_PADDING = 10

    ROW_HEIGHT = 22
    HEADER_HEIGHT = 50

    visual_height = max(
      360,
      (
        HEADER_HEIGHT
        + position_count
        * ROW_HEIGHT
      ),
    )

    left_grid = (
      self._make_inline_breaker_side(
        designation,
        "left",
        position_count,
        visual_height,
        ROW_HEIGHT,
        on_changed,
      )
    )

    right_grid = (
      self._make_inline_breaker_side(
        designation,
        "right",
        position_count,
        visual_height,
        ROW_HEIGHT,
        on_changed,
      )
    )

    # =========================================================
    # IMAGE FRAME
    # =========================================================

    image_frame = XYPanel()

    image_frame.width = IMAGE_WIDTH
    image_frame.height = visual_height
    image_frame.background = "#DCE3E8"

    status = Label(
      text="Loading panel preview…",
      align="center",
      foreground="#252D33",
    )

    image_frame.add_component(
      status,
      x=IMAGE_PADDING,
      y=IMAGE_PADDING,
      width=(
        IMAGE_WIDTH
        - IMAGE_PADDING * 2
      ),
      height=(
        visual_height
        - IMAGE_PADDING * 2
      ),
    )

    panel_source, _ = (
      self._panel_source(
        designation
      )
    )

    def _image_ready(
      media
    ):
      if media is None:
        status.text = (
          "Panel preview unavailable."
        )

        return

      panel_image = Image(
        source=media,
        width="100%",
        height=(
          visual_height
          - IMAGE_PADDING * 2
        ),
        display_mode="shrink_to_fit",
      )

      preview_link = Link(
        tooltip=(
          "Click image to enlarge"
        )
      )

      preview_link.underline = False

      preview_link.tag = {
        "source": (
          panel_source
          or ""
        ),
        "name": designation,
        "lookup_name": designation,
        "display_name": (
          self._panel_display_name(
            designation
          )
        ),
        "job_id": (
          self.result.get(
            "job_id"
          )
          or ""
        ),
      }

      preview_link.set_event_handler(
        "click",
        self._preview_click,
      )

      preview_link.add_component(
        panel_image
      )

      image_frame.add_component(
        preview_link,
        x=IMAGE_PADDING,
        y=IMAGE_PADDING,
        width=(
          IMAGE_WIDTH
          - IMAGE_PADDING * 2
        ),
        height=(
          visual_height
          - IMAGE_PADDING * 2
        ),
      )

      status.visible = False

    try:
      js.window.setTimeout(
        lambda:
        self._fetch_panel_preview_media_async(
          designation,
          _image_ready,
        ),
        25,
      )

    except Exception:
      self._fetch_panel_preview_media_async(
        designation,
        _image_ready,
      )

    # =========================================================
    # SIDE + IMAGE + SIDE COMPOSITION
    # =========================================================

    composition_width = (
      SLOT_WIDTH
      + COLUMN_GAP
      + IMAGE_WIDTH
      + COLUMN_GAP
      + SLOT_WIDTH
    )

    composition = XYPanel()

    composition.width = (
      composition_width
    )

    composition.height = (
      visual_height
    )

    composition.background = (
      "transparent"
    )

    image_x = (
      SLOT_WIDTH
      + COLUMN_GAP
    )

    right_x = (
      image_x
      + IMAGE_WIDTH
      + COLUMN_GAP
    )

    composition.add_component(
      left_grid,
      x=0,
      y=0,
      width=SLOT_WIDTH,
      height=visual_height,
    )

    composition.add_component(
      image_frame,
      x=image_x,
      y=0,
      width=IMAGE_WIDTH,
      height=visual_height,
    )

    composition.add_component(
      right_grid,
      x=right_x,
      y=0,
      width=SLOT_WIDTH,
      height=visual_height,
    )

    visual_card = LinearPanel()

    visual_card.width = "100%"
    visual_card.spacing = "none"
    visual_card.padding = "12px"
    visual_card.background = "#232A2F"
    visual_card.foreground = "#FFFFFF"
    visual_card.role = "outlined-card"

    centered = FlowPanel(
      align="center"
    )

    centered.width = "100%"
    centered.spacing = "none"

    centered.add_component(
      composition
    )

    visual_card.add_component(
      centered
    )

    pane = LinearPanel()

    pane.width = "100%"
    pane.spacing = "none"

    pane.add_component(
      visual_card
    )

    return pane


  def _render_panel_review_host(
