  def _panel_preview_candidate_paths(
    self,
    designation: str,
  ) -> list:
    """
    Return possible preview paths for a panel in priority order.

    Usually the first exact source path succeeds.
    The other paths preserve the existing fallback behavior.
    """
    import re

    src, disp_name = (
      self._panel_source(
        designation
      )
    )

    lookup_name = str(
      disp_name
      or designation
      or "panel"
    ).strip()

    safe_base = re.sub(
      r"[^A-Za-z0-9_\-]+",
      "_",
      lookup_name,
    ).strip("_") or "panel"

    overlay_file = (
      f"{safe_base}_review_overlay.png"
    )

    candidates = []

    def _add(
      path
    ):
      path = self._norm_path(
        path
      )

      if not path:
        return

      if path not in candidates:
        candidates.append(
          path
        )

    # Exact parser/source path first.
    _add(
      src
    )

    # Existing fallbacks.
    _add(
      f"pdf_images/review_overlays/"
      f"{overlay_file}"
    )

    _add(
      f"review_overlays/"
      f"{overlay_file}"
    )

    return candidates
    
  def _fetch_panel_preview_media(
    self,
    designation: str,
  ):
    """
    Synchronous panel preview fetch.

    Kept for older/modal code paths.
    Normal output-card loading now uses the async version below.
    """
    job_id = str(
      self.result.get(
        "job_id"
      )
      or ""
    ).strip()

    if not job_id:
      return None

    candidates = (
      self._panel_preview_candidate_paths(
        designation
      )
    )

    for candidate in candidates:
      try:
        media = (
          self._fetch_overlay_image(
            candidate
          )
        )

        if media is not None:
          return media

      except Exception:
        pass

    return None

  def _fetch_panel_preview_media_async(
    self,
    designation: str,
    on_done,
  ):
    """
    Async panel image fetch.

    Tries the exact source first, then existing fallback paths.

    Used for BOTH:
      - foreground/current panel requests
      - background prefetch requests
    """
    candidates = (
      self._panel_preview_candidate_paths(
        designation
      )
    )

    if not candidates:
      try:
        on_done(None)
      except Exception:
        pass

      return

    def _try_candidate(
      index=0
    ):
      if index >= len(
        candidates
      ):
        try:
          on_done(None)
        except Exception:
          pass

        return

      path = candidates[
        index
        ]

      def _candidate_done(
        media
      ):
        if media is not None:
          try:
            on_done(
              media
            )
          except Exception:
            pass

          return

        _try_candidate(
          index + 1
        )

      self._request_overlay_image_async(
        path,
        _candidate_done,
      )

    _try_candidate(
      0
    )    

  def _fetch_panel_preview_media_for_identity(self, identity, comp=None):
    """
    Fetch preview media for either a normal panel name or a problem-panel
    identity dict. Source path is tried first for problem items.
    """
    job_id = str(self.result.get("job_id") or "").strip()
    if not job_id:
      return None

    if not isinstance(identity, dict):
      return self._fetch_panel_preview_media(identity)

    candidates = []

    def _add(p):
      p = self._norm_path(p)
      if p and p not in candidates:
        candidates.append(p)

    _add(identity.get("source"))
    _add(identity.get("raw_source"))
    _add(identity.get("overlay_source"))
    _add(identity.get("preview_source"))

    if isinstance(comp, dict):
      _add(comp.get("source"))
      _add(comp.get("overlay_source"))
      _add(comp.get("overlaySource"))
      _add(comp.get("preview_source"))
      _add(comp.get("previewSource"))
      _add(comp.get("reviewOverlayPath"))
      _add(comp.get("review_overlay_path"))

    lookup_name = str(
      identity.get("lookup_name")
      or identity.get("name")
      or (comp or {}).get("name")
      or ""
    ).strip()

    if lookup_name:
      try:
        m = self._fetch_panel_preview_media(lookup_name)
        if m is not None:
          return m
      except Exception:
        pass

    for cand in candidates:
      try:
        return self._job_server_call("fetch_specs_image", job_id, cand)
      except Exception:
        pass

    return None

  def _patch_status_row_colspan(self):
    """
    Make status rows truly span all columns by applying colspan to the first TD
    and removing the remaining TDs.
    """
    try:
      dg = getattr(self, "data_grid_2", None)
      if not isinstance(dg, DataGrid):
        return

      root = js.get_dom_node(dg)

      # Find the marker label we set: lab.role = "status-marker"
      markers = root.querySelectorAll(".anvil-role-status-marker")
      mcount = int(markers.length) if hasattr(markers, "length") else 0
      if mcount == 0:
        return

      for idx in range(mcount):
        try:
          m = markers.item(idx)
          tr = m.closest("tr")
          if not tr:
            continue

          tr.classList.add("status-row")

          tds = tr.querySelectorAll("td")
          n = int(tds.length) if hasattr(tds, "length") else 0
          if n < 2:
            continue

          first = tds.item(0)
          # span all columns
          first.setAttribute("colspan", str(n))

          # remove remaining tds
          # (remove index 1 repeatedly because NodeList can be "live")
          while True:
            tds2 = tr.querySelectorAll("td")
            n2 = int(tds2.length) if hasattr(tds2, "length") else 0
            if n2 <= 1:
              break
            try:
              tds2.item(1).remove()
            except Exception:
              break

        except Exception:
          pass

    except Exception:
      pass

