      card.add_component(dg_panel)

      # Force the DataGrid/table to stretch like your detected-panels tables
      try:
        js.window.setTimeout(
          lambda dg=dg_panel: self._force_datagrid_table_full_width(dg), 0
        )
        js.window.setTimeout(
          lambda dg=dg_panel: self._force_datagrid_table_full_width(dg), 100
        )
      except Exception:
        self._force_datagrid_table_full_width(dg_panel)

      host.add_component(card)
      host.add_component(Spacer(height=18))

  def _iter_designations_in_panel_order(self, rows_by_des: dict):
    def _norm(s):
      return str(s or "").strip().upper()

      # bucket all keys by normalized name, preserving insertion order

    buckets = {}
    for k in rows_by_des.keys():
      nk = _norm(k)
      buckets.setdefault(nk, []).append(k)

    panel_order = getattr(self, "_panel_order", []) or []

    # First: consume in visual panel order, one-by-one per normalized bucket
    for _, nk in panel_order:
      lst = buckets.get(nk, [])
      if lst:
        yield lst.pop(0)

      # Then: leftovers in original insertion order
    for nk in list(buckets.keys()):
      lst = buckets.get(nk) or []
      while lst:
        yield lst.pop(0)

  def _extract_non_panel_items(self) -> list[dict]:
    """
    Expect optional payload:
      result["non_panelboard_items"] = [
        {"source": "pdf_images/review_overlays/item_001.png"},
        ...
      ]
    If not present, return empty list.

    IMPORTANT:
    Do NOT auto-promote attr-less panelboard detections into this bucket.
    Those should stay in the panel-derived problem path only.
    """
    res = self.result or {}
    items = res.get("non_panelboard_items") or res.get("nonPanelboardItems") or []
    out = []

    if isinstance(items, list):
      for it in items:
        if isinstance(it, str):
          src = self._norm_path(it)
          if src:
            out.append({"source": src})
        elif isinstance(it, dict):
          src = self._norm_path(
            it.get("source")
            or it.get("overlay_source")
            or it.get("overlaySource")
            or ""
          )
          if src:
            out.append({"source": src})

    # De-dupe robustly:
    seen_base = set()
    seen_full = set()
    dedup = []

    for r in out:
      s = self._norm_path(r.get("source"))
      if not s:
        continue

      base = s.split("/")[-1].strip().lower()

      if (base and base in seen_base) or (s.lower() in seen_full):
        continue

      if base:
        seen_base.add(base)
      seen_full.add(s.lower())
      dedup.append({"source": s})

    return dedup

  def _set_attention_section_state(self, has_problem_items: bool):
    """
    Store whether Attention Needed should be open, then apply it once the DOM exists.
    """
    self._attention_has_problem_items = bool(has_problem_items)
    self._apply_attention_state_delayed()

  def _apply_attention_state_delayed(self):
    """
    Apply Attention Needed open/collapsed state after Anvil has rendered the HTML.

    Empty:
      collapsed, says No problem items found.

    Has rows:
      open, says Problem items were found.
    """
    try:

      def _apply():
        try:
          has_items = bool(getattr(self, "_attention_has_problem_items", False))

          root = None
          try:
            root = js.get_dom_node(self)
          except Exception:
            root = None

          if root:
            details = root.querySelector(".attention-collapse")
            note = root.querySelector(".attention-summary-note")
            action = root.querySelector(".attention-summary-action")
          else:
            details = js.document.querySelector(".argus-output-v1 .attention-collapse")
            note = js.document.querySelector(".argus-output-v1 .attention-summary-note")
            action = js.document.querySelector(
              ".argus-output-v1 .attention-summary-action"
            )

          if details:
            if has_items:
              details.setAttribute("open", "")
              details.open = True
            else:
              details.removeAttribute("open")
              details.open = False

            details.setAttribute("data-has-items", "1" if has_items else "0")

          if note:
            note.textContent = (
              "Problem items were found. Review this section before using the BOM."
              if has_items
              else "No problem items found."
            )

          if action:
            action.setAttribute("data-has-items", "1" if has_items else "0")

        except Exception:
          pass

      js.window.setTimeout(_apply, 0)
      js.window.setTimeout(_apply, 100)
      js.window.setTimeout(_apply, 300)
      js.window.setTimeout(_apply, 700)
      js.window.setTimeout(_apply, 1200)

    except Exception:
      pass

