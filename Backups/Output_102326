      for m in markers:
        try:
          tr = m.closest("tr")
          if tr:
            tr.classList.add("status-row")
        except Exception:
          pass
    except Exception:
      pass

  # ---------- Card helpers ----------
  def _panel_source(self, designation: str):
    """Return (source_path, display_name) for this designation, or (None, name)."""
    des_n = self._norm(designation)
    for row in self._extract_panels() or []:
      if self._norm(row.get("name")) == des_n:
        return str(row.get("source") or "").strip(), str(row.get("name") or "").strip()
    return None, designation

  def _component_display_name(self, comp: dict, fallback: str = "") -> str:
    """
    User-facing panel name.

    Keeps comp['name'] as the stable/internal lookup key, but allows
    comp['display_name'] to show the user's corrected name.
    """
    if not isinstance(comp, dict):
      return str(fallback or "").strip()

    internal = str(
      comp.get("original_name") or comp.get("name") or fallback or ""
    ).strip()

    display = str(comp.get("display_name") or "").strip()

    if display and self._norm(display) != self._norm(internal):
      return f"{display} (edited)"

    return internal or str(fallback or "").strip()

  def _panel_display_name(self, designation: str) -> str:
    comp = self._get_component_for_panel(designation)
    return self._component_display_name(comp, designation)

  def _component_csv_name(self, comp: dict, fallback: str = "") -> str:
    """
    CSV-facing panel name.

    Unlike _component_display_name(), this does NOT append '(edited)'.
    If the user renamed Panel A to H, CSV should show H.
    """
    if not isinstance(comp, dict):
      return str(fallback or "").strip()

    internal = str(
      comp.get("original_name") or comp.get("name") or fallback or ""
    ).strip()

    display = str(comp.get("display_name") or "").strip()

    if display and self._norm(display) != self._norm(internal):
      return display

    return internal or str(fallback or "").strip()

  def _panel_csv_name(self, designation: str) -> str:
    comp = self._get_component_for_panel(designation)
    return self._component_csv_name(comp, designation)

  def _panel_meta(self, designation: str) -> dict:
    des_n = self._norm(designation)
  
    for row in self._extract_panels() or []:
      if self._norm(row.get("name")) == des_n:
        return {
          "panel_status": str(
            row.get("panel_status") or ""
          ).strip(),
  
          "panel_note": str(
            row.get("panel_note") or ""
          ).strip(),
  
          "special_header_type": row.get(
            "special_header_type"
          ),
  
          "suspected_existing": bool(
            row.get("suspected_existing", False)
          ),
  
          "existing_reason": str(
            row.get("existing_reason") or ""
          ).strip(),
  
          "existing_detection": str(
            row.get("existing_detection") or ""
          ).strip(),
        }
  
    return {}

  def _apply_panel_bom_include_state(
    self,
    designation: str,
    included: bool,
  ):
    """
    Apply the panel-level inclusion state to the GENERATED BOM only.

    Raw Drawing Information remains fully usable and editable.

    Included:
      - normal BOM appearance
      - individual BOM checkboxes work normally

    Excluded:
      - BOM side visibly dimmed
      - individual BOM checkboxes disabled
      - explicit EXCLUDED FROM BOM notice shown
    """
    des_n = self._norm(
      designation
    )

    included = bool(
      included
    )

    # --------------------------------------------------
    # Generated BOM pane visual state.
    # --------------------------------------------------
    bom_pane = (
      self._panel_bom_panes.get(
        des_n
      )
    )

    if bom_pane is not None:
      try:
        bom_pane.role = (
          "panel-bom-included"
          if included
          else "panel-bom-excluded"
        )
      except Exception:
        pass

    # --------------------------------------------------
    # Explicit status message.
    # --------------------------------------------------
    excluded_lab = (
      self._panel_bom_excluded_labels.get(
        des_n
      )
    )

    if excluded_lab is not None:
      try:
        excluded_lab.visible = (
          not included
        )
      except Exception:
        pass

    # --------------------------------------------------
    # Individual BOM row checkboxes.
    # --------------------------------------------------
    for row in (
      self._flat_rows
      or []
    ):
      if self._norm(
        row.get("designation")
      ) != des_n:
        continue

      cb = row.get(
        "_include_checkbox"
      )

      if cb is None:
        continue

      try:
        if included:
          cb.enabled = bool(
            row.get(
              "csv_selectable",
              False,
            )
          )

        else:
          cb.enabled = False

      except Exception:
        pass
    
  def _set_existing_panel_included(
    self,
    designation: str,
    included: bool,
  ):
    """
    Fast panel-level include toggle.

    - No card rebuild
    - No image reload
    - No server call
    - Directly updates csv_include
    - Directly updates visible row checkboxes
    - Restores previous row states when re-enabled
    """
    des_n = self._norm(designation)

    self._existing_panel_include_state[des_n] = bool(
      included
    )

    for row in self._flat_rows or []:
      if self._norm(
        row.get("designation")
      ) != des_n:
        continue

      item_type = str(
        row.get("item_type") or ""
      ).strip()

      if item_type in (
        "Note",
        "Skipped",
      ):
        continue

      if not included:
        # Save original state only once.
        if "_before_existing_exclude" not in row:
          row["_before_existing_exclude"] = bool(
            row.get("csv_include", False)
          )

        row["csv_include"] = False

      else:
        # Restore exactly what this row had before exclusion.
        if "_before_existing_exclude" in row:
          row["csv_include"] = bool(
            row.pop("_before_existing_exclude")
          )
      
      # Update the visible checkbox immediately.
      cb = row.get("_include_checkbox")

      if cb is not None:
        try:
          cb.checked = bool(
            row.get("csv_include", False)
          )
        except Exception:
          pass

    # Apply the Generated BOM visual/interaction state once,
    # after all BOM rows have been updated.
    self._apply_panel_bom_include_state(
      designation,
      included,
    )
    

  def _fmt_attr_chip(self, label: str, value) -> Component:
    """Single-line chip: 'Label: value' (no stacked text)."""
    txt = "-" if value in (None, "", "NONE") else str(value)
    lab = Label(text=f"{label}: {txt}", foreground="theme:Background")
    lab.width = "18%"  # helps distribute across the bar
    return lab

  def _make_item_row(self, row_dict: dict) -> Component:
    """
    Build a single BOM item row for a card.
    Columns: Item Type | Product | Description | Qty | Include
    """
    row = FlowPanel(spacing="small")
    row.role = None

    def L(text, w=None, align=None, bold=False):
      lab = Label(text=text, bold=bold, align=align)
      if w:
        lab.width = w
      return lab

    # Compute description (like your DataGrid path)
    try:
      row_dict["description"] = self._describe_row(row_dict)
    except Exception:
      row_dict["description"] = ""

    # Columns (use fixed-ish widths for quick readability in cards)
    row.add_component(L(str(row_dict.get("item_type", "")), w="12%"))
    row.add_component(L(str(row_dict.get("product", "")), w="28%"))
    row.add_component(L(str(row_dict.get("description", "")), w="34%"))
    row.add_component(L(str(row_dict.get("qty", "")), w="8%", align="center"))

    itype = str(row_dict.get("item_type") or "").strip()
    show_cb = itype not in ("Note", "Skipped")
    if show_cb:
      cb = CheckBox()
      cb.checked = bool(row_dict.get("csv_include", False))
      cb.enabled = bool(row_dict.get("csv_selectable", False))
      cb.tooltip = "Include this row in CSV"

      def _on_change(sender=cb, r=row_dict, **e):
        r["csv_include"] = bool(sender.checked)

      cb.set_event_handler("change", _on_change)
      row.add_component(cb)
    else:
      row.add_component(L("", w="8%"))

    return row

  def _get_cards_host(self):
    """
    Return the container to render cards into.

    Priority:
    1. Design-time BOM host: linear_panel_1
    2. Existing content_panel, if this form has one
    3. Create a safe fallback host dynamically

    This prevents AttributeError when opening older/saved jobs
    that do not have a normal rules_result payload.
    """

    host = getattr(self, "linear_panel_1", None)

    if isinstance(host, (ColumnPanel, FlowPanel, LinearPanel, GridPanel, XYPanel)):
      return host

    host = getattr(self, "content_panel", None)

    if isinstance(host, (ColumnPanel, FlowPanel, LinearPanel, GridPanel, XYPanel)):
      return host

    # Last-resort fallback: create a host on the form itself
    host = ColumnPanel()
    host.width = "100%"
    host.spacing = "medium"
    host.padding = "18px"

    try:
      self.add_component(host)
    except Exception:
      pass

    self._fallback_content_panel = host
    return host

  def _make_items_grid(self, rows: list) -> DataGrid:
    """
    Build the normal BOM item grid.

    Note rows are intentionally excluded here and rendered separately
    below the DataGrid so they are not constrained by grid columns.
    """
    dg = DataGrid()
    dg.width = "100%"
    dg.show_header = True
    dg.show_page_controls = False
    dg.rows_per_page = 1000
    dg.role = "bom-grid"

    dg.background = "transparent"
    dg.foreground = "theme:Background"

    dg.columns = [
      {
        "id": "item",
        "title": "Item",
        "data_key": "item",
        "width": 250,
      },
      {
        "id": "pn",
        "title": "Part Number",
        "data_key": "pn",
        "width": 250,
      },
      {
        "id": "details",
        "title": "Details",
        "data_key": "details",
        "width": 440,
      },
      {
        "id": "qty",
        "title": "Qty",
        "data_key": "qty",
        "width": 70,
      },
      {
        "id": "include",
        "title": "Include",
        "data_key": "include",
        "width": 90,
      },
    ]

    # Clear previous rows/components
    for c in list(dg.get_components()):
      try:
        c.remove_from_parent()
      except Exception:
        pass

    def H(text, align=None):
      lab = Label(text=text, bold=True, align=align)
      lab.font_size = CARD_FONT_SIZE
      lab.foreground = "theme:Background"
      return lab

    def L(text, align=None):
      lab = Label(text=text, align=align)
      lab.font_size = CARD_FONT_SIZE
      lab.foreground = "theme:Background"
      return lab

    # Header row
    hdr = DataRowPanel(role="custom-grid-header")
    hdr.background = "#A3A9B4"
    hdr.add_component(H("Item"), column="item")
    hdr.add_component(H("Part Number"), column="pn")
    hdr.add_component(H("Details"), column="details")
    hdr.add_component(H("Qty", align="center"), column="qty")
    hdr.add_component(H("Include", align="center"), column="include")
    dg.add_component(hdr, slot="header")

    # Only normal BOM rows belong in the DataGrid.
    grid_rows = [
      r for r in rows
      if str(r.get("item_type") or "").strip() != "Note"
    ]

    for i, r in enumerate(grid_rows):
      try:
        r["description"] = self._describe_row(r)
      except Exception:
        r["description"] = ""

      role = "zebra-odd" if (i % 2 == 0) else "zebra-even"

      row = DataRowPanel(role=role)
      row.background = "#FFFFFF" if role == "zebra-odd" else "#E0E1DD"

      itype = str(r.get("item_type") or "").strip()

      row.add_component(
        L(str(r.get("item_type", ""))),
        column="item"
      )

      row.add_component(
        L(str(r.get("product", ""))),
        column="pn"
      )

      row.add_component(
        L(str(r.get("description", ""))),
        column="details"
      )

      row.add_component(
        L(str(r.get("qty", "")), align="center"),
        column="qty"
      )

      if itype != "Skipped":
        cb = CheckBox()
        cb.checked = bool(r.get("csv_include", False))
        cb.enabled = bool(r.get("csv_selectable", False))
        cb.tooltip = "Include this row in CSV"

        # Save direct reference so panel-level toggle can update
        # this checkbox instantly without rebuilding the card.
        r["_include_checkbox"] = cb

        def _on_change(sender=cb, rr=r, **e):
          rr["csv_include"] = bool(sender.checked)

        cb.set_event_handler("change", _on_change)

        row.add_component(
          cb,
          column="include"
        )

      else:
        # Make sure stale references do not survive a rebuild.
        r.pop("_include_checkbox", None)

        row.add_component(
          L("", align="center"),
          column="include"
        )

      dg.add_component(row)

    return dg

