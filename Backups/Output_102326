        )
        return

      updated_result = resp.get("result") or {}
      if not updated_result:
        alert("Rules rerun completed, but no updated result was returned.")
        return

      self._refresh_after_panel_edit(updated_result)

      Notification("BOM updated", timeout=2).show()

    except Exception as e:
