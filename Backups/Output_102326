    )

    volts = self._safe_int(
      attrs.get(
        "voltage"
      )
    )

    main_amps = self._safe_int(
      attrs.get(
        "mainBreakerAmperage"
      )
    )

    int_rating = self._safe_int(
      attrs.get(
        "intRating"
      )
    )

    spaces = self._safe_int(
      attrs.get(
        "spaces"
      )
    )

    bussing = (
      raw.get(
        "bussingMaterial"
      )
      or raw.get(
        "bussing_material"
      )
      or pb.get(
        "bussing_material"
      )
    )

    rating = (
      raw.get(
        "ratingType"
      )
      or raw.get(
        "rating_type"
      )
      or pb.get(
        "rating_type"
      )
    )

    enclosure = (
      raw.get(
        "enclosure"
      )
      or pb.get(
        "enclosure"
      )
    )

    trim = (
      raw.get(
        "trimStyle"
      )
      or raw.get(
        "trim_style"
      )
      or pb.get(
        "default_trim_style"
      )
    )

    # --------------------------------------------------
    # Rerender only the black review area after each
    # local edit.
    # --------------------------------------------------

