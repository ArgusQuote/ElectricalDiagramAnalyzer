    return text


  def _position_breaker_visual_labels(
    self,
    image_component,
    left_host,
    right_host,
    left_entries,
    right_entries,
  ):
    """
    Position the outside breaker labels against the actual rendered image.
    """
    try:
      image_root = js.get_dom_node(image_component)
      left_root = js.get_dom_node(left_host)
      right_root = js.get_dom_node(right_host)
  
      if not image_root or not left_root or not right_root:
        return
  
      # For an Anvil Image, get_dom_node() may already return the <img>.
      tag_name = str(
        getattr(image_root, "tagName", "") or ""
      ).strip().lower()
  
      if tag_name == "img":
        actual_img = image_root
      else:
        actual_img = image_root.querySelector("img")
  
      if not actual_img:
        return
  
      img_rect = actual_img.getBoundingClientRect()
      left_rect = left_root.getBoundingClientRect()
      right_rect = right_root.getBoundingClientRect()
  
      rendered_height = float(img_rect.height)
  
      if rendered_height <= 0:
        return
  
      def _place(entries, host_rect, side):
        for label_component, ratio in entries:
          try:
            ratio_f = float(ratio)
          except Exception:
            continue
  
          ratio_f = max(
            0.0,
            min(1.0, ratio_f),
          )
  
          label_root = js.get_dom_node(
            label_component
          )
  
          if not label_root:
            continue
  
          y_px = (
            float(img_rect.top)
            - float(host_rect.top)
            + (ratio_f * rendered_height)
          )
  
          label_root.style.setProperty(
            "position",
            "absolute",
            "important",
          )
  
          label_root.style.setProperty(
            "top",
            f"{y_px}px",
            "important",
          )
  
          label_root.style.setProperty(
            "transform",
            "translateY(-50%)",
            "important",
          )
  
          label_root.style.setProperty(
            "width",
            "100%",
            "important",
          )
  
          label_root.style.setProperty(
            "margin",
            "0",
            "important",
          )
  
          label_root.style.setProperty(
            "padding",
            "0",
            "important",
          )
  
          label_root.style.setProperty(
            "z-index",
            "20",
            "important",
          )
  
          label_root.style.setProperty(
            "pointer-events",
            "none",
            "important",
          )
  
          if side == "left":
            label_root.style.setProperty(
              "text-align",
              "right",
              "important",
            )
          else:
            label_root.style.setProperty(
              "text-align",
              "left",
              "important",
            )
  
      _place(
        left_entries,
        left_rect,
        "left",
      )
  
      _place(
        right_entries,
        right_rect,
        "right",
      )
  
    except Exception:
      pass


  def _make_breaker_visual_pane(self, designation: str):
    """
    Simple breaker verification view:

        LEFT SLOT LIST | PANEL IMAGE | RIGHT SLOT LIST

    Confident breakers display as "<poles>P <amps>A".

    Each pole occupies one position, so multipole breakers receive
    continuation rows:

        2P 30A
        -

        3P 100A
        -
        -

    Spaces, unreadable values, uncertain values, and invalid values
    display only as "-".
    """
    pane = LinearPanel()
    pane.width = "100%"
    pane.spacing = "none"
    pane.padding = "0"
    pane.background = "transparent"
    pane.foreground = "theme:White"
    pane.role = None

    breakers = (
      self._raw_breakers_for_panel(
        designation
      )
      or []
    )

    def _sort_ratio(
      breaker,
      original_index,
    ):
      """
      Sort records from top to bottom.

      Records without a usable yCenterRatio retain their original
      order after records whose positions are known.
      """
      try:
        ratio = float(
          breaker.get(
            "yCenterRatio"
          )
        )

        return (
          0,
          ratio,
          original_index,
        )

      except (
        AttributeError,
        TypeError,
        ValueError,
      ):
        return (
          1,
          original_index,
          original_index,
        )

    def _known_pole_count(
      breaker,
      formatted_label=None,
    ):
      """
      Return the number of positions occupied by this record.

      This can still return a known pole count when the amperage is
      unreadable. That allows an unreadable 3P breaker to produce
      three "-" rows instead of only one.
      """
      if formatted_label:
        for token in str(
          formatted_label
        ).upper().split():

          cleaned = (
            token
            .strip()
            .replace(",", "")
          )

          if cleaned.endswith("P"):
            try:
              poles = int(
                cleaned[:-1]
              )

              if 1 <= poles <= 4:
                return poles

            except (
              TypeError,
              ValueError,
            ):
              pass

      if isinstance(
        breaker,
        dict,
      ):
        for key in (
          "poles",
          "pole",
          "poleCount",
          "pole_count",
          "numPoles",
        ):
          try:
            poles = int(
              float(
                breaker.get(key)
              )
            )

            if 1 <= poles <= 4:
              return poles

          except (
            TypeError,
            ValueError,
          ):
            pass

      return 1

    def _confident_breaker_label(
      breaker,
    ):
      """
      Return:

          ("1P 20A", 1)
          ("2P 30A", 2)
          ("3P 100A", 3)

      Anything without both a valid pole count and valid amperage
      returns None as its label.
      """
      try:
        formatted = (
          self._format_breaker_visual_label(
            breaker
          )
        )

      except Exception:
        return (
          None,
          _known_pole_count(
            breaker
          ),
        )

      if not formatted:
        return (
          None,
          _known_pole_count(
            breaker
          ),
        )

      pole_value = None
      amp_value = None

      for token in str(
        formatted
      ).upper().split():

        cleaned = (
          token
          .strip()
          .replace(",", "")
        )

        if cleaned.endswith("P"):
          try:
            candidate = int(
              cleaned[:-1]
            )

            if 1 <= candidate <= 4:
              pole_value = candidate

          except (
            TypeError,
            ValueError,
          ):
            pass

        elif cleaned.endswith("A"):
          try:
            candidate = float(
              cleaned[:-1]
            )

            if candidate > 0:
              amp_value = candidate

          except (
            TypeError,
            ValueError,
          ):
            pass

      if pole_value is not None:
        occupied_positions = (
          pole_value
        )

      else:
        occupied_positions = (
          _known_pole_count(
            breaker,
            formatted,
          )
        )

      if (
        pole_value is None
        or amp_value is None
      ):
        return (
          None,
          occupied_positions,
        )

      if amp_value.is_integer():
        amp_text = str(
          int(amp_value)
        )

      else:
        amp_text = (
          str(amp_value)
          .rstrip("0")
          .rstrip(".")
        )

      label_text = (
        f"{pole_value}P "
        f"{amp_text}A"
      )

      return (
        label_text,
        occupied_positions,
      )

    def _slot_rows_for_side(side):
      """
      Place breakers into their physical circuit rows.

      Missing or unreadable detections remain "-", without shifting
      later breakers into the wrong circuit.
      """
      panel_component = (
        self._get_component_for_panel(designation)
        or {}
      )

      panel_attrs = (
        panel_component.get("attrs")
        or {}
      )

      position_issues = (
        panel_attrs.get(
          "breaker_position_issues"
        )
        or []
      )

      total_circuits = self._safe_int(
        panel_attrs.get("spaces")
      )

      position_count = max(
        1,
        ((total_circuits or 2) + 1) // 2,
      )

      def _ratio(breaker):
        try:
          return float(
            breaker.get("yCenterRatio")
          )
        except (
          AttributeError,
          TypeError,
          ValueError,
        ):
          return None

      def _circuit_number(breaker):
        for key in (
          "circuitNumber",
          "circuit_number",
          "circuitNo",
          "circuit_no",
          "circuit",
          "ckt",
        ):
          value = self._safe_int(
            breaker.get(key)
          )

          if value is not None and value > 0:
            return value

        return None

      all_entries = []
      side_entries = []
      ratios_by_side = {
        "left": [],
        "right": [],
      }

      for original_index, breaker in enumerate(breakers):
        if not isinstance(breaker, dict):
          continue

        breaker_side = str(
          breaker.get("side")
          or ""
        ).strip().lower()

        if breaker_side not in ratios_by_side:
          continue

        label_text, occupied_positions = (
          _confident_breaker_label(breaker)
        )

        entry = {
          "index": original_index,
          "side": breaker_side,
          "row_index": self._safe_int(
            breaker.get("rowIndex")
          ),
          "row_top": self._safe_int(
            breaker.get("rowTop")
          ),
          "row_bottom": self._safe_int(
            breaker.get("rowBottom")
          ),
          "label": label_text,
          "span": max(1, occupied_positions),
          "ratio": _ratio(breaker),
          "circuit": _circuit_number(breaker),
          "position_issue": bool(
            breaker.get(
              "circuitPositionIssue"
            )
          ),
        }

        all_entries.append(entry)

        if entry["ratio"] is not None:
          ratios_by_side[breaker_side].append(
            entry["ratio"]
          )

        if breaker_side == side:
          side_entries.append(entry)

      single_row_heights = sorted(
        entry["row_bottom"] - entry["row_top"]
        for entry in all_entries
        if (
          entry["span"] == 1
          and entry["row_top"] is not None
          and entry["row_bottom"] is not None
          and entry["row_bottom"] > entry["row_top"]
        )
      )

      physical_row_height = (
        single_row_heights[
          len(single_row_heights) // 2
          ]
        if single_row_heights
        else None
      )

      physical_grid_top = min(
        (
          entry["row_top"]
          for entry in all_entries
          if entry["row_top"] is not None
        ),
        default=None,
      )
      
      row_gaps = []

      for side_ratios in ratios_by_side.values():
        side_ratios.sort()

        row_gaps.extend(
          current - previous
          for previous, current in zip(
            side_ratios,
            side_ratios[1:],
          )
          if current > previous
        )

      row_gaps.sort()

      if row_gaps:
        lower_half = row_gaps[
          :max(1, (len(row_gaps) + 1) // 2)
          ]

        row_pitch = lower_half[
          len(lower_half) // 2
          ]
      else:
        row_pitch = None

      row_origin = None

      if row_pitch is not None and row_pitch > 0:
        adjusted_starts = [
          entry["ratio"]
          - (
            (entry["span"] - 1)
            * row_pitch
            / 2
          )
          for entry in all_entries
          if entry["ratio"] is not None
        ]

        adjusted_ends = [
          entry["ratio"]
          + (
            (entry["span"] - 1)
            * row_pitch
            / 2
          )
          for entry in all_entries
          if entry["ratio"] is not None
        ]

        if (
          adjusted_starts
          and adjusted_ends
          and position_count > 1
        ):
          observed_span = (
            max(adjusted_ends)
            - min(adjusted_starts)
          )

          if round(
            observed_span / row_pitch
          ) == position_count - 1:
            row_pitch = (
              observed_span
              / (position_count - 1)
            )

        adjusted_starts = [
          entry["ratio"]
          - (
            (entry["span"] - 1)
            * row_pitch
            / 2
          )
          for entry in all_entries
          if entry["ratio"] is not None
        ]

        if adjusted_starts:
          row_origin = min(adjusted_starts)

      rows = [
        "-"
        for _ in range(position_count)
      ]

      occupied = [
        False
        for _ in range(position_count)
      ]

      issue_slots = set()

      first_circuit = (
        1 if side == "left" else 2
      )

      side_entries.sort(
        key=lambda entry: (
          entry["ratio"] is None,
          entry["ratio"]
          if entry["ratio"] is not None
          else entry["index"],
        )
      )

      for entry in side_entries:
        slot_index = None

        circuit_number = (
          entry["circuit"]
        )

        # New authoritative path:
        # use the CKT-derived display circuit.
        if (
          circuit_number is not None
          and circuit_number >= first_circuit
          and (
            circuit_number
            - first_circuit
          ) % 2 == 0
        ):
          slot_index = (
            circuit_number
            - first_circuit
          ) // 2

        # Old geometry remains as a fallback for cached/older jobs.
        else:
          row_top = entry["row_top"]
          row_bottom = entry["row_bottom"]

          if (
            row_top is not None
            and row_bottom is not None
            and physical_grid_top is not None
            and physical_row_height is not None
            and physical_row_height > 0
          ):
            label_center = (
              row_top + row_bottom
            ) / 2

            first_row_center = (
              physical_grid_top
              + (
                physical_row_height
                / 2
              )
            )

            slot_index = int(
              (
                label_center
                - first_row_center
              )
              / physical_row_height
              + 0.5
            )

          else:
            slot_index = (
              entry["row_index"]
            )

        if (
          slot_index is None
          or slot_index < 0
          or slot_index >= position_count
        ):
          continue

        if occupied[slot_index]:
          continue

        rows[slot_index] = (
          entry["label"]
          or "-"
        )

        occupied[slot_index] = True

      # Add markers for red OCR/review cells that did not produce
      # a valid breaker record.
      for issue in position_issues:
        if not isinstance(issue, dict):
          continue

        issue_side = str(
          issue.get("side")
          or ""
        ).strip().lower()

        if issue_side != side:
          continue

        issue_circuit = self._safe_int(
          issue.get("circuitNumber")
        )

        if (
          issue_circuit is None
          or issue_circuit < first_circuit
          or (
            issue_circuit
            - first_circuit
          ) % 2 != 0
        ):
          continue

        issue_slot = (
          issue_circuit
          - first_circuit
        ) // 2

        if (
          0 <= issue_slot
          < position_count
        ):
          issue_slots.add(
            issue_slot
          )

      return rows, issue_slots

    (
      left_rows,
      left_issue_slots,
    ) = _slot_rows_for_side(
      "left"
    )

    (
      right_rows,
      right_issue_slots,
    ) = _slot_rows_for_side(
      "right"
    )

    # Use the panel's declared circuit count as the minimum number of
    # positions per side. For example, a 42-circuit panel has 21 rows
    # on the left and 21 rows on the right.
    panel_component = (
      self._get_component_for_panel(
        designation
      )
      or {}
    )

    panel_attrs = (
      panel_component.get("attrs")
      or {}
    )

    total_circuits = self._safe_int(
      panel_attrs.get("spaces")
    )

    if (
      total_circuits is not None
      and total_circuits > 0
    ):
      expected_side_positions = (
        total_circuits + 1
      ) // 2
    else:
      expected_side_positions = 0

    # Make both sides the same length. If one side has fewer usable
    # records, its remaining positions display as "-".
    position_count = max(
      len(left_rows),
      len(right_rows),
      expected_side_positions,
      1,
    )

    left_rows.extend(
      ["-"]
      * (
        position_count
        - len(left_rows)
      )
    )

    right_rows.extend(
      ["-"]
      * (
        position_count
        - len(right_rows)
      )
    )

    # =========================================================
    # THREE RESPONSIVE PANEL-SIZE PROFILES
    # =========================================================

    SLOT_COLUMN_WIDTH = 196
    CKT_COLUMN_WIDTH = 46
    IMAGE_COLUMN_WIDTH = 650
    COLUMN_GAP = 18
    IMAGE_PADDING = 10

    GROUP_HEADER_HEIGHT = 28
    COLUMN_HEADER_HEIGHT = 22

    profile_circuits = max(
      total_circuits or 0,
      position_count * 2,
    )

    if profile_circuits <= 26:
      visual_height = 360

    elif profile_circuits <= 56:
      visual_height = 520

    else:
      visual_height = 640

    available_body_height = max(
      1,
      (
        visual_height
        - GROUP_HEADER_HEIGHT
        - COLUMN_HEADER_HEIGHT
      ),
    )

    slot_height = max(
      11,
      min(
        22,
        available_body_height
        // max(position_count, 1),
      ),
    )

    if slot_height >= 20:
      breaker_font_size = 12
      circuit_font_size = 11

    elif slot_height >= 16:
      breaker_font_size = 11
      circuit_font_size = 10

    else:
      breaker_font_size = 10
      circuit_font_size = 9

    composition_width = (
      SLOT_COLUMN_WIDTH
      + COLUMN_GAP
      + IMAGE_COLUMN_WIDTH
      + COLUMN_GAP
      + SLOT_COLUMN_WIDTH
    )

    def _make_slot_grid(
      rows,
      header_text,
      first_circuit,
      issue_slots,
    ):
      return self._make_breaker_side_html_grid(
        rows=rows,
        header_text=header_text,
        first_circuit=first_circuit,
        issue_slots=issue_slots,
        stage_height=visual_height,
        row_height=slot_height,
        breaker_font_size=breaker_font_size,
        circuit_font_size=circuit_font_size,
        table_width=SLOT_COLUMN_WIDTH,
        circuit_width=CKT_COLUMN_WIDTH,
        group_header_height=GROUP_HEADER_HEIGHT,
        column_header_height=COLUMN_HEADER_HEIGHT,
      )    

    left_grid = _make_slot_grid(
      left_rows,
      "LEFT BREAKERS",
      1,
      left_issue_slots,
    )

    right_grid = _make_slot_grid(
      right_rows,
      "RIGHT BREAKERS",
      2,
      right_issue_slots,
    )

    image_frame = XYPanel()
    image_frame.width = IMAGE_COLUMN_WIDTH
    image_frame.height = visual_height
    image_frame.background = "#DCE3E8"
    image_frame.role = None

    def _round_image_frame():
      try:
        frame_root = js.get_dom_node(
          image_frame
        )

        if not frame_root:
          return

        frame_root.style.setProperty(
          "border-radius",
          "10px",
          "important",
        )

        frame_root.style.setProperty(
          "overflow",
          "hidden",
          "important",
        )

        image_node = frame_root.querySelector(
          "img"
        )

        if image_node:
          image_node.style.setProperty(
            "width",
            f"{IMAGE_COLUMN_WIDTH - (IMAGE_PADDING * 2)}px",
            "important",
          )

          image_node.style.setProperty(
            "height",
            f"{visual_height - (IMAGE_PADDING * 2)}px",
            "important",
          )

          image_node.style.setProperty(
            "max-width",
            "none",
            "important",
          )

          image_node.style.setProperty(
            "max-height",
            "none",
            "important",
          )

          image_node.style.setProperty(
            "object-fit",
            "contain",
            "important",
          )

          image_node.style.setProperty(
            "object-position",
            "center",
            "important",
          )

          image_node.style.setProperty(
            "display",
            "block",
            "important",
          )

          image_node.style.setProperty(
            "padding",
            "0",
            "important",
          )

          image_node.style.setProperty(
            "margin",
            "0",
            "important",
          )

      except Exception:
        pass

    try:
      js.window.setTimeout(
        _round_image_frame,
        0,
      )

      js.window.setTimeout(
        _round_image_frame,
        50,
      )

      js.window.setTimeout(
        _round_image_frame,
        150,
      )

    except Exception:
      _round_image_frame()

    # Render the drawing frame and circuit lists before requesting media.
    preview_status = Label(
      text="Loading panel preview…",
      align="center",
      foreground="#252D33",
    )
    image_frame.add_component(
      preview_status,
      x=IMAGE_PADDING,
      y=IMAGE_PADDING,
      width=IMAGE_COLUMN_WIDTH - IMAGE_PADDING * 2,
      height=visual_height - IMAGE_PADDING * 2,
    )

    panel_source, _source_name = self._panel_source(designation)
    display_designation = self._panel_display_name(designation)

    def _image_ready(media):
      try:
        if media is None:
          preview_status.text = "Panel preview unavailable."
          return

        panel_image = Image(
          source=media,
          display_mode="shrink_to_fit",
          width="100%",
          height=visual_height - IMAGE_PADDING * 2,
        )
        panel_image.spacing_above = "none"
        panel_image.spacing_below = "none"

        preview_link = Link(tooltip="Click image to enlarge")
        preview_link.underline = False
        preview_link.tag = {
          "source": panel_source or "",
          "name": designation,
          "lookup_name": designation,
          "display_name": display_designation,
          "job_id": self.result.get("job_id") or "",
        }
        preview_link.set_event_handler("click", self._preview_click)
        preview_link.add_component(panel_image)
        image_frame.add_component(
          preview_link,
          x=IMAGE_PADDING,
          y=IMAGE_PADDING,
          width=IMAGE_COLUMN_WIDTH - IMAGE_PADDING * 2,
          height=visual_height - IMAGE_PADDING * 2,
        )
        preview_status.visible = False
        _round_image_frame()
        try:
          js.window.setTimeout(_round_image_frame, 0)
          js.window.setTimeout(_round_image_frame, 150)
        except Exception:
          pass
      finally:
        # A missing foreground image must not stop background prefetch.
        self._start_panel_prefetching()

    def _load_preview():
      self._fetch_panel_preview_media_async(designation, _image_ready)

    try:
      js.window.setTimeout(_load_preview, 50)
    except Exception:
      _load_preview()

    composition = XYPanel()
    composition.width = composition_width
    composition.height = visual_height
    composition.background = "transparent"

    image_x = (
      SLOT_COLUMN_WIDTH
      + COLUMN_GAP
    )

    right_x = (
      image_x
      + IMAGE_COLUMN_WIDTH
      + COLUMN_GAP
    )

    composition.add_component(
      left_grid,
      x=0,
      y=0,
      width=SLOT_COLUMN_WIDTH,
      height=visual_height,
    )

    composition.add_component(
      image_frame,
      x=image_x,
      y=0,
      width=IMAGE_COLUMN_WIDTH,
      height=visual_height,
    )

    composition.add_component(
      right_grid,
      x=right_x,
      y=0,
      width=SLOT_COLUMN_WIDTH,
      height=visual_height,
    )

    visual_card = LinearPanel()
    visual_card.width = "100%"
    visual_card.spacing = "none"
    visual_card.padding = "12px"
    visual_card.background = "#232A2F"
    visual_card.foreground = "#FFFFFF"
    visual_card.role = "outlined-card"

    centered_composition = FlowPanel(
      align="center"
    )

    centered_composition.width = "100%"
    centered_composition.spacing = "none"
    centered_composition.background = "transparent"

    centered_composition.add_component(
      composition
    )

    visual_card.add_component(
      centered_composition
    )

    pane.add_component(
      visual_card
    )

    return pane


  def _raw_breakers_for_panel(self, designation: str) -> list[dict]:
    """
    Return the individual breaker records currently shown in review.

    During inline edit mode this reads the working copy so the left/right
    display and Breaker Summary update immediately before anything is saved.
    """
    comp = self._panel_component_for_review(designation) or {}
    attrs = comp.get("attrs") or {}
    breakers = attrs.get("detected_breakers") or []

    if not isinstance(breakers, list):
      return []

    return [
      b for b in breakers
      if isinstance(b, dict)
    ]


  def _make_panel_bom_side_by_side_card(
    self,
    designation: str,
    rows: list,
    item_index: int = None,
    total_items: int = None,
  ) -> Component:
    """
    One panel review card.

    The black review block is rendered through
    _render_panel_review_host() so it can switch cleanly
    between normal review and locked inline edit mode.
    """
    card = ColumnPanel(
      role="outlined-card"
    )

    card.width = "100%"
    card.spacing = "none"
    card.padding = "18px"
    card.background = "theme:White"
    card.foreground = "theme:Background"

    display_designation = (
      self._panel_display_name(
        designation
      )
    )

    # =========================================================
    # PANEL TITLE / ITEM COUNT
    # =========================================================

    top = GridPanel()

    top.width = "100%"
    top.role = None
    top.spacing = "none"

    left_spacer = Label(
      text=""
    )

    title = Label(
      text=(
        f"Panel: "
        f"{display_designation or '(unnamed)'}"
      ),
      bold=True,
      align="center",
      foreground="theme:Background",
    )

    title.font_size = (
      CARD_FONT_SIZE + 2
    )

    title.width = "100%"

    if (
      item_index is not None
      and total_items is not None
    ):
      count_lab = Label(
        text=(
          f"Item "
          f"{item_index}/"
          f"{total_items}"
        ),
        align="right",
        foreground="theme:Secondary 500",
      )

    else:
      count_lab = Label(
        text="",
        align="right",
      )

    count_lab.width = "100%"

    top.add_component(
      left_spacer,
      row="A",
      col_xs=0,
      width_xs=2,
    )

    top.add_component(
      title,
      row="A",
      col_xs=2,
      width_xs=8,
    )

    top.add_component(
      count_lab,
      row="A",
      col_xs=10,
      width_xs=2,
    )

    card.add_component(
      top
    )

    # =========================================================
    # PANEL-LEVEL BOM INCLUDE CONTROL
    # =========================================================

    meta = (
      self._panel_meta(
        designation
      )
      or {}
    )

    is_existing = bool(
      meta.get(
        "suspected_existing",
        False,
      )
    )

    include_row = FlowPanel(
      align="center",
      spacing="small",
    )

    include_row.width = "100%"

    include_row.role = (
      "panel-include-bar-existing"
      if is_existing
      else "panel-include-bar"
    )

    if is_existing:
      detection = str(
        meta.get(
          "existing_detection"
        )
        or ""
      ).strip()

      status_text = (
        "⚠ Existing Panel"
        if detection in (
          "explicit_existing",
          "explicit_ex",
        )
        else "⚠ Suspected Existing"
      )

      status_lab = Label(
        text=status_text,
        bold=True,
        foreground="#B85C00",
        role="existing-panel-status",
      )

      status_lab.font_size = (
        CARD_FONT_SIZE
      )

      include_row.add_component(
        status_lab
      )

      divider = Label(
        text="│",
        foreground="#9A9A9A",
      )

      divider.font_size = (
        CARD_FONT_SIZE - 2
      )

      include_row.add_component(
        divider
      )

    des_n = self._norm(
      designation
    )

    included = (
      self._existing_panel_include_state.get(
        des_n,
        True,
      )
    )

    include_cb = CheckBox(
      text="Include in BOM"
    )

    include_cb.checked = included
    include_cb.foreground = "theme:Background"
    include_cb.bold = True
    include_cb.font_size = CARD_FONT_SIZE

    include_cb.spacing_above = "none"
    include_cb.spacing_below = "none"

    include_cb.role = (
      "panel-master-include"
    )

    def _panel_include_changed(
      sender,
      designation=designation,
      **e
    ):
      self._set_existing_panel_included(
        designation,
        bool(sender.checked),
      )

    include_cb.set_event_handler(
      "change",
      _panel_include_changed,
    )

    include_row.add_component(
      include_cb
    )

    card.add_component(
      include_row
    )

    card.add_component(
      Spacer(height=10)
    )

    # =========================================================
    # REVIEW BLOCK HOST
    #
    # Normal mode and inline edit mode both render here.
    # =========================================================

    review_host = LinearPanel()

    review_host.width = "100%"
    review_host.spacing = "none"

    card.add_component(
      review_host
    )

    self._render_panel_review_host(
      review_host,
      designation,
    )

    # =========================================================
    # GENERATED BOM
    # =========================================================

    card.add_component(
      Spacer(height=18)
    )

    bom_pane = (
      self._make_bom_table_pane(
        designation,
        rows,
      )
    )

    excluded_lab = Label(
      text="⚠ EXCLUDED FROM BOM",
      bold=True,
      align="center",
      foreground="#B42318",
      background="#FEE4E2",
      visible=not included,
    )

    excluded_lab.font_size = (
      CARD_FONT_SIZE
    )

    excluded_lab.spacing_above = "small"
    excluded_lab.spacing_below = "small"

    try:
      bom_pane.add_component(
        excluded_lab,
        index=1,
      )

    except Exception:
      bom_pane.add_component(
        excluded_lab
      )

    self._panel_bom_panes[
      des_n
    ] = bom_pane

    self._panel_bom_excluded_labels[
      des_n
    ] = excluded_lab

    card.add_component(
      bom_pane
    )

    self._apply_panel_bom_include_state(
      designation,
      included,
    )

    return card


  def _panel_quick_attrs(
    self,
    designation: str,
  ) -> dict:
    """
    Return quick attributes for a designation.

    During inline editing, the temporary working copy becomes
    authoritative so the displayed chips update immediately.

    Outside edit mode, preserve the normal final-built-value
    behavior from rules_result.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if ctx:
      return dict(
        (
          ctx["working"].get(
            "attrs"
          )
          or {}
        )
      )

    amap = (
      self._panel_attrs_map()
      or {}
    )

    a = dict(
      amap.get(
        self._norm(
          designation
        ),
        {},
      )
      or {}
    )

    rules = (
      (self.result or {}).get(
        "rules_result"
      )
      or {}
    )

    payload = (
      rules.get(
        designation
      )
      or {}
    )

    final_amperage = (
