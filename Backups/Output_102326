  def _safe_int(self, value):
    try:
      if value in (None, "", "NONE", "-", "X"):
        return None
      return int(float(str(value).strip()))
    except Exception:
      return None

  def _pretty_default_value(self, value):
    s = str(value or "").strip()
    if not s or s.upper() in ("NONE", "X", "-"):
      return ""

    # normalize separators/casing first
    s = s.replace("_", " ").replace("-", " ")
    s_upper = s.upper()

    exact_map = {
      "COPPER": "Copper",
      "ALUMINUM": "Aluminum",
      "FULLY RATED": "Fully Rated",
      "SERIES RATED": "Series Rated",
      "NEMA1": "Nema 1",
      "NEMA 1": "Nema 1",
      "NEMA3R": "Nema 3R",
      "NEMA 3R": "Nema 3R",
      "SURFACE": "Surface",
      "FLUSH": "Flush",
    }

    if s_upper in exact_map:
      return exact_map[s_upper]

    return " ".join(word.capitalize() for word in s.split())

  def _display_or_dash(self, value, suffix=""):
    if value in (None, "", "NONE", "-", "X"):
      return "-"
    return f"{value}{suffix}"

  def _normalize_panel_name_from_overlay_path(self, path: str) -> str:
    """
    Return the SAFE overlay base, not the human panel name.
    Example:
      pdf_images/review_overlays/M_1_review_overlay.png -> M_1
    """
    filename = str(path or "").split("/")[-1]
    if filename.lower().endswith("_review_overlay.png"):
      filename = filename[: -len("_review_overlay.png")]
    return str(filename or "").strip().upper()

  def _find_panel_row_for_overlay(self, overlay_path: str) -> dict:
    """
    Match a review overlay image back to the extracted panel row.

    1) Try exact source-path match
    2) Then match by SAFE overlay base derived from the panel name
      so names like 'M.1' correctly match 'M_1_review_overlay.png'
    """
    overlay_norm = self._norm_path(overlay_path)
    panels = self._extract_panels() or []

    # 1) Exact path match
    for row in panels:
      row_src = self._norm_path(row.get("source"))
      if row_src == overlay_norm:
        return row

    # 2) Safe-name match
    overlay_base = self._normalize_panel_name_from_overlay_path(overlay_path)

    for row in panels:
      row_name = str(row.get("name") or "").strip()
      if not row_name:
        continue

      row_safe_base = self._panel_safe_overlay_base(row_name)
      if row_safe_base == overlay_base:
        return row

    return {}

  def _collect_breaker_counts_for_panel(self, designation: str) -> list[str]:
    """
    Return formatted breaker count lines like:
    15 - 1P 20A
    2 - 3P 50A
    """
    rules = (self.result or {}).get("rules_result") or {}
    payload = rules.get(designation) or {}

    counts = {}

    for key, val in payload.items():
      if not (isinstance(key, str) and key.startswith("Branch Breakers")):
        continue
      if not isinstance(val, list):
        continue

      for item in val:
        if not isinstance(item, dict):
          continue

        pn = item.get("Part Number") or item.get("part_number") or ""
        qty = int(item.get("count", 1) or 1)

        parsed = self._parse_breaker_part_number(pn)
        poles = parsed.get("poles")
        amps = parsed.get("amperage")

        if poles is None or amps is None:
          label = str(pn).strip() or "Unknown Breaker"
        else:
          label = f"{poles}P {amps}A"

        counts[label] = counts.get(label, 0) + qty

    def _sort_key(text):
      try:
        parts = text.split()
        poles = int(parts[0].replace("P", ""))
        amps = int(parts[1].replace("A", ""))
        return (poles, amps, text)
      except Exception:
        return (999, 999999, text)

    lines = []
    for label in sorted(counts.keys(), key=_sort_key):
      lines.append(f"{counts[label]} - {label}")

    return lines

  def _build_panel_defaults_summary_lines(self, designation: str) -> list[str]:
    """
    Build quick summary lines from detected attrs + job defaults.
    """
    attrs = self._panel_raw_attrs(designation) or {}
    ui = (self.result or {}).get("ui_overrides", {}) or {}
    pb = ui.get("panelboards", {}) or {}

    amperage = self._safe_int(attrs.get("amperage"))
    voltage = self._safe_int(attrs.get("voltage"))
    main_amps = self._safe_int(attrs.get("mainBreakerAmperage"))
    int_rating = self._safe_int(attrs.get("intRating"))
    spaces = self._safe_int(attrs.get("spaces"))

    bussing_material = (
      attrs.get("bussingMaterial")
      or attrs.get("bussing_material")
      or pb.get("bussing_material")
    )
    rating_type = (
      attrs.get("ratingType") or attrs.get("rating_type") or pb.get("rating_type")
    )
    enclosure = attrs.get("enclosure") or pb.get("enclosure")
    trim_style = (
      attrs.get("trimStyle") or attrs.get("trim_style") or pb.get("default_trim_style")
    )

    lines = [
      f"Bus Amps: {amperage}A" if amperage is not None else "Bus Amps: -",
      f"Volts: {voltage}V" if voltage is not None else "Volts: -",
      f"Main Amps: {main_amps}A" if main_amps is not None else "Main Amps: -",
      f"Interrupting Rating: {int_rating}K"
      if int_rating is not None
      else "Interrupting Rating: -",
      f"Spaces: {spaces}" if spaces is not None else "Spaces: -",
    ]

    defaults_parts = []

    for raw_value in (bussing_material, rating_type, enclosure, trim_style):
      pretty = self._pretty_default_value(raw_value)
      if pretty:
        defaults_parts.append(pretty)

    lines.append(
      f"Additional Info: {', '.join(defaults_parts)}"
      if defaults_parts
      else "Additional Info: -"
    )

    return lines

  def _panel_summary_tile(self, overlay_path: str, w: int, h: int):
    """
    Individual panel tile:
    panel name
    image
    compact white-label summary lines
    breaker count lines
    """
    panel_row = self._find_panel_row_for_overlay(overlay_path) or {}
    panel_name = str(
      panel_row.get("name")
      or self._normalize_panel_name_from_overlay_path(overlay_path)
      or "Panel"
    ).strip()

    tile = ColumnPanel(width=w)
    tile.spacing = "none"

    title = Label(text=panel_name, bold=True, align="center", foreground="white")
    tile.add_component(title)

    img = Image(
      source=self._fetch_overlay_image(overlay_path),
      width="100%",
      height=h,
      display_mode="shrink_to_fit",
      tooltip=overlay_path,
    )
    tile.add_component(img)

    summary_card = ColumnPanel(role="outlined-card")
    summary_card.spacing = "none"
    summary_card.padding = "8px 12px"

    for line in self._build_panel_defaults_summary_lines(panel_name):
      lab = Label(text=line, foreground="white")
      lab.spacing_above = "none"
      lab.spacing_below = "none"
      summary_card.add_component(lab)

    summary_card.add_component(Spacer(height=8))

    breaker_header = Label(text="Breaker Counts:", bold=True, foreground="white")
    breaker_header.spacing_above = "none"
    breaker_header.spacing_below = "none"
    summary_card.add_component(breaker_header)

    breaker_lines = self._collect_breaker_counts_for_panel(panel_name)

    if breaker_lines:
      for line in breaker_lines:
        lab = Label(text=line, foreground="white")
        lab.spacing_above = "none"
        lab.spacing_below = "none"
        summary_card.add_component(lab)
    else:
      lab = Label(text="None detected", foreground="white")
      lab.spacing_above = "none"
      lab.spacing_below = "none"
      summary_card.add_component(lab)

    tile.add_component(summary_card)
    return tile
  
  def _fetch_overlay_image(
    self,
    path: str,
  ):
    """
    Synchronous/cached image fetch.

    Kept for places that still need a direct result immediately.
    """
    job_id = str(
      self.result.get(
        "job_id"
      )
      or ""
    ).strip()

    path = self._norm_path(
      path
    )

    if (
      not job_id
      or not path
    ):
      return None

    if not hasattr(
      self,
      "_overlay_cache"
    ):
      self._overlay_cache = {}

    key = (
      job_id,
      path,
    )

    media = (
      self._overlay_cache.get(
        key
      )
    )

    if media is None:
      media = (
        self._job_server_call_silent(
          "fetch_specs_image",
          job_id,
          path,
        )
      )

      if media is not None:
        self._overlay_cache[
          key
        ] = media

    return media

  def _request_overlay_image_async(
    self,
    path: str,
    on_done,
  ):
    """
    Request one overlay image asynchronously.

    Important behavior:

      - cached image -> callback immediately
      - already downloading -> attach another waiter
      - new path -> start one async server request

    This prevents duplicate downloads when:
      - a panel is being prefetched
      - the user clicks that panel
      - another UI component requests the same image
    """
    job_id = str(
      self.result.get(
        "job_id"
      )
      or ""
    ).strip()

    path = self._norm_path(
      path
    )

    if (
      not job_id
      or not path
    ):
      try:
        on_done(None)
      except Exception:
        pass

      return

    if not hasattr(
      self,
      "_overlay_cache"
    ):
      self._overlay_cache = {}

    if not hasattr(
      self,
      "_overlay_async_waiters"
    ):
      self._overlay_async_waiters = {}

    key = (
      job_id,
      path,
    )

    # --------------------------------------------------
    # Already cached.
    # --------------------------------------------------
    cached = (
      self._overlay_cache.get(
        key
      )
    )

    if cached is not None:
      try:
        js.window.setTimeout(
          lambda:
          on_done(
            cached
          ),
          0,
        )
      except Exception:
        try:
          on_done(
            cached
          )
        except Exception:
          pass

      return

    # --------------------------------------------------
    # Same image is already being downloaded.
    #
    # Attach this request to the existing download instead
    # of creating another server call.
    # --------------------------------------------------
    existing_waiters = (
      self._overlay_async_waiters.get(
        key
      )
    )

    if existing_waiters is not None:
      existing_waiters.append(
        on_done
      )

      return

    self._overlay_async_waiters[
      key
      ] = [
        on_done
      ]

    def _finish(
      media
    ):
      if media is not None:
        self._overlay_cache[
          key
          ] = media

      waiters = (
        self._overlay_async_waiters.pop(
          key,
          [],
        )
      )

      for callback in waiters:
        try:
          callback(
            media
          )
        except Exception:
          pass

    # --------------------------------------------------
    # Preferred path: true asynchronous Anvil call.
    # --------------------------------------------------
    try:
      future = (
        self._job_server_call_async(
          "fetch_specs_image",
          job_id,
          path,
        )
      )

    except Exception:
      future = None

    if future is not None:

      def _success(
        result
      ):
        _finish(
          result
        )

      def _failure(
        error
      ):
        _finish(
          None
        )

      future.on_result(
        _success
      )

      future.on_error(
        _failure
      )

      return

    # --------------------------------------------------
    # Compatibility fallback if call_async is unavailable.
    # --------------------------------------------------
    def _sync_fallback():
      try:
        media = (
          self._job_server_call_silent(
            "fetch_specs_image",
            job_id,
            path,
          )
        )

      except Exception:
        media = None

      _finish(
        media
      )

    try:
      js.window.setTimeout(
        _sync_fallback,
        0,
      )

    except Exception:
      _sync_fallback()    

