  def _confirm_inline_panel_edit(
    self,
    designation,
  ):
    """
    Commit the temporary working copy through the existing
    rerun_rules_with_panel_edit server pathway.

    The server is called only once, after Confirm Changes.
    """
    ctx = self._panel_edit_ctx(
      designation
    )

    if (
      not ctx
      or ctx.get(
        "submitting"
      )
    ):
      return

    # No changes were made.
    if not ctx.get(
      "dirty"
    ):
      self._discard_inline_panel_edit(
        designation
      )

      return

    ctx[
      "submitting"
    ] = True

    edited = json.loads(
      json.dumps(
        ctx[
          "working"
        ]
      )
    )

    original_name = str(
      ctx.get(
        "original_name"
      )
      or designation
      or ""
    ).strip()

    source = self._norm_path(
      ctx.get(
        "source"
      )
      or ""
    )

    # --------------------------------------------------
    # Preserve stable internal panel identity.
    # --------------------------------------------------

    edited[
      "type"
    ] = "panelboard"

    edited[
      "name"
    ] = original_name

    edited[
      "original_name"
    ] = original_name

    display_name = str(
      edited.get(
        "display_name"
      )
      or ""
    ).strip()

    if (
      not display_name
      or self._norm(
        display_name
      )
      == self._norm(
        original_name
      )
    ):
      edited.pop(
        "display_name",
        None,
      )

      edited.pop(
        "name_was_edited",
        None,
      )

    attrs = edited.setdefault(
      "attrs",
      {},
    )

    # --------------------------------------------------
    # User explicitly corrected the panel.
    # Remove stale parser/problem flags.
    # --------------------------------------------------

    for key in (
      "breaker_data_suppressed",
      "breaker_suppression_reason",
      "headerValidationStatus",
      "headerValidationMissing",
    ):
      attrs.pop(
        key,
        None,
      )

    for key in (
      "panelStatus",
      "panelNote",
      "specialHeaderType",
      "_skipped",
      "reason",
    ):
      edited.pop(
        key,
        None,
      )

    try:
      job_id = str(
        (self.result or {}).get(
          "job_id"
        )
        or ""
      ).strip()

      if not job_id:
        raise ValueError(
          "Missing job id. "
          "Cannot rerun rules."
        )

      Notification(
        "Updating BOM...",
        timeout=1.5,
      ).show()

      # ------------------------------------------------
      # Admin inspection mode
      # ------------------------------------------------

      if bool(
        getattr(
          self,
          "_admin_view",
          False,
        )
      ):
        target_email = (
          self._admin_asset_owner_email()
        )

        if not target_email:
          raise ValueError(
            "Missing admin target email."
          )

        resp = (
          anvil.server.call(
            "rerun_rules_with_panel_edit",
            job_id,
            original_name,
            edited,
            source,
            target_email,
          )
          or {}
        )

      # ------------------------------------------------
      # Normal user
      # ------------------------------------------------

      else:
        resp = (
          anvil.server.call(
            "rerun_rules_with_panel_edit",
            job_id,
            original_name,
            edited,
            source,
          )
          or {}
        )

      if not resp.get(
        "ok"
      ):
        raise RuntimeError(
          resp.get(
            "error"
          )
          or (
            "Unknown rules "
            "rerun error."
          )
        )

      updated_result = (
        resp.get(
          "result"
        )
        or {}
      )

      if not updated_result:
        raise RuntimeError(
          "Rules rerun completed "
          "without an updated result."
        )

    except Exception as e:
      ctx[
        "submitting"
      ] = False

      alert(
        "Could not update BOM:\n\n"
        f"{type(e).__name__}: {e}"
      )

      return

    # --------------------------------------------------
    # Success.
    # --------------------------------------------------

    self._unlock_inline_panel_edit()

    self._panel_edit_context = None

    self._refresh_after_panel_edit(
      updated_result
    )

    Notification(
      "BOM updated",
      timeout=2,
    ).show()
  
  def _open_panel_edit_modal(self, designation):
    identity = designation if isinstance(designation, dict) else {"name": designation}
    comp = self._get_component_for_panel(identity)

    display_designation = str(
      (identity.get("display_name") if isinstance(identity, dict) else "")
      or (identity.get("name") if isinstance(identity, dict) else "")
      or (identity.get("lookup_name") if isinstance(identity, dict) else "")
      or (comp or {}).get("name")
      or designation
      or "(item)"
    ).strip()

    original_panel_name = str(
      (comp or {}).get("name") or display_designation or ""
    ).strip()

    original_source_path = ""
    if isinstance(identity, dict):
      original_source_path = self._norm_path(
        identity.get("source")
        or identity.get("raw_source")
        or identity.get("overlay_source")
        or identity.get("preview_source")
        or ""
      )

    if not original_source_path and isinstance(comp, dict):
