    attrs = (
      self._panel_quick_attrs(
        designation
      )
      or {}
    )

    raw = (
      self._panel_raw_attrs(
        designation
      )
      or {}
    )

    pb = (
      (
        (self.result or {}).get(
          "ui_overrides",
          {},
        ).get(
