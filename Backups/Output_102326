  def _extract_edit_breaker_rows_from_component(self, comp):
    attrs = (comp or {}).get("attrs") or {}
    detected = attrs.get("detected_breakers") or []

    grouped = {}

    if not isinstance(detected, list):
      return []

    for b in detected:
      if not isinstance(b, dict):
        continue

      amps = self._safe_int(b.get("amperage"))
      poles = self._safe_int(b.get("poles"))
      count = self._safe_int(b.get("count")) or 1

      if amps is None or poles is None:
        continue

      if poles not in (1, 2, 3):
        continue

      special = (
        str(
          b.get("specialFeatures")
          or b.get("special_features")
          or b.get("breakerOption")
          or b.get("breaker_option")
          or ""
        )
        .strip()
        .upper()
      )

      # Only keep options the modal currently supports.
      # Unknown old/future values are treated as Standard for now.
      if special not in ("", "GFI"):
        special = ""

      key = (amps, poles, special)

      if key not in grouped:
        grouped[key] = {
          "amperage": amps,
          "poles": poles,
          "count": 0,
          "specialFeatures": special,
        }

      grouped[key]["count"] += count

    def _sort_key(row):
      return (
        int(row.get("poles") or 999),
        int(row.get("amperage") or 999999),
        str(row.get("specialFeatures") or ""),
      )

    return sorted(grouped.values(), key=_sort_key)

  def _render_edit_breaker_rows(self, host):
    try:
      host.clear()
    except Exception:
      for c in list(host.get_components()):
        try:
          c.remove_from_parent()
        except Exception:
          pass

    if not hasattr(self, "_edit_breaker_rows"):
      self._edit_breaker_rows = []

