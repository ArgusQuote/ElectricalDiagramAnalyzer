  def _parse_amp_text(
    self, value, field_name="amps", required=False, min_amp=100, max_amp=1200
  ):
    """
    Accepts:
      100
      100a
      100A
      100 A
      100 a

    Returns int or None.
    """

    import re

    s = str(value or "").strip().upper().replace(" ", "")

    if not s:
      if required:
        raise ValueError(f"{field_name} is required.")
      return None

    m = re.match(r"^(\d{2,4})A?$", s)
    if not m:
      raise ValueError(f"{field_name} must look like 100, 100A, or 100 A.")

    amps = int(m.group(1))

    if amps < min_amp or amps > max_amp:
      raise ValueError(f"{field_name} must be between {min_amp} and {max_amp}.")

    return amps

  def _parse_breaker_count(self, value):
    try:
      count = int(str(value or "").strip())
    except Exception:
      raise ValueError("Breaker count must be a whole number.")

    if count <= 0:
      raise ValueError("Breaker count must be greater than 0.")

    if count > 200:
      raise ValueError("Breaker count looks too high.")

    return count

  def _dropdown_set_if_valid(self, dropdown, value):
