  def _fmt_panel_preview_value(self, value, suffix=""):
    if value in (None, "", "NONE", "-", "X"):
      return "-"
    return f"{value}{suffix}"

  def _panel_preview_summary_text(self, designation: str) -> str:
    """
    Uses RAW detected values so the image summary matches what the user sees on the overlay.
    """
    attrs = self._panel_raw_attrs(designation) or {}

    bus_amps = self._safe_int(attrs.get("amperage"))
    volts = attrs.get("voltage")
    main_amps = self._safe_int(attrs.get("mainBreakerAmperage"))
    spaces = self._safe_int(attrs.get("spaces"))

    parts = []

    if bus_amps is not None:
      parts.append(f"{bus_amps}A")
    else:
      parts.append("-")

    if volts not in (None, "", "NONE", "-", "X"):
      parts.append(f"{volts}V")
    else:
      parts.append("-")

    if main_amps is not None:
      parts.append(f"{main_amps}A MB")
    else:
      parts.append("-")

    if spaces is not None:
      parts.append(f"{spaces}ckt")
    else:
      parts.append("-")

    return " • ".join(parts)

  @staticmethod
  def _escape_argus_html(value):
    return (
      str(value)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
        .replace("'", "&#39;")
    )


