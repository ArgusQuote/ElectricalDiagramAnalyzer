      # ------------------------------------------------------
      # CARD STYLING
      # ------------------------------------------------------
    
      try:

        def _style_card(
          box=option_box,
          inner=content_box,
          checkbox=cb,
          helper_label=helper,
        ):
          outer_el = js.get_dom_node(box)
          inner_el = js.get_dom_node(inner)
          checkbox_el = js.get_dom_node(checkbox)
          helper_el = js.get_dom_node(helper_label)

          # Same size for every card.
