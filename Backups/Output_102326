  def _schedule_detected_overlays_scroller(self):
    """
    Defer overlay-page loading until after the main BOM interface
    has had a chance to render.

    This prevents the user from staring at a blank output page
    while every full-page overlay image is fetched.
    """
    host = getattr(self, "linear_panel_3", None)

    if not isinstance(
      host,
      (ColumnPanel, LinearPanel, FlowPanel),
    ):
      return

    # Immediately show something in the overlay area,
    # but do NOT fetch anything yet.
    try:
      host.clear()
    except Exception:
      for c in list(host.get_components()):
        try:
          c.remove_from_parent()
        except Exception:
          pass

    loading = Label(
      text=(
        "⚠  DRAWING PREVIEWS LOADING...\n\n"
        "Relevant drawing pages are loading automatically."
      ),
      align="center",
      bold=True,
      foreground="#7A4A00",
      background="#FFF3CD",
    )

    loading.font_size = CARD_FONT_SIZE + 2
    loading.height = 180

    host.add_component(loading)

    try:
      # Give Anvil/browser time to actually paint the BOM interface.
      js.window.setTimeout(
        self._render_detected_overlays_scroller,
        500,
      )
    except Exception:
      self._render_detected_overlays_scroller()

    
  def _render_detected_overlays_scroller(self):
    """
    Build the detected-page overlay scroller without blocking the
    initial BOM page render.

    Flow:
      1. Get overlay paths
      2. Build the empty scroll container
      3. Add each image afterward, one at a time

    The BOM interface is already visible before this begins.
    """
    # Hide legacy grid.
    dg = getattr(self, "data_grid_2", None)

    if isinstance(dg, DataGrid):
      try:
        dg.visible = False
      except Exception:
        pass

    host = getattr(self, "linear_panel_3", None)

    if not isinstance(
      host,
      (ColumnPanel, LinearPanel, FlowPanel),
    ):
      return

    try:
      host.width = "100%"
    except Exception:
      pass

    try:
      host.clear()
    except Exception:
      for c in list(host.get_components()):
        try:
          c.remove_from_parent()
        except Exception:
          pass

    job_id = str(
      self.result.get("job_id") or ""
    ).strip()

    if not job_id:
      host.add_component(
        Label(
          text="No job id found.",
          align="center",
          foreground="theme:White",
        )
      )
      return

    # --------------------------------------------------
    # Get overlay PATHS only.
    # No actual image media is loaded here yet.
    # --------------------------------------------------
    try:
      overlay_paths = self._job_server_call_silent(
        "list_magenta_overlay_images",
        job_id,
      ) or []

      if not overlay_paths:
        overlay_paths = self._job_server_call_silent(
          "list_overlay_images",
          job_id,
        ) or []

    except Exception:
      host.add_component(
        Label(
          text=(
            "Could not load overlay previews.\n"
            "Please refresh and try again. "
            "If this continues, contact support."
          ),
          align="center",
          foreground="theme:White",
        )
      )
      return

    # --------------------------------------------------
    # Normalize + dedupe paths.
    # --------------------------------------------------
    dedup = []
    seen = set()

    for p in overlay_paths:
      np = self._norm_path(p)

      if not np:
        continue

      key = np.lower()

      if key in seen:
        continue

      seen.add(key)
      dedup.append(np)

    overlay_paths = dedup

    # --------------------------------------------------
    # Build scroll box immediately.
    # --------------------------------------------------
    scroller = ColumnPanel(
      role="outlined-card"
    )

    scroller.width = "100%"
    scroller.spacing = "small"
    scroller.padding = "12px"
    scroller.background = "theme:Background"
    scroller.foreground = "theme:White"

    host.add_component(scroller)

    try:
      js.window.setTimeout(
        lambda:
        self._make_component_scrollable(
          scroller,
          700,
        ),
        0,
      )
    except Exception:
      self._make_component_scrollable(
        scroller,
        700,
      )

    if not overlay_paths:
      scroller.add_component(
        Label(
          text=(
            "No overlay preview images "
            "were found for this job."
          ),
          align="center",
          foreground="theme:White",
        )
      )
      return

    # Temporary status while images populate.
    loading = Label(
      text=(
        f"⚠  DRAWING PREVIEWS LOADING  "
        f"(0/{len(overlay_paths)})\n\n"
        "Relevant-page images are still being retrieved."
      ),
      align="center",
      bold=True,
      foreground="#7A4A00",
      background="#FFF3CD",
    )
    
    loading.font_size = CARD_FONT_SIZE + 2
    loading.height = 180

    scroller.add_component(loading)

    # --------------------------------------------------
    # Load Relevant Pages asynchronously, one at a time.
    #
    # Uses the SAME shared cache/waiter system as panel
    # prefetching, so duplicate image requests are avoided.
    # --------------------------------------------------
    def _load_next(index=0):
      if index >= len(
        overlay_paths
      ):
        try:
          loading.remove_from_parent()
        except Exception:
          pass

        return

      path = overlay_paths[
        index
        ]

      def _image_ready(
        media,
        index=index,
        path=path,
      ):
        if media is not None:
          try:
            tile = ColumnPanel()

            tile.width = "100%"
            tile.spacing = "none"
            tile.padding = "0"
            tile.background = "theme:Background"
            tile.foreground = "theme:White"

            img = Image(
              source=media,
              width="100%",
              height=620,
              display_mode="shrink_to_fit",
              tooltip=path,
            )

            tile.add_component(
              img
            )

            scroller.add_component(
              tile
            )

            if (
              index
              < len(overlay_paths) - 1
            ):
              scroller.add_component(
                Spacer(height=8)
              )

          except Exception:
            pass

        try:
          loading.text = (
            f"⚠  DRAWING PREVIEWS LOADING  "
            f"({index + 1}/{len(overlay_paths)})\n\n"
            "Relevant-page images are still being retrieved."
          )
        except Exception:
          pass

        # Start the next relevant-page image only after
        # this one completes.
        try:
          js.window.setTimeout(
            lambda:
            _load_next(
              index + 1
            ),
            25,
          )

        except Exception:
          _load_next(
            index + 1
          )

      self._request_overlay_image_async(
        path,
        _image_ready,
      )

    try:
      js.window.setTimeout(
        lambda:
        _load_next(0),
        50,
      )

    except Exception:
      _load_next(0)

  def _on_show(self, **e):
    """
    Let the actual Anvil form appear first.
  
    Dynamic BOM rendering begins only after the browser has
    mounted the page.
    """
    self._force_full_width_everywhere()
    self._apply_attention_state_delayed()
  
    if bool(
      getattr(
        self,
        "_initial_dynamic_render_done",
        False,
      )
    ):
      return
  
    self._initial_dynamic_render_done = True
  
    try:
      js.window.setTimeout(
        self._finish_initial_dynamic_render,
        0,
      )
    except Exception:
      self._finish_initial_dynamic_render()

  def _finish_initial_dynamic_render(self):
    """
    Build the usable output interface AFTER the form is visible.

    The current panel preview starts loading immediately.

    Relevant drawing pages also begin loading automatically,
    but only after the main BOM interface has been rendered.
    """
    self._render_non_panel_table()

    self._render()

    # Automatically begin loading Relevant Pages.
    # _schedule_detected_overlays_scroller() already waits before
    # starting image retrieval so the BOM gets painted first.
    self._schedule_detected_overlays_scroller()

    self._force_full_width_everywhere()

 
  def _wide_off(self, **e):
    # undo the "wide" mode this form enables
    try:
      js.document.body.removeAttribute("data-argus-wide")
    except Exception:
      pass

    # remove injected CSS nodes
    for attr in ("_css_wide_node", "_css_output_node"):
      try:
        n = getattr(self, attr, None)
        if n is not None:
          n.remove()
          setattr(self, attr, None)
      except Exception:
        pass

  def _add_full_width(self, parent, comp):
    """Add comp to parent, forcing full-width row when parent is a ColumnPanel."""
    try:
      if isinstance(parent, ColumnPanel):
        parent.add_component(comp, full_width_row=True)
      else:
        parent.add_component(comp)
    except TypeError:
      # fallback for containers that don't accept full_width_row kwarg
      parent.add_component(comp)

  def _apply_detection_zebra_tint(self, block, is_good: bool, zebra_role: str):
    try:
      is_grey_row = zebra_role == "zebra-even"

      GOOD_TINT_WHITE = "rgba(0, 200, 0, 0.04)"
      GOOD_TINT_GREY = "rgba(0, 200, 0, 0.10)"

      BAD_TINT_WHITE = "rgba(220, 0, 0, 0.04)"
      BAD_TINT_GREY = "rgba(220, 0, 0, 0.10)"

      tint = (
        (GOOD_TINT_GREY if is_grey_row else GOOD_TINT_WHITE)
        if is_good
        else (BAD_TINT_GREY if is_grey_row else BAD_TINT_WHITE)
      )

      el = js.get_dom_node(block)
      if el:
        el.style.boxShadow = f"inset 0 0 0 9999px {tint}"

      block.foreground = "theme:Background"
    except Exception:
      pass

