  def _open_job_click(self, sender, **e):
    # Re-check entitlement before fetching anything
    try:
      ent = anvil.server.call("is_current_user_entitled") or {}
      if not ent.get("ok"):
        alert("Your access is no longer active. Please contact your admin.")
        js.window.location.hash = "upload"
        return
    except Exception:
      js.window.location.hash = "landing"
      return
  
    try:
      tag = getattr(sender, "tag", {}) or {}
      job_id = (tag.get("job_id") or "").strip()
      job_name = (tag.get("job_name") or "").strip() or "(untitled)"
      if not job_id:
        alert("Missing job id.")
        return
  
      payload = anvil.server.call("get_job_result_for_user", job_id) or {}
      state = (payload.get("state") or "").strip().lower()
  
      if state in ("not_found", "unauthorized"):
        alert("Job not found.")
        return
  
      if state == "error":
        st = payload.get("status") or {}
        err = (st.get("error") or "").strip() or "Unknown error"
        alert(f"Job failed:\n\n{err}")
        return
  
      if state != "done":
        st = payload.get("status") or {}
        prog = st.get("progress", None)
        step = (st.get("step") or "").strip()
        elapsed = (st.get("elapsed_str") or "").strip()
  
        msg = f"Job is not ready yet.\n\nState: {state}"
        if step: msg += f"\nStep: {step}"
        if prog is not None:
          try: msg += f"\nProgress: {float(prog):.1f}%"
          except: pass
        if elapsed: msg += f"\nElapsed: {elapsed}"
        alert(msg)
        return
  
      result = payload.get("result") or {}
      self._clear_router_handoff()
      router_state.output_args = {"result": result, "job_name": job_name}
      js.window.location.hash = "output2"
      return
  
    except Exception as ex:
      alert(f"Could not open job:\n{ex}")

  # ---- your existing full-width helpers ----
  def _force_full_width_everywhere(self, **e):
    try:
      js.window.setTimeout(self._force_full_width_now, 0)
    except Exception:
      self._force_full_width_now()

  def _force_full_width_now(self):
    try:
      node = js.get_dom_node(self)
      el = node
      hops = 0
      while el is not None and hops < 50:
        try:
          s = el.style
          s.setProperty("max-width", "none", "important")
          s.setProperty("width", "100%", "important")
          s.setProperty("margin-left", "0", "important")
          s.setProperty("margin-right", "0", "important")
        except Exception:
          pass
        try:
          el = el.parentElement
        except Exception:
          el = None
        hops += 1

      for root in [js.document.documentElement, js.document.body]:
        try:
          root.style.setProperty("max-width", "none", "important")
          root.style.setProperty("width", "100%", "important")
          root.style.setProperty("margin", "0", "important")
        except Exception:
          pass

      try:
        agh = js.document.getElementById("appGoesHere")
        if agh:
          agh.style.setProperty("max-width", "none", "important")
          agh.style.setProperty("width", "100%", "important")
      except Exception:
        pass

    except Exception:
      pass

  def logout_btn_click(self, **event_args):
    try:
      js.window.sessionStorage.removeItem("upsell_jobs_shown")
    except Exception:
      pass
    
    anvil.users.logout()
    Notification("Logged out", timeout=1.5).show()
    js.window.location.hash = "landing"
    return

  def new_job_btn_click(self, **event_args):
    self._clear_router_handoff()
    js.window.location.hash = "upload"
    return

  def jobs_btn_click(self, **event_args):
    js.window.location.hash = "myjobs"
