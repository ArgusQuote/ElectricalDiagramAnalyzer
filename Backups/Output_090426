  def btn_show_raw_click(self, **event_args):
    try:
      job_id = str(self.result.get("job_id") or "").strip()
      if not job_id:
        alert("No job id found.")
        return

      # 1) Full-page magenta overlays
      magenta_paths = self._job_server_call("list_magenta_overlay_images", job_id) or []

      # 2) Individual panel/item overlays (your existing review_overlays)
      panel_paths = self._job_server_call("list_overlay_images", job_id) or []

      if not magenta_paths and not panel_paths:
        alert("No overlay images found for this job.")
        return

      # Cache
      if not hasattr(self, "_overlay_cache"):
        self._overlay_cache = {}  # (job_id, path) -> BlobMedia

      def _fetch(path: str):
        key = (job_id, path)
        media = self._overlay_cache.get(key)
        if media is None:
          media = self._job_server_call("fetch_specs_image", job_id, path)
          self._overlay_cache[key] = media
        return media

      def _tile(path: str, w: int, h: int):
        media = _fetch(path)
        tile = ColumnPanel(width=w)
        img = Image(
          source=media,
          width="100%",
          height=h,
          display_mode="shrink_to_fit",
          tooltip=path,
        )
        tile.add_component(img)
        return tile

      SECTION_HEADER_SIZE = 32

      def _section_label(text: str):
        lab = Label(text=text, bold=True)
        lab.font_size = SECTION_HEADER_SIZE
        return lab

      content = ColumnPanel(spacing="medium")
      content.width = "100%"

      # --- Full overlays on top ---
      if magenta_paths:
        content.add_component(_section_label("Full Overlay Images"))
        mag_grid = FlowPanel(spacing="large", align="center")
        for p in magenta_paths:
          mag_grid.add_component(_tile(p, w=1000, h=800))
        content.add_component(mag_grid)

      # Split overlay images into good panels vs non-panel/problem items
      good_panel_paths = []
      non_panel_paths = []

      for p in panel_paths:
        if self._is_good_panel_overlay(p):
          good_panel_paths.append(p)
        else:
          non_panel_paths.append(p)

      # --- Good individual panels ---
      if good_panel_paths:
        content.add_component(_section_label("Individual Panels"))
        panel_grid = FlowPanel(spacing="large", align="center")

        for p in good_panel_paths:
          panel_grid.add_component(self._panel_summary_tile(p, w=800, h=600))

        content.add_component(panel_grid)

      # --- Bad / non-panel items ---
      if non_panel_paths:
        content.add_component(_section_label("Non-Panel Items and Problem Panels"))
        bad_grid = FlowPanel(spacing="large", align="center")

        for p in non_panel_paths:
          bad_grid.add_component(self._image_only_tile(p, w=800, h=600))

        content.add_component(bad_grid)

      alert(content, title="Detected Items", large=True, buttons=[("Close", True)])

    except Exception as e:
      alert(f"Could not load detected items:\n{e}")

  def _clear_router_handoff(self):
    try:
      router_state.processing_args = None
    except Exception:
      pass
    try:
      router_state.output_args = None
    except Exception:
      pass

  def _apply_admin_output_chrome(self):
    """
    Admin-inspection output mode:
    remove the normal top nav/action buttons and replace them with one Back button.
    """
    # Hide the named buttons even if they are not inside flow_panel_1.
    for name in (
      "new_job_btn_copy",
      "jobs_btn",
      "logout_btn",
      "new_job_btn",
      "feedback_btn",
    ):
      try:
        comp = getattr(self, name, None)
        if comp is not None:
          comp.visible = False
      except Exception:
        pass

    host = getattr(self, "flow_panel_1", None)
    if not isinstance(host, (FlowPanel, LinearPanel, ColumnPanel)):
      return

    try:
      host.clear()
    except Exception:
      for c in list(host.get_components()):
        try:
          c.remove_from_parent()
        except Exception:
          pass

    back_btn = Button(
      text="Back",
      background="theme:Accent",
      foreground="theme:White",
      role="elevated-button",
    )
    back_btn.font_size = 20
    back_btn.set_event_handler("click", self._admin_back_click)

    host.add_component(back_btn)
    self.admin_back_btn = back_btn

    download_btn = getattr(self, "download_btn", None)
    if download_btn is not None:
      try:
        download_btn.visible = True
        download_btn.enabled = True
        download_btn.text = "Download CSV"
        download_btn.background = "theme:Accent"
        download_btn.foreground = "theme:White"
        download_btn.role = "elevated-button"
        download_btn.font_size = 20
      except Exception:
        pass

      export_h = getattr(self, "_export_csv", None)
      if export_h is not None:
        download_btn.set_event_handler("click", lambda **e: export_h())

      try:
        host.add_component(download_btn)
      except Exception:
        pass

  def _admin_back_click(self, sender=None, **event_args):
    try:
      if self._admin_expanded_user_email:
        js.window.sessionStorage.setItem(
          "admin_expanded_user_email", self._admin_expanded_user_email
        )
      elif self._admin_target_email:
        js.window.sessionStorage.setItem(
          "admin_expanded_user_email", self._admin_target_email.lower()
        )
    except Exception:
      pass

    self._clear_router_handoff()
    js.window.location.hash = self._admin_back_hash or "accountmanagement"
    return

