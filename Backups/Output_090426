  # ---------- Card helpers ----------
  def _panel_source(self, designation: str):
    """Return (source_path, display_name) for this designation, or (None, name)."""
    des_n = self._norm(designation)
    for row in self._extract_panels() or []:
      if self._norm(row.get("name")) == des_n:
        return str(row.get("source") or "").strip(), str(row.get("name") or "").strip()
    return None, designation

  def _component_display_name(self, comp: dict, fallback: str = "") -> str:
    """
    User-facing panel name.

    Keeps comp['name'] as the stable/internal lookup key, but allows
    comp['display_name'] to show the user's corrected name.
    """
    if not isinstance(comp, dict):
      return str(fallback or "").strip()

    internal = str(
      comp.get("original_name") or comp.get("name") or fallback or ""
    ).strip()

    display = str(comp.get("display_name") or "").strip()

    if display and self._norm(display) != self._norm(internal):
      return f"{display} (edited)"

    return internal or str(fallback or "").strip()

  def _panel_display_name(self, designation: str) -> str:
    comp = self._get_component_for_panel(designation)
    return self._component_display_name(comp, designation)

  def _component_csv_name(self, comp: dict, fallback: str = "") -> str:
    """
    CSV-facing panel name.

    Unlike _component_display_name(), this does NOT append '(edited)'.
    If the user renamed Panel A to H, CSV should show H.
    """
    if not isinstance(comp, dict):
      return str(fallback or "").strip()

    internal = str(
      comp.get("original_name") or comp.get("name") or fallback or ""
    ).strip()

    display = str(comp.get("display_name") or "").strip()

    if display and self._norm(display) != self._norm(internal):
      return display

    return internal or str(fallback or "").strip()

  def _panel_csv_name(self, designation: str) -> str:
    comp = self._get_component_for_panel(designation)
    return self._component_csv_name(comp, designation)

  def _panel_meta(self, designation: str) -> dict:
    des_n = self._norm(designation)
    for row in self._extract_panels() or []:
      if self._norm(row.get("name")) == des_n:
        return {
          "panel_status": str(row.get("panel_status") or "").strip(),
          "panel_note": str(row.get("panel_note") or "").strip(),
          "special_header_type": row.get("special_header_type"),
        }
    return {}

  def _panel_quick_attrs(self, designation: str) -> dict:
    """Return quick attributes for a designation, preferring final built values over raw detected attrs."""
    amap = self._panel_attrs_map() or {}
    a = dict(amap.get(self._norm(designation), {}) or {})

    rules = (self.result or {}).get("rules_result") or {}
    payload = rules.get(designation) or {}

    final_amperage = payload.get("_finalPanelAmperage")
    final_voltage = payload.get("_finalPanelVoltage")
    final_int_rating = payload.get("_finalPanelIntRating")
    final_spaces = payload.get("_finalPanelSpaces")
    final_main_breaker_amperage = payload.get("_finalMainBreakerAmperage")

    if final_amperage not in (None, "", "NONE"):
      a["amperage"] = final_amperage
    if final_voltage not in (None, "", "NONE"):
      a["voltage"] = final_voltage
    if final_int_rating not in (None, "", "NONE"):
      a["intRating"] = final_int_rating
    if final_spaces not in (None, "", "NONE"):
      a["spaces"] = final_spaces
    if final_main_breaker_amperage not in (None, "", "NONE"):
      a["mainBreakerAmperage"] = final_main_breaker_amperage

    # Try to backfill from the top-panel table rows if attrs still empty
    if not a:
      for row in self._extract_panels() or []:
        if self._norm(row.get("name")) == self._norm(designation):
          a = {
            "amperage": row.get("amperage"),
            "voltage": row.get("voltage"),
            "intRating": row.get("int_rating"),
            "spaces": row.get("spaces"),
            "mainBreakerAmperage": row.get("main_brk_amps"),
          }
          break

    return a

  def _panel_raw_attrs(self, designation: str) -> dict:
    """
    Return raw detected attrs only.
    Do NOT apply final/bumped rules_result values.
    """
    amap = self._panel_attrs_map() or {}
    a = dict(amap.get(self._norm(designation), {}) or {})

    # Backfill from extracted panel rows only if attrs are still empty
    if not a:
      for row in self._extract_panels() or []:
        if self._norm(row.get("name")) == self._norm(designation):
          a = {
            "amperage": row.get("amperage"),
            "voltage": row.get("voltage"),
            "intRating": row.get("int_rating"),
            "spaces": row.get("spaces"),
            "mainBreakerAmperage": row.get("main_brk_amps"),
          }
          break

    return a

  def _fmt_attr_chip(self, label: str, value) -> Component:
