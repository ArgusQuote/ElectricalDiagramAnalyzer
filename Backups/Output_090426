  def _panel_missing_keys(self, attrs: dict) -> list[str]:
    """
    Keys we consider 'required' to confidently build panel output.
    You can tune this later.
    """

    def _missing(v):
      if v is None:
        return True
      s = str(v).strip().upper()
      return s == "" or s == "NONE" or s == "X" or s == "-"

    missing = []
    # bus amps + spaces are the big ones, voltage/int rating helpful
    if _missing(attrs.get("amperage")):
      missing.append("bus amps")
    if _missing(attrs.get("spaces")):
      missing.append("spaces")
    if _missing(attrs.get("voltage")):
      missing.append("voltage")
    return missing

  def _panel_has_any_bom(self, rules_payload: dict) -> bool:
    if not isinstance(rules_payload, dict) or not rules_payload:
      return False
    # any of these signals means “something real got built”
    for k in (
      "Interior",
      "Interior/Box",
      "Box",
      "Trim",
      "Cover",
      "Main Breaker",
      "Main Breaker Kit",
      "Ground Bar Kit",
      "Neutral",
      "Neutral (100%)",
      "Neutral (200%)",
      "Feed-Thru Lugs",
      "SPD",
      "Service Entrance Kit",
      "Service Entrance Barrier Kit",
    ):
      v = rules_payload.get(k)
      if isinstance(v, str) and v.strip() and "not suitable" not in v.lower():
        return True

    # branch breakers
    for k, v in rules_payload.items():
      if k.startswith("Branch Breakers") and isinstance(v, list) and len(v) > 0:
        return True

    # blanks/filler
    fp = rules_payload.get("Filler Plates")
    if isinstance(fp, dict) and (fp.get("Part Number") or ""):
      return True
    bl = rules_payload.get("I-LINE Blanks & Extensions")
    if (
      isinstance(bl, dict)
      and isinstance(bl.get("Items"), list)
      and len(bl.get("Items")) > 0
    ):
      return True

    return False

  def _panel_has_breakers(self, rules_payload: dict) -> bool:
    if not isinstance(rules_payload, dict):
      return False
    for k, v in rules_payload.items():
      if k.startswith("Branch Breakers") and isinstance(v, list) and len(v) > 0:
        return True
    return False

  def _force_datagrid_table_full_width(self, dg: DataGrid):
    try:
      root = js.get_dom_node(dg)
      if not root:
        return

      # Anvil DataGrid structure has wrapper(s); table is usually inside
      tbl = root.querySelector("table")
      if tbl:
        tbl.style.setProperty("width", "100%", "important")
        tbl.style.setProperty("max-width", "none", "important")
        tbl.style.setProperty("table-layout", "fixed", "important")  # makes it stretch

      # Also force wrappers (sometimes they are inline-ish)
      wrap = root.querySelector(".anvil-data-grid-wrapper")
      if wrap:
        wrap.style.setProperty("width", "100%", "important")
        wrap.style.setProperty("max-width", "none", "important")
        wrap.style.setProperty("display", "block", "important")

      root.style.setProperty("width", "100%", "important")
      root.style.setProperty("max-width", "none", "important")
      root.style.setProperty("display", "block", "important")

    except Exception:
      pass

  def _is_problem_status(self, status: str) -> bool:
    s = (status or "").strip().lower()
    return (
      s.startswith("system error")
      or s.startswith("no output - confidence low/not currently supported style")
      or s.startswith("detected but skipped")
    )

  def _is_good_status_for_linear3(self, status: str) -> bool:
    s = (status or "").strip().lower()
    # Keep only usable panel outputs here
    return s.startswith("bom fully generated") or s.startswith(
      "bom partially generated"
    )

  def _is_recoverable_problem_component(
    self, comp: dict, status: str = "", note: str = ""
  ) -> bool:
    """
    Decide whether a problem row should show the Edit button.

    Primary source of truth:
      - panelStatus / status
      - panelNote / note
      - reason

    Goal:
      - Missing/correctable panel data => editable
      - Known non-panel / other equipment / unsupported schedule => view-only
    """
    if not isinstance(comp, dict):
      return False

    if str(comp.get("type") or "").strip().lower() != "panelboard":
      return False

    attrs = comp.get("attrs") or {}
    if not isinstance(attrs, dict):
      attrs = {}

    panel_status = str(comp.get("panelStatus") or status or "").strip()
    panel_note = str(comp.get("panelNote") or note or "").strip()
    reason = str(comp.get("reason") or "").strip()

    status_l = panel_status.lower()
    note_l = panel_note.lower()
    reason_l = reason.lower()

    combined = " ".join([status_l, note_l, reason_l]).strip()

    # 1) Known non-panel / wrong-object classifications.
    # These should stay view-only.
    non_recoverable_notes = (
      "lighting schedule",
      "light fixture schedule",
      "fixture schedule",
      "luminaire schedule",
      "inverter",
      "ups",
      "generator",
      "ats",
      "automatic transfer switch",
      "transfer switch",
      "transformer",
      "disconnect",
      "wireway",
      "wireway schedule",
      "gutter",
      "auxiliary gutter",
      "junction box",
      "pull box",
      "switchboard",
      "switchgear",
      "mcc",
      "motor control center",
      "mechanical equipment",
      "equipment schedule",
      "panel legend",
      "symbol legend",
      "general notes",
      "sheet notes",
      "keyed notes",
      "abbreviations",
      "not a panel",
      "non-panel",
      "unsupported schedule",
    )

    if any(t in combined for t in non_recoverable_notes):
      return False

    # 2) Correctable missing panel data.
    # These should be editable.
    recoverable_notes = (
      "missing",
      "not found",
      "no main",
      "main amperage",
      "main amps",
      "main breaker",
      "no bus",
      "bus amperage",
      "no voltage",
      "no spaces",
      "spaces not found",
      "amperage not found",
      "interrupting rating",
      "kaic",
    )

    if any(t in combined for t in recoverable_notes):
      return True

    # 3) Missing required attrs from the actual component.
    # Keep this as backup for cases where note text is sparse.
    if self._panel_missing_keys(attrs):
      return True

    # 4) Generic unsupported / low confidence should stay view-only unless
    # the note above specifically said it was missing correctable panel info.
    if (
      "not currently supported style" in combined
      or "confidence low" in combined
      or "unsupported style" in combined
    ):
      return False

    # 5) Detected/skipped panelboard with no known non-panel note:
    # allow recovery, because user can inspect and fix it.
    if status_l.startswith("detected but skipped"):
      return True

    return False

  def _extract_problem_items_for_linear4(self) -> list[dict]:
    """
    Build list of problem/non-panel rows for linear_panel_4.

    Sources:
      1) Explicit non_panelboard_items payload
      2) Panel components whose status is one of:
        - System error
        - No output - confidence low/not currently supported style
        - Detected but skipped

    IMPORTANT:
    Prevent generic non-panel rows from duplicating panel-derived problem rows.
    Match using both full normalized path and basename.
    """
    out = []

    panels = self._extract_panels() or []

    # Build strong panel source identity sets
    panel_sources_full = set()
    panel_sources_base = set()

    for p in panels:
      src = self._norm_path(p.get("source"))
      raw_src = self._norm_path(p.get("raw_source"))
      overlay_src = self._norm_path(p.get("overlay_source"))

      for s in (src, raw_src, overlay_src):
        if not s:
          continue
        panel_sources_full.add(s.lower())
        panel_sources_base.add(s.split("/")[-1].strip().lower())

    # A) explicit non-panel payload
    for r in self._extract_non_panel_items() or []:
      src = self._norm_path(r.get("source"))
      if not src:
        continue

      src_full = src.lower()
      src_base = src.split("/")[-1].strip().lower()

      # Skip if this item already corresponds to a panel detection
      if src_full in panel_sources_full or src_base in panel_sources_base:
        continue

      out.append(
        {
          "source": src,
          "name": "Non-panel item",
          "status": "Detected item",
          "note": "",
          "can_edit": False,
        }
      )

    # B) panel-derived problem items
    for p in panels:
      name = str(p.get("name") or "(unnamed)").strip()
      src = self._norm_path(
        p.get("source") or p.get("overlay_source") or p.get("raw_source")
      )

      status, note = self._panel_status(name)

      if self._is_problem_status(status):
        comp = (
          self._get_component_for_panel(
            {
              "name": name,
              "source": src,
              "raw_source": p.get("raw_source") or "",
              "overlay_source": p.get("overlay_source") or "",
            }
          )
          or {}
        )

        can_edit = self._is_recoverable_problem_component(comp, status, note)

        out.append(
          {
            "source": src,
            "name": name,
            "status": status,
            "note": note or "",
            "can_edit": can_edit,
          }
        )

    # Final dedupe
    seen = set()
    dedup = []

    for r in out:
      s = self._norm_path(r.get("source"))
      base = s.split("/")[-1].strip().lower() if s else ""
      key = (
        base,
        s.lower(),
        str(r.get("status") or "").strip().lower(),
        str(r.get("name") or "").strip().lower(),
      )
      if key in seen:
        continue
      seen.add(key)
      dedup.append(
        {
          "source": s,
          "name": r.get("name") or "(item)",
          "status": r.get("status") or "",
          "note": r.get("note") or "",
          "can_edit": bool(r.get("can_edit")),
        }
      )

    return dedup

