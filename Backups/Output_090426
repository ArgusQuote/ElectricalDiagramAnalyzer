  def _extract_edit_breaker_rows_from_component(self, comp):
    attrs = (comp or {}).get("attrs") or {}
    detected = attrs.get("detected_breakers") or []

    grouped = {}

    if not isinstance(detected, list):
      return []

    for b in detected:
      if not isinstance(b, dict):
        continue

      amps = self._safe_int(b.get("amperage"))
      poles = self._safe_int(b.get("poles"))
      count = self._safe_int(b.get("count")) or 1

      if amps is None or poles is None:
        continue

      if poles not in (1, 2, 3):
        continue

      special = (
        str(
          b.get("specialFeatures")
          or b.get("special_features")
          or b.get("breakerOption")
          or b.get("breaker_option")
          or ""
        )
        .strip()
        .upper()
      )

      # Only keep options the modal currently supports.
      # Unknown old/future values are treated as Standard for now.
      if special not in ("", "GFI"):
        special = ""

      key = (amps, poles, special)

      if key not in grouped:
        grouped[key] = {
          "amperage": amps,
          "poles": poles,
          "count": 0,
          "specialFeatures": special,
        }

      grouped[key]["count"] += count

    def _sort_key(row):
      return (
        int(row.get("poles") or 999),
        int(row.get("amperage") or 999999),
        str(row.get("specialFeatures") or ""),
      )

    return sorted(grouped.values(), key=_sort_key)

  def _render_edit_breaker_rows(self, host):
    try:
      host.clear()
    except Exception:
      for c in list(host.get_components()):
        try:
          c.remove_from_parent()
        except Exception:
          pass

    if not hasattr(self, "_edit_breaker_rows"):
      self._edit_breaker_rows = []

    header = GridPanel()
    header.width = "100%"
    header.add_component(Label(text="Amps", bold=True), row="A", col_xs=0, width_xs=2)
    header.add_component(Label(text="Poles", bold=True), row="A", col_xs=2, width_xs=2)
    header.add_component(Label(text="Count", bold=True), row="A", col_xs=4, width_xs=2)
    header.add_component(Label(text="Option", bold=True), row="A", col_xs=6, width_xs=3)
    header.add_component(Label(text="", bold=True), row="A", col_xs=9, width_xs=3)
    host.add_component(header)

    for idx, row_data in enumerate(self._edit_breaker_rows):
      row = GridPanel()
      row.width = "100%"

      dd_amps = DropDown(items=self._breaker_amp_items())
      self._dropdown_set_if_valid(dd_amps, row_data.get("amperage"))

      dd_poles = DropDown(items=[("1P", 1), ("2P", 2), ("3P", 3)])
      self._dropdown_set_if_valid(dd_poles, row_data.get("poles"))

      tb_count = TextBox(text=str(row_data.get("count") or 1))
      tb_count.placeholder = "Count"

      dd_option = DropDown(items=self._breaker_option_items())
      self._dropdown_set_if_valid(
        dd_option, str(row_data.get("specialFeatures") or "").strip().upper()
      )

      btn_remove = Button(
        text="Remove", foreground="#C0392B", background="transparent", bold=True
      )

      dd_amps.tag = idx
      dd_poles.tag = idx
      tb_count.tag = idx
      btn_remove.tag = idx
      dd_option.tag = idx

      def _amps_changed(sender, **e):
        i = int(sender.tag)
        self._edit_breaker_rows[i]["amperage"] = sender.selected_value

      def _poles_changed(sender, **e):
        i = int(sender.tag)
        self._edit_breaker_rows[i]["poles"] = sender.selected_value

      def _count_changed(sender, **e):
        i = int(sender.tag)
        self._edit_breaker_rows[i]["count"] = sender.text

      def _option_changed(sender, **e):
        i = int(sender.tag)
        self._edit_breaker_rows[i]["specialFeatures"] = sender.selected_value or ""

      def _remove_clicked(sender, **e):
        i = int(sender.tag)
        if 0 <= i < len(self._edit_breaker_rows):
          self._edit_breaker_rows.pop(i)
        self._render_edit_breaker_rows(host)

      dd_amps.set_event_handler("change", _amps_changed)
      dd_poles.set_event_handler("change", _poles_changed)
      tb_count.set_event_handler("change", _count_changed)
      dd_option.set_event_handler("change", _option_changed)
      btn_remove.set_event_handler("click", _remove_clicked)

      row.add_component(dd_amps, row="A", col_xs=0, width_xs=2)
      row.add_component(dd_poles, row="A", col_xs=2, width_xs=2)
      row.add_component(tb_count, row="A", col_xs=4, width_xs=2)
      row.add_component(dd_option, row="A", col_xs=6, width_xs=3)
      row.add_component(btn_remove, row="A", col_xs=9, width_xs=3)

      host.add_component(row)

    btn_add = Button(
      text="+ Add another breaker",
      foreground="#117BC3",
      background="transparent",
      bold=True,
    )

    def _add_clicked(sender, **e):
      self._edit_breaker_rows.append(
        {
          "amperage": 20,
          "poles": 1,
          "count": 1,
          "specialFeatures": "",
        }
      )
      self._render_edit_breaker_rows(host)

    btn_add.set_event_handler("click", _add_clicked)
    host.add_component(btn_add)

  def _collect_edit_breaker_rows(self):
    out = []

    for row in getattr(self, "_edit_breaker_rows", []) or []:
      amps = row.get("amperage")
      poles = row.get("poles")
      count = row.get("count")

      try:
        amps = int(amps)
        poles = int(poles)
        count = self._parse_breaker_count(count)
      except Exception as e:
        raise ValueError(f"Invalid breaker row: {e}")

      if poles not in (1, 2, 3):
        raise ValueError("Breaker poles must be 1, 2, or 3.")

      if amps < 15 or amps > 1200:
        raise ValueError("Breaker amps must be between 15 and 1200.")

      special = str(row.get("specialFeatures") or "").strip().upper()

      valid_specials = {"", "GFI"}
      if special not in valid_specials:
        raise ValueError(f"Unsupported breaker option: {special}")

      out.append(
        {
          "poles": poles,
          "amperage": amps,
          "count": count,
          "specialFeatures": special,
        }
      )

    return out

