  def _get_component_for_panel(self, designation):
    """
    Find a panelboard component by name or by source path.

    Normal BOM-card edits pass a plain panel name.
    Problem-panel edits pass a small identity dict so duplicate/weak names
    like UNKNOWN still resolve to the exact detected item the user clicked.
    """
    if isinstance(designation, dict):
      target_name = self._norm(
        designation.get("name")
        or designation.get("lookup_name")
        or designation.get("display_name")
        or ""
      )
      target_source = self._norm_path(
        designation.get("source")
        or designation.get("raw_source")
        or designation.get("overlay_source")
        or designation.get("preview_source")
        or ""
      )
    else:
      target_name = self._norm(designation)
      target_source = ""

    target_source_l = target_source.lower()
    target_base_l = target_source_l.split("/")[-1] if target_source_l else ""

    comps = (self.result or {}).get("components") or []

    # Prefer source matching when available.
    if target_source_l:
      for c in comps:
        if not isinstance(c, dict):
          continue
        if (c.get("type") or "").lower() != "panelboard":
          continue

        candidates = [
          c.get("source"),
          c.get("overlay_source"),
          c.get("overlaySource"),
          c.get("preview_source"),
          c.get("previewSource"),
          c.get("reviewOverlayPath"),
          c.get("review_overlay_path"),
        ]

        for cand in candidates:
          cand_n = self._norm_path(cand).lower()
          if not cand_n:
            continue
          cand_base = cand_n.split("/")[-1]
          if cand_n == target_source_l or (
            target_base_l and cand_base == target_base_l
          ):
            return c

    # Fall back to name matching for normal panel edits.
    if target_name:
      for c in comps:
        if not isinstance(c, dict):
          continue
        if (c.get("type") or "").lower() != "panelboard":
          continue
        if self._norm(c.get("name")) == target_name:
          return c

    return None

