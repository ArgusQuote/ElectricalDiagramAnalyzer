  # ---------- Normalization ----------
  def _normalize_rules(self, rules_result: dict) -> dict:
    """
    Return { designation -> [ {designation,item_type,product,qty,notes,_order,csv_*}, ... ] }
    Enforces order: Interior → Box → Trim/Cover → Main (breaker/kit) → Accessories → Breakers → Blanks/Filler → Notes
    """
    ORDER = {
      "Box": 10,
      "Trim": 20,
      "Cover": 20,
      "Trim/Cover": 20,
      "Interior": 30,
      "Interior/Box": 30,
      "Main": 40,
      "Accessory": 50,
      "MMS/ERMS": 55,
      "Breaker": 60,
      "Blanks/Filler": 70,
      "Note": 90,
    }

    rows_by_des = {}
    for designation, payload in (rules_result or {}).items():
      designation = str(designation or "").strip()
      if not isinstance(payload, dict):
        continue
      out_rows = []

      def add_row(des, item_type, product, qty, notes, order, force_unselectable=False):
        r = self._row(des, item_type, product, qty, notes, order)

        if force_unselectable:
          r["csv_selectable"] = False
          r["csv_include"] = False
          out_rows.append(r)
          return

        # NQ/NF copper equipment ground-bar upgrade.
        # The aluminum ground bar is already included with the interior,
        # so the separate PK27GTACU accessory must start unchecked.
        is_optional_copper_ground_bar = (
          item_type == "Ground Bar Kit"
          and str(product or "").strip().upper() == "PK27GTACU"
        )

        if is_optional_copper_ground_bar:
          r["csv_selectable"] = True
          r["csv_include"] = False

        elif item_type in ALWAYS_INCLUDE:
          r["csv_selectable"] = True
          r["csv_include"] = True

        elif item_type in OPTIONAL_DEFAULT_ON:
          r["csv_selectable"] = True
          r["csv_include"] = True

        elif item_type in OPTIONAL_DEFAULT_OFF:
          r["csv_selectable"] = True
          r["csv_include"] = False

        else:
          r["csv_selectable"] = False
          r["csv_include"] = False

        out_rows.append(r)

      # 1) Interior / Box / Trim/Cover
      if isinstance(payload.get("Interior"), str):
        add_row(designation, "Interior", payload["Interior"], 1, "", ORDER["Interior"])
      if isinstance(payload.get("Interior/Box"), str):
        add_row(
          designation,
          "Interior/Box",
          payload["Interior/Box"],
          1,
          "",
          ORDER["Interior/Box"],
        )
      if isinstance(payload.get("Box"), str):
        add_row(designation, "Box", payload["Box"], 1, "", ORDER["Box"])
      if isinstance(payload.get("Trim"), str):
        add_row(designation, "Trim", payload["Trim"], 1, "", ORDER["Trim"])
      if isinstance(payload.get("Cover"), str):
        add_row(designation, "Cover", payload["Cover"], 1, "", ORDER["Cover"])

      # 1.5) Main breaker items (pre-checked, selectable)
      mb = payload.get("Main Breaker")
      if isinstance(mb, str) and mb.strip():
        add_row(designation, "Main Breaker", mb.strip(), 1, "", ORDER["Main"])
      mbk = payload.get("Main Breaker Kit")
      if isinstance(mbk, str) and mbk.strip():
        add_row(designation, "Main Breaker Kit", mbk.strip(), 1, "", ORDER["Main"])

      def _is_unavailable_message(s: str) -> bool:
        t = (s or "").strip().lower()
        return (
          "no ground bar kit available" in t
          or ("no " in t and " available" in t)
          or t.endswith("available for this configuration.")
        )

      # Service-entrance suppression: block if any “not suitable” note appears
      def _has_not_suitable(txt):
        return isinstance(txt, str) and ("not suitable" in txt.lower())

      se_note_block = _has_not_suitable(payload.get("Service Entrance Note"))
      se_kit_text = payload.get("Service Entrance Kit")
      se_kit_is_note = _has_not_suitable(se_kit_text)
      notes_list = (
        payload.get("Notes") if isinstance(payload.get("Notes"), list) else []
      )
      notes_block = any(_has_not_suitable(n) for n in notes_list)
      se_blocked = se_note_block or se_kit_is_note or notes_block

      # 2) Accessories (use the actual label)
      def add_acc(label_key, pretty_label=None, when=True):
        if not when:
          return
        val = payload.get(label_key)
        if not (isinstance(val, str) and val.strip()):
          return

        txt = val.strip()
        low = txt.lower()

        # Keep your existing suppression for "not suitable" (still don’t add as accessory)
        if "not suitable" in low:
          return

        label = pretty_label or label_key

        # If it’s the "not available" message, show it as a row but make it non-selectable
        if label == "Ground Bar Kit" and _is_unavailable_message(txt):
          add_row(
            designation, label, txt, 0, "", ORDER["Accessory"], force_unselectable=True
          )
          return

        # Normal accessory row
        add_row(designation, label, txt, 1, "", ORDER["Accessory"])

      add_acc("Ground Bar Kit", "Ground Bar Kit")
      add_acc("Neutral", "Neutral")
      add_acc("Neutral (100%)", "Neutral (100%)")
      add_acc("Neutral (200%)", "Neutral (200%)")
      add_acc("Feed-Thru Lugs", "Feed-Thru Lugs")
      add_acc("SPD", "SPD")
      add_acc("Service Entrance Kit", "Service Entrance Kit", when=not se_blocked)
      add_acc(
        "Service Entrance Barrier Kit",
        "Service Entrance Barrier Kit",
        when=not se_blocked,
      )

      # 3) Breakers
      for key, val in payload.items():
        if isinstance(val, list) and key.startswith("Branch Breakers"):
          for b in val:
            if not isinstance(b, dict):
              continue
            pn = b.get("Part Number") or b.get("part_number") or ""
            qty = int(b.get("count", 1) or 1)
            ir = b.get("Interrupting Rating") or b.get("interrupting_rating") or ""
            note = f"IR: {ir}" if ir else ""
            add_row(designation, "Breaker", pn, qty, note, ORDER["Breaker"])

      # 4) Blanks / Filler
      blanks = payload.get("I-LINE Blanks & Extensions")
      if isinstance(blanks, dict) and isinstance(blanks.get("Items"), list):
        for it in blanks["Items"]:
          pn = (it or {}).get("Part Number") or ""
          qty = int((it or {}).get("Quantity", 1) or 1)
          add_row(designation, "Blanks/Filler", pn, qty, "", ORDER["Blanks/Filler"])
      fp = payload.get("Filler Plates")
      if isinstance(fp, dict):
        pn = fp.get("Part Number") or ""
        qty = int(fp.get("Quantity", 1) or 1)
        covers = fp.get("Covers")
        note = f"Covers: {covers}" if covers else ""
        if pn:
          add_row(designation, "Blanks/Filler", pn, qty, note, ORDER["Blanks/Filler"])

      # MMS / ERMS
      mms = payload.get("I-LINE MMS / ERMS")
      if isinstance(mms, dict):
        pn = mms.get("Part Number") or ""
        if pn:
          side = mms.get("Side") or ""
          width = mms.get("Width") or ""
          bus_space = mms.get("Bus Space Required") or ""

          notes = []
          if side:
            notes.append(f"Side: {side}")
          if width:
            notes.append(f"Width: {width}")
          if bus_space:
            notes.append(f"Bus space: {bus_space} in")

          add_row(designation, "MMS/ERMS", pn, 1, " | ".join(notes), ORDER["MMS/ERMS"])

      # 5) Notes
      def add_note(label_key):
        txt = payload.get(label_key)
        if isinstance(txt, str) and txt.strip():
          add_row(designation, "Note", txt.strip(), 0, label_key, ORDER["Note"])

      add_note("Note")
      add_note("Ground Bar Note")
      add_note("Service Entrance Note")
      sek = payload.get("Service Entrance Kit")
      if isinstance(sek, str) and "not suitable" in sek.lower():
        add_row(designation, "Note", sek.strip(), 0, "Service Entrance", ORDER["Note"])

      # 6) Skipped payloads
      skipped = payload.get("Skipped")
      if isinstance(skipped, str) and skipped.strip():
        add_row(designation, "Skipped", skipped.strip(), 0, "", ORDER["Note"])

      # 7) Notes list
      notes_list = payload.get("Notes")
      if isinstance(notes_list, list):
        for n in notes_list:
          if isinstance(n, str) and n.strip():
            add_row(designation, "Note", n.strip(), 0, "", ORDER["Note"])

      if out_rows:
        rows_by_des[designation] = out_rows

    return rows_by_des

  def _row(self, designation, item_type, product, qty, notes, order):
    designation_s = str(designation or "").strip()
    item_type_s = str(item_type or "").strip()
    product_s = "" if product is None else str(product)
    notes_s = "" if notes is None else str(notes)
    return {
      "designation": designation_s,
      "item_type": item_type_s,
      "product": product_s,
      "qty": int(qty or 0),
      "notes": notes_s,
      "_order": order,
      # csv flags are added by caller in _normalize_rules
    }

  # -------- CSV export ----------
  def _export_csv(self):
    """
    Export CSV with headers: Product,Designation,Quantity
    Include only rows where csv_include is True.
    """
    try:
      rows = self._flat_rows or []
      lines = ["Product,Designation,Quantity"]

      for r in rows:
        itype = str(r.get("item_type") or "").strip()

        if itype in ("Note", "Skipped"):
          continue

        if not bool(r.get("csv_include", False)):
          continue

        prod = str(r.get("product") or "").strip()

        csv_des = self._panel_csv_name(r.get("designation"))
        des = str(csv_des or r.get("designation") or "").strip()

        qty = str(r.get("qty", 0))

        lines.append(f"{prod},{des},{qty}")

      csv_bytes = ("\r\n".join(lines)).encode("utf-8")

      media = BlobMedia(
        "text/csv",
        csv_bytes,
        name=f"CSV ({self.job_name or 'Untitled'}) BOM.csv"
      )

      download(media)

    except Exception as ex:
      alert(f"Could not export CSV:\n{ex}")

  def _download_and_feedback_click(self, **event_args):
    """
    Warn if not every BOM panel has been approved, then download CSV.

    If feedback has not already been submitted during this page session,
    ask for feedback after the download.
    """
    total_panels = len(self._review_cards)

    approved_count = sum(
      1
      for designation, _rows in self._review_cards
      if self._norm(designation) in self._approved_panels
    )

    # Warn, but do not hard-block download.
    if total_panels > 0 and approved_count < total_panels:
      remaining = total_panels - approved_count

      proceed = confirm(
        (
          "Not all panels have been approved.\n\n"
          f"{remaining} of {total_panels} panels still need approval. "
          "Do you want to download the CSV anyway?"
        ),
        buttons=[
          ("Continue Download", True),
          ("Go Back", False),
        ],
      )

      if not proceed:
        return

    try:
      self._export_csv()
    except Exception as ex:
      alert(f"Could not export CSV:\n{ex}")
      return

    if bool(getattr(self, "_feedback_submitted", False)):
      Notification(
        "CSV downloaded. Feedback already recorded.",
        timeout=2
      ).show()
      return

    self._show_feedback_dialog(source="output_download")

  def _feedback_only_click(self, **event_args):
    """
    Standalone feedback button.

    Does not download CSV.
    Only allows feedback once during this page session.
    """
    if bool(getattr(self, "_feedback_submitted", False)):
      self._update_feedback_button()
      Notification("Feedback already recorded.", timeout=2).show()
      return

    self._show_feedback_dialog(source="manual_feedback")

  def _show_feedback_dialog(self, source="manual_feedback"):
    """
    Two-step feedback flow.
  
    Step 1:
      - Looks Good
      - Report Issues
  
    Step 2, only if Report Issues:
      - Multi-select issue categories
      - Each category shown as a card with helper text
      - Optional comments
  
    No subjective minor/major severity.
    """
  
    if bool(getattr(self, "_feedback_submitted", False)):
      self._update_feedback_button()
      Notification("Feedback already recorded.", timeout=2).show()
      return
  
    # ======================================================
    # STEP 1: LOOKS GOOD OR REPORT ISSUES
    # ======================================================
  
    first_body = ColumnPanel(spacing="medium")
    first_body.width = "100%"
    first_body.padding = "18px"
  
    title = Label(
      text="How did this job look?",
      bold=True,
      align="center",
    )
    title.font_size = CARD_FONT_SIZE + 2
    first_body.add_component(title)
  
    subtitle = Label(
      text="Confirm the result or report any issues you noticed.",
      align="center",
      foreground="theme:Secondary 500",
    )
    subtitle.font_size = CARD_FONT_SIZE - 4
    first_body.add_component(subtitle)
  
    first_body.add_component(Spacer(height=12))
  
    choice = alert(
      content=first_body,
      title="Quick Feedback",
      large=False,
      dismissible=True,
      buttons=[
        ("Looks Good", "all_good"),
        ("Report Issues", "had_issues"),
      ],
    )
  
    if not choice:
      return
  
    # ======================================================
    # LOOKS GOOD
    # ======================================================
  
    if choice == "all_good":
  
      feedback_summary = "All Good"
  
      info = {
        "source": source,
        "job_name": self.job_name or "",
        "row_count": len(self._flat_rows or []),
        "feedback_status": "All Good",
        "all_good": True,
        "issues": [],
        "comment": "",
      }
  
      try:
        anvil.server.call(
          "send_accuracy_feedback",
          feedback_summary,
          info["job_name"],
          info,
        )
  
        self._feedback_submitted = True
        self._update_feedback_button()
  
        Notification(
          "Thanks for your feedback!",
          timeout=2,
        ).show()
  
      except Exception as e:
        Notification(
          f"Could not send feedback: {e}",
          style="warning",
          timeout=3,
        ).show()
  
      return
  
    # ======================================================
    # STEP 2: ISSUE DETAILS
    # ======================================================
  
    body = ColumnPanel(spacing="medium")
    body.width = "100%"
    body.padding = "24px"
  
    issue_title = Label(
      text="What issues did you notice?",
      bold=True,
      align="center",
    )
    issue_title.font_size = CARD_FONT_SIZE + 2
    body.add_component(issue_title)
  
    issue_help = Label(
      text="Select all that apply.",
      align="center",
      foreground="theme:Secondary 500",
    )
    issue_help.font_size = CARD_FONT_SIZE - 4
    body.add_component(issue_help)
  
    body.add_component(Spacer(height=10))
  
    # ======================================================
    # ISSUE DEFINITIONS
    # ======================================================
  
    issue_definitions = [
      (
        "Incorrect pages",
        "Argus selected the wrong pages or missed pages that contained relevant panel information.",
      ),
      (
        "Panel identification",
        "Argus missed a panel or incorrectly identified something as a panel.",
      ),
      (
        "Panel information",
        "Panel details such as name, amperage, voltage, or main information were read incorrectly.",
      ),
      (
        "Panel spaces",
        "The panel space count was read incorrectly.",
      ),
      (
        "Breaker column identification",
        "Argus identified the wrong schedule columns for breaker amps, poles, or related breaker data.",
      ),
      (
        "Breaker information incorrect",
        "Argus identified the correct breaker columns, but individual breaker values such as amps, poles, or quantities were read incorrectly.",
      ),
      (
        "BOM generation / assumption error",
        "The drawing information was read correctly, but the generated BOM or a system assumption was incorrect.",
      ),
      (
        "UI confusion",
        "Something in the interface or workflow was unclear or difficult to use.",
      ),
      (
        "Bug",
        "Something in the application did not work as expected.",
      ),
      (
        "Other",
        "An issue occurred that does not fit one of the categories above.",
      ),
    ]
  
    # ======================================================
    # TWO-COLUMN ISSUE CARD GRID
    # ======================================================
  
    issue_grid = GridPanel()
    issue_grid.width = "100%"
    issue_grid.spacing = "large"
  
    issue_checkboxes = []
  
    for idx, (label_text, helper_text) in enumerate(issue_definitions):
    
      # ------------------------------------------------------
      # OUTER CARD
      # ------------------------------------------------------
    
      option_box = ColumnPanel()
      option_box.width = "100%"
      option_box.spacing = "none"
      option_box.padding = "0"
    
      option_box.background = "#24383D"
      option_box.foreground = "theme:White"
    
      # ------------------------------------------------------
      # INNER CONTENT
      # This is what actually gets vertically centered.
      # ------------------------------------------------------
    
      content_box = ColumnPanel()
      content_box.width = "100%"
      content_box.spacing = "none"
      content_box.padding = "0"
    
      # Main checkbox
      cb = CheckBox(
        text=label_text,
        checked=False,
      )
    
      cb.width = "100%"
      cb.bold = True
      cb.foreground = "theme:White"
      cb.tooltip = helper_text
      cb.spacing_above = "none"
      cb.spacing_below = "small"
    
      content_box.add_component(cb)
    
