  def _preview_click(self, sender, **event_args):
    try:
      import re

      tag = getattr(sender, "tag", {}) or {}
      job_id = str(tag.get("job_id") or "").strip()

      lookup_name = str(tag.get("lookup_name") or tag.get("name") or "(panel)").strip()

      raw_display_name = tag.get("display_name", None)
      if raw_display_name is None:
        display_name = lookup_name
      else:
        display_name = str(raw_display_name).strip()

      src = str(tag.get("source") or "").strip()

      if not job_id:
        alert("No job id found.")
        return

      safe_base = re.sub(r"[^A-Za-z0-9_\-]+", "_", lookup_name).strip("_") or "panel"
      overlay_file = f"{safe_base}_review_overlay.png"

      candidates = []

      def _add(p):
        p = str(p or "").strip()
        if not p:
          return
        p = p.replace("\\", "/")
        if p not in candidates:
          candidates.append(p)

      _add(f"pdf_images/review_overlays/{overlay_file}")
      _add(f"review_overlays/{overlay_file}")
      _add(src)

      media = None
      used_src = None
      last_err = None

      for cand in candidates:
        try:
          media = self._job_server_call("fetch_specs_image", job_id, cand)
          used_src = cand
          break
        except Exception as e:
          last_err = e

      if media is None:
        alert(
          "Could not load preview.\n\nTried:\n- "
          + "\n- ".join(candidates)
          + f"\n\nLast error:\n{last_err}"
        )
        return

      img = Image(
        source=media,
        width="100%",
        height=700,
        display_mode="shrink_to_fit",
        tooltip=used_src,
      )

      title = f"Preview — {display_name}" if display_name else "Preview"
      alert(img, title=title, large=True, buttons=[("Close", True)])

    except Exception as e:
      alert(f"Could not load preview:\n{e}")

