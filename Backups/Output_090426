  def _panel_attrs_all_none(self, designation: str) -> bool:
    def _missing(v):
      if v is None:
        return True
      s = str(v).strip().upper()
      return s == "" or s == "NONE" or s == "X" or s == "-"

    attrs = self._panel_quick_attrs(designation) or {}
    keys = ("amperage", "voltage", "intRating", "spaces", "mainBreakerAmperage")
    return all(_missing(attrs.get(k)) for k in keys)

  def _rows_have_real_items(self, rows: list) -> bool:
    # real = anything the user could include in CSV (we set csv_selectable=True in _normalize_rules)
    return any(bool(r.get("csv_selectable")) for r in (rows or []))

  def _nonpanel_from_attrless_panels(self) -> list[dict]:
    out = []
    for p in self._extract_panels() or []:
      name = str(p.get("name") or "").strip()
      if not name:
        continue
      if self._panel_attrs_all_none(name):
        src = str(p.get("source") or "").strip()
        if src:
          out.append({"source": src})
    return out

  def _render_cards_bom(self, rows_by_des: dict):
    """
    Build the list of reviewable BOM panels, but render only ONE
    panel card at a time.
    """
    dg_legacy = getattr(self, "data_grid_1", None)
    if isinstance(dg_legacy, DataGrid):
      try:
        dg_legacy.visible = False
      except Exception:
        pass

    host = self._get_cards_host()

    try:
      host.width = "100%"
    except Exception:
      pass

    usable_cards = []

    for des in self._iter_designations_in_panel_order(rows_by_des):
      status, _note = self._panel_status(des)

      # Bad/problem panels stay in Attention Needed only.
      if not self._is_good_status_for_linear3(status):
        continue

      rows = rows_by_des.get(des) or []
      if not rows:
        continue

      if self._panel_attrs_all_none(des):
        continue

      if not self._rows_have_real_items(rows):
        continue

      display_rows = [
        r for r in rows
        if str(r.get("item_type") or "").strip() != "Skipped"
      ]

      if not display_rows:
        continue

      usable_cards.append((des, display_rows))

    # Store the reviewable cards instead of rendering all of them.
    self._review_cards = usable_cards

    # Keep the index valid if the BOM was regenerated after an edit.
    if self._review_index >= len(self._review_cards):
      self._review_index = max(0, len(self._review_cards) - 1)

    # Build the sidebar and render only the currently selected card.
    self._render_panel_navigator()
    self._render_current_panel_card()

  def _clear_component(self, comp):
    """
    Safely clear an Anvil container.
    """
    if comp is None:
      return

    try:
      comp.clear()
      return
    except Exception:
      pass

    try:
      for c in list(comp.get_components()):
        try:
          c.remove_from_parent()
        except Exception:
          pass
    except Exception:
      pass


  def _render_current_panel_card(self):
    """
    Render ONLY the currently selected panel card into linear_panel_1.
    """
    host = self._get_cards_host()

    if host is None:
      return

    try:
      host.width = "100%"
    except Exception:
      pass

    self._clear_component(host)

    if not self._review_cards:
      msg = Label(
        text="No BOM panels available for review.",
        align="center",
        foreground="theme:White",
      )
      msg.font_size = CARD_FONT_SIZE
      host.add_component(msg)

      self._update_review_navigation()
      return

    # Keep index safe.
    if self._review_index < 0:
      self._review_index = 0

    if self._review_index >= len(self._review_cards):
      self._review_index = len(self._review_cards) - 1

    designation, display_rows = self._review_cards[self._review_index]

    card = self._make_panel_bom_side_by_side_card(
      designation,
      display_rows,
      item_index=self._review_index + 1,
      total_items=len(self._review_cards),
    )

    self._add_full_width(host, card)

    self._update_review_navigation()


  def _render_panel_navigator(self):
    """
    Build the panel selector in the left sidebar.

    ✓ = approved
    ● = current
    ○ = not reviewed
    """
    nav = getattr(self, "panel_nav_panel", None)

    if nav is None:
      return

    self._clear_component(nav)

    try:
      nav.width = "100%"
    except Exception:
      pass

    for idx, (designation, _rows) in enumerate(self._review_cards):
      display_name = self._panel_display_name(designation)

      is_current = idx == self._review_index
      is_approved = self._norm(designation) in self._approved_panels

      if is_current:
        prefix = "●"
      elif is_approved:
        prefix = "✓"
      else:
        prefix = "○"

      btn = Button(
        text=f"{prefix}  {display_name}",
        align="left",
      )

      btn.width = "100%"
      btn.tag = idx

      # Styling roles. CSS for these is added separately.
      if is_current and is_approved:
        btn.role = "argus-panel-nav-approved-current"

      elif is_current:
        btn.role = "argus-panel-nav-current"

      elif is_approved:
        btn.role = "argus-panel-nav-approved"

      else:
        btn.role = "argus-panel-nav"

      btn.set_event_handler("click", self._panel_nav_click)

      nav.add_component(btn)

    self._update_review_count()


  def _panel_nav_click(self, sender, **event_args):
    """
    Jump directly to a panel from the left sidebar.
    Clicking a panel does NOT automatically approve anything.
    """
    try:
      idx = int(sender.tag)
    except Exception:
      return

    if idx < 0 or idx >= len(self._review_cards):
      return

    if idx == self._review_index:
      return

    self._review_index = idx

    self._render_panel_navigator()
    self._render_current_panel_card()


  def _previous_panel_click(self, **event_args):
    """
    Move backward one panel without changing approval state.
    """
    if not self._review_cards:
      return

    if self._review_index <= 0:
      return

    self._review_index -= 1

    self._render_panel_navigator()
    self._render_current_panel_card()


  def _approve_next_click(self, **event_args):
    """
    Approve the current panel and move to the next panel.

    If the current panel is already approved, this simply moves next.
    On the final panel, it approves the panel and stays there.
    """
    if not self._review_cards:
      return

    designation, _rows = self._review_cards[self._review_index]

    # Mark current panel approved.
    self._approved_panels.add(self._norm(designation))

    # Move forward if another panel exists.
    if self._review_index < len(self._review_cards) - 1:
      self._review_index += 1

    self._render_panel_navigator()
    self._render_current_panel_card()


  def _update_review_count(self):
    """
    Update approval progress above the panel list.
    """
    lbl = getattr(self, "panel_review_count", None)

    if lbl is None:
      return

    total = len(self._review_cards)

    approved = sum(
      1
      for designation, _rows in self._review_cards
      if self._norm(designation) in self._approved_panels
    )

    lbl.text = f"{approved} / {total} approved"

  def _update_review_navigation(self):
    """
    Update both Previous buttons and both Approve & Next buttons.
    """
    prev_buttons = [
      getattr(self, "previous_panel_btn", None),
      getattr(self, "previous_panel_bottom_btn", None),
    ]

    prev_buttons = [
      btn for btn in prev_buttons
      if btn is not None
    ]

    next_buttons = [
      getattr(self, "approve_next_btn", None),
      getattr(self, "approve_next_bottom_btn", None),
    ]

    next_buttons = [
      btn for btn in next_buttons
      if btn is not None
    ]

    total = len(self._review_cards)

    # Both Previous buttons
    previous_enabled = (
      total > 0
      and self._review_index > 0
    )

    for btn in prev_buttons:
      btn.enabled = previous_enabled

    # No panels available
    if total == 0:
      for btn in next_buttons:
        btn.enabled = False
        btn.text = "Approve & Next"

      self._update_review_count()
      return

    designation, _rows = self._review_cards[self._review_index]

    is_approved = (
      self._norm(designation) in self._approved_panels
    )

    is_last = (
      self._review_index == total - 1
    )

    all_approved = (
      total > 0
      and all(
        self._norm(designation) in self._approved_panels
        for designation, _rows in self._review_cards
      )
    )

    if is_last:
      if is_approved:
        if all_approved:
          button_text = "All Panels Approved"
        else:
          button_text = "Approved"

        button_enabled = False

      else:
        button_text = "Approve"
        button_enabled = True

    else:
      if is_approved:
        button_text = "Next"
      else:
        button_text = "Approve & Next"

      button_enabled = True

    # Keep top and bottom next buttons identical.
    for btn in next_buttons:
      btn.text = button_text
      btn.enabled = button_enabled

    self._update_review_count()
  
  def _make_single_panel_table(self, panel_row: dict) -> DataGrid:
    dg = DataGrid()
    dg.width = "100%"
    dg.show_header = False
    dg.show_page_controls = False
    dg.rows_per_page = 1
    dg.role = "detected-panel-mini-grid"
    dg.background = "transparent"
    dg.foreground = "theme:Background"

    # IMPORTANT: titles blank so no repeated labels appear per mini grid
    dg.columns = [
      {"id": "name", "title": "", "data_key": "name", "width": 200},
      {"id": "amperage", "title": "", "data_key": "amperage"},
      {"id": "voltage", "title": "", "data_key": "voltage"},
      {"id": "main_brk_amps", "title": "", "data_key": "main_brk_amps"},
      {"id": "int_rating", "title": "", "data_key": "int_rating"},
      {"id": "spaces", "title": "", "data_key": "spaces"},
      {"id": "preview", "title": "", "data_key": "preview", "width": 110},
    ]

    def C(text, align="center", bold=False):
      lab = Label(text=text, align=align, bold=bold)
      lab.font_size = CARD_FONT_SIZE
      return lab

    # ---------- display format helpers ----------
    def _blankish(v):
      if v is None:
        return True
      s = str(v).strip()
      return s == "" or s.upper() in ("NONE", "X", "-")

    def _num(v):
      if _blankish(v):
        return None
      s = str(v).strip()
      # allow things like "22", "22.0"
      try:
        f = float(s)
        i = int(f)
        # preserve non-integer if truly non-integer
        return str(i) if abs(f - i) < 1e-9 else str(f).rstrip("0").rstrip(".")
      except Exception:
        # if it's non-numeric, return raw trimmed
        return s

    def _fmt_amps(v):
      n = _num(v)
      return "-" if n is None else f"{n}A"

    def _fmt_volts(v):
      n = _num(v)
      return "-" if n is None else f"{n}V"

    def _fmt_main_amps(v):
      n = _num(v)
      return "-" if n is None else f"{n}A MB"

    def _fmt_kaic(v):
      n = _num(v)
      return "-" if n is None else f"{n}K"

    def _fmt_spaces(v):
      n = _num(v)
      return "-" if n is None else f"{n}sp"

    # -------------------------------------------

    dr = DataRowPanel()
    dr.add_component(
      C(str(panel_row.get("name") or "-"), align="left", bold=True), column="name"
    )
    dr.add_component(C(_fmt_amps(panel_row.get("amperage"))), column="amperage")
    dr.add_component(C(_fmt_volts(panel_row.get("voltage"))), column="voltage")
    dr.add_component(
      C(_fmt_main_amps(panel_row.get("main_brk_amps"))), column="main_brk_amps"
    )
    dr.add_component(C(_fmt_kaic(panel_row.get("int_rating"))), column="int_rating")
    dr.add_component(C(_fmt_spaces(panel_row.get("spaces"))), column="spaces")

    btn = Button(
      text="View",
      foreground="#117BC3",
      background="transparent",
      bold=True,
      underline=True,
    )
    btn.font_size = CARD_FONT_SIZE
    btn.enabled = bool(panel_row.get("source"))
    btn.tag = {
      "source": panel_row.get("source"),
      "name": panel_row.get("name"),
      "job_id": self.result.get("job_id") or "",
    }
    btn.tooltip = "Preview detected overlay" if btn.enabled else "No image available"
    btn.set_event_handler("click", self._preview_click)
    dr.add_component(btn, column="preview")

    dg.add_component(dr)
    return dg

