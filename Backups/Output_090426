      helper.spacing_below = "none"
    
      content_box.add_component(helper)
    
      option_box.add_component(content_box)
    
      # Save checkbox reference
      issue_checkboxes.append(
        (label_text, cb)
      )
    
      # ------------------------------------------------------
      # TWO-COLUMN GRID POSITION
      # ------------------------------------------------------
    
      row_letter = chr(ord("A") + (idx // 2))
      col = 0 if idx % 2 == 0 else 6
    
      issue_grid.add_component(
        option_box,
        row=row_letter,
        col_xs=col,
        width_xs=6,
      )
    
      # ------------------------------------------------------
      # CARD STYLING
      # ------------------------------------------------------
    
      try:

        def _style_card(
          box=option_box,
          inner=content_box,
          checkbox=cb,
          helper_label=helper,
        ):
          outer_el = js.get_dom_node(box)
          inner_el = js.get_dom_node(inner)
          checkbox_el = js.get_dom_node(checkbox)
          helper_el = js.get_dom_node(helper_label)

          # Same size for every card.
          if outer_el:
            outer_el.style.setProperty(
              "border",
              "1px solid rgba(255,255,255,0.12)",
              "important",
            )

            outer_el.style.setProperty(
              "border-radius",
              "12px",
              "important",
            )

            outer_el.style.setProperty(
              "box-sizing",
              "border-box",
              "important",
            )

            outer_el.style.setProperty(
              "height",
              "160px",
              "important",
            )

            outer_el.style.setProperty(
              "min-height",
              "160px",
              "important",
            )

            outer_el.style.setProperty(
              "max-height",
              "160px",
              "important",
            )

            outer_el.style.setProperty(
              "overflow",
              "hidden",
              "important",
            )

          # Normal Anvil layout with modest vertical spacing.
          if inner_el:
            inner_el.style.setProperty(
              "padding-top",
              "14px",
              "important",
            )

            inner_el.style.setProperty(
              "padding-bottom",
              "8px",
              "important",
            )

            inner_el.style.setProperty(
              "box-sizing",
              "border-box",
              "important",
            )

          # Move the checkbox/title away from the left edge.
          if checkbox_el:
            checkbox_el.style.setProperty(
              "margin-left",
              "24px",
              "important",
            )

            checkbox_el.style.setProperty(
              "margin-right",
              "24px",
              "important",
            )

            checkbox_el.style.setProperty(
              "width",
              "calc(100% - 48px)",
              "important",
            )

          # Move the description away from the left edge.
          if helper_el:
            helper_el.style.setProperty(
              "margin-left",
              "24px",
              "important",
            )

            helper_el.style.setProperty(
              "margin-right",
              "24px",
              "important",
            )

            helper_el.style.setProperty(
              "width",
              "calc(100% - 48px)",
              "important",
            )

        js.window.setTimeout(_style_card, 0)
        js.window.setTimeout(_style_card, 100)
        js.window.setTimeout(_style_card, 300)

      except Exception:
        pass
  
    body.add_component(issue_grid)
  
    # ======================================================
    # COMMENTS
    # ======================================================
  
    body.add_component(Spacer(height=14))
  
    comment_label = Label(
      text="Comments",
      bold=True,
    )
    comment_label.font_size = CARD_FONT_SIZE
    body.add_component(comment_label)
  
    comment_helper = Label(
      text="Optional — add any details that would help us reproduce or understand the issue.",
      foreground="theme:Secondary 500",
    )
    comment_helper.font_size = CARD_FONT_SIZE - 5
    comment_helper.spacing_above = "none"
    comment_helper.spacing_below = "small"
    body.add_component(comment_helper)
  
    comment_box = TextArea(
      placeholder="Optional additional details...",
      height=140,
    )
    comment_box.width = "100%"
  
    body.add_component(comment_box)
  
    # ======================================================
    # SHOW SECOND MODAL
    # ======================================================
  
    submitted = alert(
      content=body,
      title="Feedback Details",
      large=True,
      dismissible=True,
      buttons=[
        ("Cancel", False),
        ("Submit Feedback", True),
      ],
    )
  
    if not submitted:
      return
  
    # ======================================================
    # COLLECT SELECTED ISSUES
    # ======================================================
  
    selected_issues = [
      label
      for label, cb in issue_checkboxes
      if bool(cb.checked)
    ]
  
    comment = str(
      comment_box.text or ""
    ).strip()
  
    if not selected_issues:
      alert(
        "Please select at least one issue before submitting."
      )
      return
  
    # ======================================================
    # BUILD PAYLOAD
    # ======================================================
  
    feedback_summary = (
      "Needs Correction: "
      + "; ".join(selected_issues)
    )
  
    info = {
      "source": source,
      "job_name": self.job_name or "",
      "row_count": len(self._flat_rows or []),
  
      "feedback_status": "Needs Correction",
      "all_good": False,
      "issues": selected_issues,
      "comment": comment,
    }
  
    # ======================================================
    # SEND
    # ======================================================
  
    try:
      anvil.server.call(
        "send_accuracy_feedback",
        feedback_summary,
        info["job_name"],
        info,
      )
  
      self._feedback_submitted = True
      self._update_feedback_button()
  
      Notification(
        "Thanks for your feedback!",
        timeout=2,
      ).show()
  
    except Exception as e:
      Notification(
        f"Could not send feedback: {e}",
        style="warning",
        timeout=3,
      ).show()

