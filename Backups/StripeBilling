@anvil.server.http_endpoint("/stripe/webhook", methods=["POST"])
def stripe_webhook():
  payload = request.body.get_bytes()

  # request.headers is usually dict-like, but be defensive
  try:
    sig_header = request.headers.get("Stripe-Signature") or request.headers.get("stripe-signature")
  except Exception:
    sig_header = request.headers["Stripe-Signature"]

  if not sig_header:
    return anvil.server.HttpResponse(400, "Missing Stripe-Signature header")

  try:
    event = stripe.Webhook.construct_event(payload, sig_header, WEBHOOK_SECRET)
  except Exception as e:
    return anvil.server.HttpResponse(400, f"Webhook error: {e}")

  event_type = event["type"]
  obj = event["data"]["object"]

  # ✅ Convert StripeObject -> plain dict so .get() works everywhere
  if hasattr(obj, "to_dict_recursive"):
    obj = obj.to_dict_recursive()
  else:
    obj = dict(obj)

  try:
    if event_type == "checkout.session.completed":
      _handle_checkout_completed(obj)

    elif event_type in ("customer.subscription.updated", "customer.subscription.deleted"):
      _handle_subscription_change(obj, event_type)

    elif event_type == "invoice.payment_failed":
      _handle_payment_failed(obj)

    # (optional) you can ignore invoice.payment_succeeded entirely
  except Exception as e:
    # Return 500 so Stripe retries (good during setup)
    return anvil.server.HttpResponse(500, f"Handler error: {type(e).__name__}: {e}")

  return anvil.server.HttpResponse(200, "ok")

def _handle_checkout_completed(session_obj):
  meta = session_obj.get("metadata", {}) or {}

  pending_id = meta.get("pending_id")
  plan_key = (meta.get("plan_key") or "").strip().lower()
  billing_email = (meta.get("billing_email") or "").strip().lower()

  customer_id = session_obj.get("customer")
  subscription_id = session_obj.get("subscription")
  session_id = session_obj.get("id")

  if not pending_id:
    return
  if plan_key not in SEAT_LIMITS or not subscription_id:
    return

  pending = app_tables.pending_signups.get_by_id(pending_id)
  if not pending:
    return

  if pending["status"] == "completed":
    return

  existing_code = app_tables.access_codes.get(stripe_subscription_id=subscription_id)
  if existing_code:
    pending.update(
      status="completed",
      stripe_session_id=session_id,
      stripe_customer_id=customer_id,
      stripe_subscription_id=subscription_id,
    )
    return

  admin_email = ((pending["admin_email"] or billing_email) or "").strip().lower()
  company = (pending["company"] or "").strip()
  location = (pending["location"] or "").strip()

  code = _generate_access_code()
  seat_limit = SEAT_LIMITS[plan_key]

  code_row = app_tables.access_codes.add_row(
    code=code,
    plan_key=plan_key,
    seat_limit=seat_limit,
    status="active",
    stripe_customer_id=customer_id,
    stripe_subscription_id=subscription_id,
    billing_email=admin_email,
    company=company,
    location=location,
    created_at=_now()
  )
  # Internal notification email
  try:
    _send_internal_email(
      "NEW ARGUS SIGNUP",
      (
        "New signup completed\n\n"
        f"Created at: {_now()}\n"
        f"Admin email: {admin_email}\n"
        f"Plan: {plan_key}\n"
        f"Seats: {seat_limit}\n"
        f"Billing cycle: {pending['billing_cycle']}\n"
        f"Company: {company}\n"
        f"Location: {location}\n"
        f"Access code: {code}\n"
      )
    )
  except Exception as e:
    print("INTERNAL SIGNUP EMAIL FAILED:", type(e).__name__, str(e))

  admin_is_seat = bool(pending["admin_is_seat"])
  
  if admin_is_seat:
    code_row.update(
      reserved_seats=1,
      reserved_admin_email=admin_email,
      reserved_admin_claimed=False
    )
  else:
    code_row.update(
      reserved_seats=0,
      reserved_admin_email=None,
      reserved_admin_claimed=False
    )

  pending.update(
    status="completed",
    stripe_session_id=session_id,
    stripe_customer_id=customer_id,
    stripe_subscription_id=subscription_id,
  )

  # Email the code
  try:
    import anvil.email
    anvil.email.send(
      to=admin_email,
      subject="Your Argus Access Code",
      text=(
        "Thanks for subscribing to Argus.\n\n"
        f"Company: {company}\n"
        f"Location: {location}\n"
        f"Plan: {plan_key}\n"
        f"Seats included: {seat_limit}\n\n"
        f"Access code: {code}\n\n"
        "IMPORTANT: Admin login setup\n"
        f"- Your billing admin email is: {admin_email}\n"
        "- To create your admin login, go to Argus -> Login -> New User\n"
        "- Enter your billing admin email, and check your email for a password reset link.\n"
        "- Click the link. This will take you back to the Argus page. Click Login -> Existing User.\n"
        "- You will be prompted to create a password for your account which you can then use to log in.\n"
        "***Important note***\n"
        " *if you enter the access code, you will occupy a seat on your plan as a user.*\n"
        "*If you do not wish to be a user, do not enter the access code.*\n\n"
        "How seats work:\n"
        "- Share this access code with your team.\n"
        "- Each user creates their own login and redeems the code to claim a seat.\n"
        "*Note - Each user will need to create a login in the same way as the admin. Go to Argus -> Login -> New User.\n"
        "- Click the link in your email. This will take you back to the Argus page. Click Login -> Existing User.\n"
        "- You will be prompted to create a password for your account which you can then use to log in.\n"
        "- Once a user has created a login, Go to Argus -> Login -> Existing user.\n"
        "- Log in with your credentials. You will then be prompted to enter the access code.\n"
        "- If you selected 'Admin is also a user', the admin should also redeem the code when they log in for the first time.\n"
        "- If the billing admin redeems the code, they will automatically be marked as the billing admin.\n\n"
        "Billing:\n"
        "- Click 'Manage Account' to open the Stripe portal.\n"
        f"- To add/remove users or adjust seat assignments, contact: {SUPPORT_EMAIL}\n\n"
        "Rules:\n"
        "- Cancel anytime; access continues through the end of the paid period.\n"
        "- No refunds.\n"
        "- If payment fails, access is blocked immediately.\n\n"
        f"Support: {SUPPORT_EMAIL}\n"
      )
    )
  except Exception as e:
