# -------------------------
# Helpers
# -------------------------

def _now():
  return datetime.now()

def _generate_access_code(length: int = 10) -> str:
  alphabet = string.ascii_letters + string.digits
  while True:
    code = "".join(secrets.choice(alphabet) for _ in range(length))
    if not app_tables.access_codes.get(code=code):
      return code

def _user_email(user) -> str:
  if not user:
    return ""
  # Anvil user row: use dict-style first
  try:
    return str((user["email"] or "")).strip().lower()
  except Exception:
    pass
  # Fallbacks (just in case)
  try:
    return str((getattr(user, "email", "") or "")).strip().lower()
  except Exception:
    return ""

def _utcnow():
  # you currently use datetime.now() (local); use utc for consistent expiration
  return datetime.utcnow()

def _norm_email(email: str) -> str:
  return (email or "").strip().lower()
  
def _is_free_trial(user) -> bool:
  email = _user_email(user)
  if not email:
    return False
  try:
    return bool(anvil.server.call("is_email_on_active_trial", email))
  except Exception as e:
    print("TRIAL CHECK FAILED:", type(e).__name__, str(e), "email=", email)
    return False
  
def _is_internal_admin(user) -> bool:
  email = _user_email(user)
  if not email:
    return False
  # internal_admins table: column "email"
  return bool(app_tables.internal_admins.get(email=email))

def _row_get(row, key, default=None):
  try:
    return row[key]
  except Exception:
    return default

def _reserved_seats(code_row) -> int:
  try:
    return int(code_row["reserved_seats"] or 0)
  except Exception:
    return 0

def _clean_text(s: str, max_len: int = 200) -> str:
  s = (s or "").strip()
  if len(s) > max_len:
    s = s[:max_len]
  return s

def _valid_email(s: str) -> bool:
  s = (s or "").strip()
  return ("@" in s) and ("." in s) and (len(s) >= 5)

def _is_code_active(code_row) -> bool:
  # Your “block immediately on failure” rule:
  # allow only "active" (you can add "trialing" if you ever do trials)
  status = (code_row["status"] or "").lower()
  return status == "active"

def _count_seats_used(code_row) -> int:
  # Requires code_users table with column access_code linking to access_codes
  rows = app_tables.code_users.search(access_code=code_row)
  return len(list(rows))

def _seat_limit(code_row) -> int:
  try:
    v = code_row["seat_limit"]
    if v is not None:
      return int(v)
  except Exception:
    pass
  pk = (code_row["plan_key"] or "").lower()
  return SEAT_LIMITS.get(pk, 0)

