@anvil.server.callable
def create_portal_session_for_current_user() -> str:
  user = anvil.users.get_user()
  if not user:
    raise PermissionError("Not logged in.")

  # User email from your Users table
  user_email = _user_email(user)
  if not user_email:
    raise PermissionError("Missing user email.")

  # 1) If the user is a seated user, use their linked access code
  link = app_tables.code_users.get(user=user)
  if link:
    # Optional: only billing admin can manage billing
    try:
      if not link["is_billing_admin"]:
        raise PermissionError("Only the billing admin can manage the subscription.")
    except KeyError:
      # column doesn't exist; ignore
      pass

    code_row = link["access_code"]
    if not code_row:
      raise PermissionError("Missing access code record.")

  else:
    # 2) Billing-only admin path:
    # Allow portal access ONLY if logged-in email matches billing_email on access_codes
    code_row = app_tables.access_codes.get(billing_email=user_email)
    if not code_row:
      raise PermissionError("This account is not the billing admin for any subscription.")

  customer_id = _row_get(code_row, "stripe_customer_id", None)
  if not customer_id:
    raise PermissionError("Billing is not set up for this account yet.")

  origin = anvil.server.get_app_origin("published")
  portal = stripe.billing_portal.Session.create(
    customer=customer_id,
    return_url=f"{origin}/#landing"
  )
  return portal.url

