@anvil.server.callable
def redeem_access_code(code: str) -> dict:
  """
  Called after a user creates/logs in, to attach them to an access code.
  Returns {ok: bool, message: str, seatsUsed: int, seatLimit: int}
  """
  user = anvil.users.get_user()
  if not user:
    return {"ok": False, "message": "You must be logged in first."}

  code = (code or "").strip()
  if not code:
    return {"ok": False, "message": "Enter an access code."}

  code_row = app_tables.access_codes.get(code=code)
  if not code_row:
    return {"ok": False, "message": "Invalid access code."}

  # Subscription must be active
  if not _is_code_active(code_row):
    return {"ok": False, "message": "This subscription is not active. Contact your billing admin."}

  # Already linked?
  existing = app_tables.code_users.get(user=user)
  if existing:
    return {"ok": False, "message": "This user is already linked to an access code. Contact support if you need changes."}

  seat_limit = _seat_limit(code_row)
  used = _count_seats_used(code_row)
  reserved = _reserved_seats(code_row)
  
  # Regular users can only take a seat if room exists after reservations
  if used + reserved >= seat_limit:
    return {"ok": False, "message": "No seats available for this code. Contact your billing admin."}

  user_email = _user_email(user)
  billing_email = str(_row_get(code_row, "billing_email", "") or "").strip().lower()
  is_billing_admin = (user_email != "" and user_email == billing_email)

  app_tables.code_users.add_row(
    user=user,
    access_code=code_row,
    is_billing_admin=is_billing_admin,
    created_at=_now()
  )

  used_after = used + 1
  return {"ok": True, "message": "Access code accepted.", "seatsUsed": used_after, "seatLimit": seat_limit}


DEBUG_ENTITLEMENT = False  # flip False after testing

@anvil.server.callable
def is_current_user_entitled():
  user = anvil.users.get_user()
  if not user:
    return {"ok": False, "message": "Not logged in."}

  email = _user_email(user)

  # IMPORTANT:
  # Internal admins should be allowed immediately and should NOT auto-claim
  # any reserved customer/admin seat.
  internal_ok = _is_internal_admin(user)
  if internal_ok:
    resp = {
      "ok": True,
      "message": "ok",
      "mode": "internal_admin",
      "plan_key": "internal_admin",
      "scope": "personal",
      "group_folder": "internal_admins",
    }
    if DEBUG_ENTITLEMENT:
      resp.update({"email": email, "internalAdmin": True})
    return resp

  # Only normal non-internal users should auto-claim reserved seats.
  try:
    auto_claim_reserved_admin_seat()
  except Exception:
    pass

  trial_ok = False
  trial_err = None
  try:
    trial_ok = bool(anvil.server.call("is_email_on_active_trial", email))
  except Exception as e:
    trial_err = f"{type(e).__name__}: {e}"

  # 1) trial users
  if trial_ok:
    resp = {"ok": True, "message": "ok", "mode": "trial"}
    if DEBUG_ENTITLEMENT:
      resp.update({
        "email": email,
        "internalAdmin": False,
        "trialOk": trial_ok,
        "trialErr": trial_err
      })
    return resp

  # 2) normal access code gating
  link = app_tables.code_users.get(user=user)
  if not link:
    resp = {
      "ok": False,
      "reason": "no_code",
      "message": "Enter your access code to continue."
    }
    if DEBUG_ENTITLEMENT:
      resp.update({
        "email": email,
        "internalAdmin": False,
        "trialOk": trial_ok,
        "trialErr": trial_err
      })
    return resp

  code_row = link["access_code"]
  if not code_row:
    resp = {"ok": False, "message": "Access code record missing."}
    if DEBUG_ENTITLEMENT:
      resp.update({"email": email})
    return resp

  if not _is_code_active(code_row):
    resp = {"ok": False, "message": "Subscription inactive. Contact your billing admin."}
    if DEBUG_ENTITLEMENT:
      resp.update({"email": email})
    return resp

  seat_limit = _seat_limit(code_row)
  used = _count_seats_used(code_row)

  try:
    is_admin = bool(link["is_billing_admin"])
  except Exception:
    is_admin = False

  if used > seat_limit:
    if is_admin:
      resp = {
        "ok": False,
        "reason": "over_limit_admin",
        "route": "account",
        "seatLimit": seat_limit,
        "seatsUsed": used,
        "message": f"Your plan allows {seat_limit} users but this code currently has {used}. Remove users to continue.",
      }
    else:
      resp = {
        "ok": False,
        "reason": "over_limit",
        "seatLimit": seat_limit,
        "seatsUsed": used,
        "message": f"This subscription now allows {seat_limit} users but currently has {used}. Ask your billing admin to remove users.",
      }

    if DEBUG_ENTITLEMENT:
      resp.update({"email": email})
    return resp

  resp = {
    "ok": True,
    "message": "ok",
    "seatLimit": seat_limit,
    "seatsUsed": used
  }
  if DEBUG_ENTITLEMENT:
    resp.update({"email": email})

  return resp

