def _handle_subscription_change(sub_obj, event_type: str = ""):
  sub_id = sub_obj.get("id")
  status = (sub_obj.get("status") or "").lower()
  if not sub_id:
    return

  row = app_tables.access_codes.get(stripe_subscription_id=sub_id)
  if not row:
    return

  # BEFORE snapshot
  old_plan = (row["plan_key"] or "").lower()
  try:
    old_seat_limit = int(row["seat_limit"] or 0)
  except Exception:
    old_seat_limit = 0
  old_status = (row["status"] or "").lower()

  # Pull plan from Stripe items
  new_plan = old_plan
  new_seat_limit = old_seat_limit
  try:
    items = (((sub_obj.get("items") or {}).get("data")) or [])
    if items:
      price = (items[0].get("price") or {})
      price_id = (price.get("id") or "").strip()
      mapped_plan = PRICE_ID_TO_PLAN.get(price_id)
      if mapped_plan:
        new_plan = mapped_plan
        new_seat_limit = SEAT_LIMITS.get(mapped_plan, 0)
  except Exception as e:
    print("PLAN UPDATE FAILED:", type(e).__name__, str(e))

  # Update row
  try:
    row.update(plan_key=new_plan, seat_limit=new_seat_limit)
  except Exception:
    pass

  if status == "active":
    row.update(status="active")
  else:
    row.update(status=status)

  # Decide if we should notify
  plan_changed = (new_plan != old_plan) or (new_seat_limit != old_seat_limit)
  status_changed = (status != old_status)

  cancel_at_period_end = bool(sub_obj.get("cancel_at_period_end"))
  deleted = (event_type == "customer.subscription.deleted") or (status in ("canceled", "cancelled"))

  if not (plan_changed or status_changed or cancel_at_period_end or deleted):
    return

  # Internal email
  try:
    _send_internal_email(
      "ARGUS SUBSCRIPTION UPDATE" if not deleted else "ARGUS SUBSCRIPTION CANCELED",
      (
        "Stripe subscription change\n\n"
        f"Time: {_now()}\n"
        f"Event: {event_type or 'customer.subscription.updated'}\n"
        f"Access code: {row['code']}\n"
        f"Company: {row['company']}\n"
        f"Location: {row['location']}\n"
        f"Billing admin: {row['billing_email']}\n"
        f"Subscription id: {sub_id}\n\n"
        f"Status: {old_status} -> {status}\n"
        f"Plan: {old_plan} ({old_seat_limit} seats) -> {new_plan} ({new_seat_limit} seats)\n"
        f"Cancel at period end: {cancel_at_period_end}\n"
      )
    )
  except Exception as e:
    print("INTERNAL SUBSCRIPTION EMAIL FAILED:", type(e).__name__, str(e))

def _handle_payment_failed(invoice_obj):
  sub_id = invoice_obj.get("subscription")
  if not sub_id:
    return

  row = app_tables.access_codes.get(stripe_subscription_id=sub_id)
  if not row:
    return

  row.update(status="past_due")

@anvil.server.callable
def auto_claim_reserved_admin_seat():
  user = anvil.users.get_user()
  if not user:
    return {"ok": False, "message": "Not logged in."}

  if _is_internal_admin(user):
    return {
      "ok": True,
      "skipped": True,
      "reason": "internal_admin"
    }

  email = _user_email(user)
  if not email:
    return False

  code_row = app_tables.access_codes.get(
    reserved_admin_email=email,
    reserved_admin_claimed=False
  )
  if not code_row:
    return False

  # If already linked, just mark claimed + ensure billing admin
  link = app_tables.code_users.get(user=user)
  if link:
    if link["access_code"] == code_row:
      link.update(is_billing_admin=True)
      code_row.update(reserved_admin_claimed=True, reserved_seats=0)
      return True
    return False

  # Create the seat link now (consumes the reserved seat, not an extra one)
  app_tables.code_users.add_row(
    user=user,
    access_code=code_row,
    is_billing_admin=True,
    created_at=_now()
  )

  code_row.update(reserved_admin_claimed=True, reserved_seats=0)
  return True
