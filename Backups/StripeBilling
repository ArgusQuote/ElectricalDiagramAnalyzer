@anvil.server.callable
def create_checkout_session_v2(payload: dict) -> str:
  """
  payload comes from PlanSignupModal:
    plan_key, billing_cycle, admin_email, admin_is_seat, company, location
  """
  if not isinstance(payload, dict):
    raise ValueError("Invalid payload.")

  plan_key = _clean_text(payload.get("plan_key"), 50).lower()
  billing_cycle = _clean_text(payload.get("billing_cycle"), 20).lower()

  admin_email = _clean_text(payload.get("admin_email"), 200).strip().lower()
  admin_is_seat = bool(payload.get("admin_is_seat"))
  company = _clean_text(payload.get("company"), 200)
  location = _clean_text(payload.get("location"), 200)

  if plan_key not in ("starter", "pro", "elite"):
    raise ValueError("Invalid plan.")
  if billing_cycle not in ("monthly", "yearly"):
    raise ValueError("Invalid billing cycle.")
  if not _valid_email(admin_email):
    raise ValueError("Enter a valid admin email.")
  if not company:
    raise ValueError("Company is required.")
  if not location:
    raise ValueError("Location is required.")

  price_id = PRICE_IDS.get((plan_key, billing_cycle))
  if not price_id:
    raise ValueError("Invalid plan or billing cycle.")

  pending = app_tables.pending_signups.add_row(
    created_at=_now(),
    status="pending",
    plan_key=plan_key,
    billing_cycle=billing_cycle,
    admin_email=admin_email,
    admin_is_seat=admin_is_seat,
    company=company,
    location=location,
    stripe_session_id=None,
    stripe_customer_id=None,
    stripe_subscription_id=None,
  )

  origin = anvil.server.get_app_origin("published")
  success_url = f"{origin}/?billing=success&session_id={{CHECKOUT_SESSION_ID}}"
  cancel_url  = f"{origin}/?billing=cancel"

  session = stripe.checkout.Session.create(
    mode="subscription",
    customer_email=admin_email,
    success_url=success_url,
    cancel_url=cancel_url,
    line_items=[{"price": price_id, "quantity": 1}],
    allow_promotion_codes=True,
    metadata={
      "pending_id": str(pending.get_id()),
      "plan_key": plan_key,
      "billing_cycle": billing_cycle,
      "billing_email": admin_email,
    },
  )

  pending.update(stripe_session_id=session.get("id"))
  return session.url

