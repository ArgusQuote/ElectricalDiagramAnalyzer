import anvil.secrets
import anvil.stripe
import anvil.email
import anvil.users
import anvil.server
import json, time

def _jsonify(x):
  return json.loads(json.dumps(x, default=str))

def _is_pdf(media):
  if not media:
    return False
  ct = (getattr(media, "content_type", "") or "").lower()
  name = (getattr(media, "name", "") or "").lower()
  return ("pdf" in ct) or name.endswith(".pdf")

def _owner_email() -> str:
  u = anvil.users.get_user()
  if not u:
    raise anvil.server.ExecutionError("User not logged in")
  try:
    em = (u['email'] or "").strip().lower()
  except Exception:
    em = ""
  if not em:
    raise anvil.server.ExecutionError("Your account has no email address.")
  return em

def _require_entitled_owner_email() -> str:
  owner_email = _owner_email()
  ent = anvil.server.call("is_current_user_entitled") or {}
  if not ent.get("ok"):
    raise anvil.server.ExecutionError("Your access is not active. Please contact your admin.")
  return owner_email


@anvil.server.callable(require_user=True)
def submit_for_detection(file, ui_overrides=None, **kwargs):
  owner_email = _require_entitled_owner_email()

  if not _is_pdf(file):
    raise anvil.server.ExecutionError("PDFs only")

  job_note = kwargs.get("job_note")

  out = anvil.server.call(
    "vm_submit_for_detection",
    media=file,
    ui_overrides=(ui_overrides or {}),
    job_note=job_note,
    owner_email=owner_email
  )

  out = dict(out or {})
  out["owner_email"] = owner_email
  out["owner_id"] = owner_email
  return _jsonify(out)


@anvil.server.callable(require_user=True)
def get_job_status(job_id):
  """Resilient poll: auto-retry on Uplink disconnects; report a soft-unknown."""
  owner_email = _owner_email()  # <-- NO entitlement check here

  for attempt in range(3):
    try:
      out = anvil.server.call("vm_get_job_status", job_id, owner_email)
      return _jsonify(out)

    except anvil.server.UplinkDisconnectedError:
      if attempt < 2:
        time.sleep(0.75 * (attempt + 1))
        continue
      return {"state": "unknown", "error": "uplink_disconnected"}

    except Exception as e:
      return {"state": "error", "error": f"Status unavailable: {type(e).__name__}: {e}"}

@anvil.server.callable(require_user=True)
def rerun_rules_with_panel_edit(job_id: str, original_panel_name: str, edited_component: dict):
  """
  Client-safe wrapper for editing one panel and rerunning the rules engine only.

  This function should NEVER throw normal user-facing errors.
  It should return:
    {"ok": True, "result": ...}
  or:
    {"ok": False, "error": "..."}
  """

  try:
    owner_email = _require_entitled_owner_email()

    job_id = (job_id or "").strip()
    original_panel_name = (original_panel_name or "").strip()

    if not job_id:
      return _jsonify({
        "ok": False,
        "error": "Missing job_id."
      })

    if not original_panel_name:
      return _jsonify({
        "ok": False,
        "error": "Missing original_panel_name."
      })

    if not isinstance(edited_component, dict):
      return _jsonify({
        "ok": False,
        "error": "edited_component must be a dictionary."
      })

    last_error = None

    for attempt in range(3):
      try:
        out = anvil.server.call(
          "vm_rerun_rules_with_panel_edit",
          job_id,
          owner_email,
          original_panel_name,
          edited_component
        ) or {}

        if not out.get("ok"):
          return _jsonify({
            "ok": False,
            "error": out.get("error") or "Could not rerun rules.",
            "raw": out
          })

        return _jsonify(out)

      except anvil.server.UplinkDisconnectedError as e:
        last_error = f"Rules rerun unavailable: uplink disconnected. Attempt {attempt + 1}/3."
        if attempt < 2:
          time.sleep(0.5 * (attempt + 1))
          continue

        return _jsonify({
          "ok": False,
          "error": last_error
        })

      except Exception as e:
        return _jsonify({
          "ok": False,
          "error": f"Rules rerun unavailable: {type(e).__name__}: {e}"
        })

    return _jsonify({
      "ok": False,
      "error": last_error or "Rules rerun failed for an unknown reason."
    })

  except Exception as e:
    return _jsonify({
      "ok": False,
      "error": f"Rules rerun wrapper failed: {type(e).__name__}: {e}"
    })

@anvil.server.callable(require_user=True)
def get_job_result(job_id):
  """
  Fetch completed job result after polling confirms the job is done.
  Kept separate from get_job_status so status polling stays lightweight.
  """
  owner_email = _owner_email()  # no entitlement check needed for result fetch

  for attempt in range(3):
    try:
      out = anvil.server.call("vm_get_job_result", job_id, owner_email)
      return _jsonify(out)

    except anvil.server.UplinkDisconnectedError:
      if attempt < 2:
        time.sleep(0.75 * (attempt + 1))
        continue
      return {
        "ok": False,
        "error": "uplink_disconnected"
      }

    except Exception as e:
      return {
        "ok": False,
        "error": f"Result unavailable: {type(e).__name__}: {e}"
      }

