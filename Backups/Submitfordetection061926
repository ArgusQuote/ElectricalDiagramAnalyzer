@anvil.server.callable(require_user=True)
def fetch_specs_image(job_id, source_path):
  job_id = str(job_id or "").strip()

  # Specs jobs are still legacy/non-grouped.
  if job_id.startswith("specs_"):
    owner_email = _require_entitled_owner_email()
    return anvil.server.call("vm_fetch_image", job_id, owner_email, source_path)

  # Normal BOM jobs are grouped.
  storage_ctx = _current_storage_context()
  owner_email = storage_ctx["owner_email"]
  group_folder = storage_ctx["group_folder"]

  return anvil.server.call(
    "vm_fetch_image",
    job_id,
    owner_email,
    source_path,
    group_folder
  )

